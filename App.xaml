<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="HimoBackground">#F6F4FA</Color>
            <Color x:Key="HimoPrimary">#5A2BC2</Color>
            <Color x:Key="HimoMuted">#7A7187</Color>
            <Color x:Key="HimoCard">#FFFFFF</Color>
            <Color x:Key="HimoBorder">#E2DDEA</Color>
            <Color x:Key="HimoInput">#FCFAFF</Color>
            <Color x:Key="HimoAccent">#6A32D0</Color>
            <Color x:Key="HimoAccentDark">#5425B8</Color>
            <Color x:Key="HimoBubbleMine">#6A32D0</Color>
            <Color x:Key="HimoBubbleOther">#FFFFFF</Color>
            <Color x:Key="HimoAvatar">#EAE0F7</Color>
            <Color x:Key="HimoSoft">#F1ECFB</Color>
            <Color x:Key="HimoSuccess">#16A34A</Color>
            <Color x:Key="HimoDanger">#DC2626</Color>
            <Color x:Key="HimoWarning">#D97706</Color>
            <Color x:Key="HimoHeader">#632CCB</Color>
            <Color x:Key="HimoOnAccent">#FFFFFF</Color>
            <Color x:Key="HimoSurfaceElevated">#FFFFFF</Color>
            <Color x:Key="HimoDivider">#ECE7F4</Color>
            <Color x:Key="HimoFocus">#B99AEF</Color>


            <!-- Stage 6 unified visual system -->
            <Color x:Key="HimoSurface">#FFFFFF</Color>
            <Color x:Key="HimoHeaderSoft">#632CCB</Color>
            <Color x:Key="HimoHeaderTextMuted">#E3D8F8</Color>
            <Color x:Key="HimoTextSecondary">#766D82</Color>
            <Color x:Key="HimoAvatarSoft">#EEE7FA</Color>
            <Color x:Key="HimoNavMuted">#8D8498</Color>
            <Color x:Key="HimoDangerSoft">#FDECEC</Color>

            <Style x:Key="HimoPageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="23" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="HimoPageSubtitle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{DynamicResource HimoHeaderTextMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="HimoBackButton" TargetType="Button">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.72" />
                                    <Setter Property="Scale" Value="0.96" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoCard}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="Padding" Value="15,0" />
            </Style>
            <Style x:Key="HimoPrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>
            <Style x:Key="HimoOutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{DynamicResource HimoBorder}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="CornerRadius" Value="15" />
            </Style>
            <Style x:Key="HimoCardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoCard}" />
                <Setter Property="Stroke" Value="{DynamicResource HimoBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,5" />
            </Style>
            <Style x:Key="HimoInputBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoInput}" />
                <Setter Property="Stroke" Value="{DynamicResource HimoBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style x:Key="HimoSectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="Margin" Value="2,8,2,2" />
            </Style>

            <Style x:Key="HimoBodyLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="HimoCaption" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource HimoTextSecondary}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="HimoIconTile" TargetType="Border">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoSoft}" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>
            <Style x:Key="HimoListCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoCard}" />
                <Setter Property="Stroke" Value="{DynamicResource HimoBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Stroke" Value="{DynamicResource HimoFocus}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="HimoIconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoSoft}" />
                <Setter Property="TextColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="WidthRequest" Value="46" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.78" />
                                    <Setter Property="Scale" Value="0.94" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="HimoPillButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoSoft}" />
                <Setter Property="TextColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <!-- Stage 6: consistent pressed/disabled states across the app. -->
            <Style x:Key="HimoActionButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="MinimumHeightRequest" Value="46" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.86" />
                                    <Setter Property="Scale" Value="0.98" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.48" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
