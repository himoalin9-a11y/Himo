<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Himo Neon Violet design system -->
            <Color x:Key="HimoBackground">#090511</Color>
            <Color x:Key="HimoPrimary">#FBF6FF</Color>
            <Color x:Key="HimoMuted">#BBA6D6</Color>
            <Color x:Key="HimoCard">#170B28</Color>
            <Color x:Key="HimoBorder">#512579</Color>
            <Color x:Key="HimoInput">#190B30</Color>
            <Color x:Key="HimoAccent">#A12AFF</Color>
            <Color x:Key="HimoAccentDark">#6517C8</Color>
            <Color x:Key="HimoBubbleMine">#9228ED</Color>
            <Color x:Key="HimoBubbleOther">#251337</Color>
            <Color x:Key="HimoAvatar">#2B1646</Color>
            <Color x:Key="HimoSoft">#25113D</Color>
            <Color x:Key="HimoSuccess">#31E7A1</Color>
            <Color x:Key="HimoDanger">#FF4678</Color>
            <Color x:Key="HimoWarning">#FFC56C</Color>
            <Color x:Key="HimoHeader">#12061F</Color>
            <Color x:Key="HimoOnAccent">#FFFFFF</Color>
            <Color x:Key="HimoSurfaceElevated">#1F0F33</Color>
            <Color x:Key="HimoDivider">#3A2053</Color>
            <Color x:Key="HimoFocus">#EF73FF</Color>
            <Color x:Key="HimoSurface">#160A27</Color>
            <Color x:Key="HimoHeaderSoft">#250B3D</Color>
            <Color x:Key="HimoHeaderTextMuted">#D9B7FF</Color>
            <Color x:Key="HimoTextSecondary">#B7A2D2</Color>
            <Color x:Key="HimoAvatarSoft">#2A1643</Color>
            <Color x:Key="HimoNavMuted">#A48AC6</Color>
            <Color x:Key="HimoDangerSoft">#41162F</Color>
            <Color x:Key="HimoGlow">#B92EFF</Color>
            <Color x:Key="HimoGlowSoft">#6627FF</Color>
            <Color x:Key="HimoPanel">#170A28</Color>
            <Color x:Key="HimoPanelRaised">#24113A</Color>
            <Color x:Key="HimoNeonBorder">#7427B6</Color>
            <LinearGradientBrush x:Key="HimoAccentGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F58BFF" Offset="0.0" />
                <GradientStop Color="#A12AFF" Offset="0.42" />
                <GradientStop Color="#7218FF" Offset="0.76" />
                <GradientStop Color="#D34DFF" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HimoBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#12061F" Offset="0.0" />
                <GradientStop Color="#090511" Offset="0.55" />
                <GradientStop Color="#160725" Offset="1.0" />
            </LinearGradientBrush>

            <Style x:Key="HimoPageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="23" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="HimoPageSubtitle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{DynamicResource HimoHeaderTextMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="HimoBackButton" TargetType="Button">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.72" />
                                    <Setter Property="Scale" Value="0.96" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="TitleColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
            <Style TargetType="TimePicker">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="ThumbColor" Value="#F7EDFF" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Color" Value="{DynamicResource HimoAccent}" />
            </Style>
            <Style TargetType="ActivityIndicator">
                <Setter Property="Color" Value="{DynamicResource HimoAccent}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoCard}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="Padding" Value="15,0" />
            </Style>
            <Style x:Key="HimoPrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="BorderColor" Value="{DynamicResource HimoFocus}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Shadow">
                    <Setter.Value><Shadow Brush="#9B25FF" Offset="0,0" Radius="12" Opacity="0.22" /></Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HimoOutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{DynamicResource HimoBorder}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="CornerRadius" Value="15" />
            </Style>
            <Style x:Key="HimoCardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoCard}" />
                <Setter Property="Stroke" Value="{DynamicResource HimoBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,5" />
            </Style>
            <Style x:Key="HimoInputBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoInput}" />
                <Setter Property="Stroke" Value="{DynamicResource HimoBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style x:Key="HimoSectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{DynamicResource HimoMuted}" />
                <Setter Property="Margin" Value="2,8,2,2" />
            </Style>

            <Style x:Key="HimoBodyLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="HimoCaption" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource HimoTextSecondary}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="HimoIconTile" TargetType="Border">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoSoft}" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>
            <Style x:Key="HimoListCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoCard}" />
                <Setter Property="Stroke" Value="{DynamicResource HimoBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Shadow">
                    <Setter.Value><Shadow Brush="#8C22E8" Offset="0,2" Radius="10" Opacity="0.10" /></Setter.Value>
                </Setter>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Stroke" Value="{DynamicResource HimoFocus}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="HimoIconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoSoft}" />
                <Setter Property="TextColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="WidthRequest" Value="46" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.78" />
                                    <Setter Property="Scale" Value="0.94" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="HimoPillButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoSoft}" />
                <Setter Property="TextColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <!-- Stage 6: consistent pressed/disabled states across the app. -->
            <Style x:Key="HimoActionButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoAccent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="MinimumHeightRequest" Value="46" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="BorderColor" Value="{DynamicResource HimoFocus}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Shadow">
                    <Setter.Value><Shadow Brush="#9B25FF" Offset="0,0" Radius="10" Opacity="0.20" /></Setter.Value>
                </Setter>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.86" />
                                    <Setter Property="Scale" Value="0.98" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.48" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
