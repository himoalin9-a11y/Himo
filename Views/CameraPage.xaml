<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Himo.Views"
    x:Class="Himo.Views.CameraPage"
    FlowDirection="LeftToRight"
    BackgroundColor="#000000"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="CameraBlack">#000000</Color>
            <Color x:Key="CameraControl">#252525</Color>
            <Color x:Key="CameraControlIdle">#353535</Color>
            <Color x:Key="CameraWhite">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#000000" RowDefinitions="*,Auto" RowSpacing="0">
        <!-- Full-screen live camera preview -->
        <Grid Grid.Row="0" BackgroundColor="#000000">
            <views:CameraPreview x:Name="Camera"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill" />

            <BoxView x:Name="FilterPreviewOverlay"
                     IsVisible="False"
                     InputTransparent="True"
                     BackgroundColor="Transparent"
                     Opacity="0" />

            <BoxView x:Name="BeautyPreviewOverlay"
                     IsVisible="False"
                     InputTransparent="True"
                     BackgroundColor="Transparent"
                     Opacity="0" />

            <!-- Rule-of-thirds grid; thin lines only, like a native camera app. -->
            <Grid x:Name="GridOverlay"
                  IsVisible="False"
                  InputTransparent="True"
                  ColumnDefinitions="*,*,*"
                  RowDefinitions="*,*,*">
                <BoxView Grid.Column="0" Grid.RowSpan="3" WidthRequest="1"
                         HorizontalOptions="End" BackgroundColor="#8CFFFFFF" />
                <BoxView Grid.Column="1" Grid.RowSpan="3" WidthRequest="1"
                         HorizontalOptions="End" BackgroundColor="#8CFFFFFF" />
                <BoxView Grid.Row="0" Grid.ColumnSpan="3" HeightRequest="1"
                         VerticalOptions="End" BackgroundColor="#8CFFFFFF" />
                <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1"
                         VerticalOptions="End" BackgroundColor="#8CFFFFFF" />
            </Grid>

            <!-- Native-camera top corners: only flash and close remain visible. -->
            <Grid HorizontalOptions="Fill"
                  VerticalOptions="Start"
                  Padding="16,12,16,0"
                  ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="8"
                  ZIndex="10">
                <Button x:Name="FlashButton"
                        Grid.Column="0"
                        Text=""
                        ImageSource="himo_cam_flash_white.png"
                        SemanticProperties.Description="تشغيل الفلاش أو إيقافه"
                        BackgroundColor="#55000000"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        Padding="10"
                        Clicked="FlashClicked" />

                <!-- Keep timer behavior wired, but remove its extra on-screen chip to match the reference. -->
                <Button x:Name="TimerButton"
                        Grid.Column="1"
                        Text="0s"
                        IsVisible="False"
                        FontSize="11"
                        TextColor="White"
                        BackgroundColor="#66000000"
                        WidthRequest="1"
                        HeightRequest="1"
                        Padding="0"
                        Clicked="TimerClicked" />

                <Label x:Name="CameraHintLabel"
                       Grid.Column="2"
                       Text=""
                       IsVisible="False" />

                <Button Grid.Column="3"
                        Text=""
                        ImageSource="himo_cam_close_white.png"
                        SemanticProperties.Description="إغلاق الكاميرا"
                        BackgroundColor="#55000000"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        Padding="11"
                        Clicked="CloseClicked" />
            </Grid>

            <!-- Secondary tools stay small and unobtrusive on the preview. -->
            <VerticalStackLayout HorizontalOptions="Start"
                                 VerticalOptions="Center"
                                 Margin="12,0,0,32"
                                 Spacing="9"
                                 IsVisible="False"
                                 ZIndex="5">
                <Button x:Name="FocusButton"
                        Text=""
                        ImageSource="himo_cam_focus_white.png"
                        SemanticProperties.Description="التركيز"
                        BackgroundColor="#66000000"
                        WidthRequest="38"
                        HeightRequest="38"
                        CornerRadius="19"
                        Padding="10"
                        Clicked="FocusClicked" />
                <Button x:Name="GridButton"
                        Text=""
                        ImageSource="himo_cam_grid_white.png"
                        SemanticProperties.Description="إظهار الشبكة"
                        BackgroundColor="#66000000"
                        WidthRequest="38"
                        HeightRequest="38"
                        CornerRadius="19"
                        Padding="10"
                        Clicked="GridClicked" />
            </VerticalStackLayout>

            <!-- Small horizontal zoom chips, avoiding oversized controls. -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,82"
                                   Spacing="8"
                                   IsVisible="False"
                                   ZIndex="5">
                <Button x:Name="Zoom1Button" Text="1x" FontSize="11"
                        TextColor="White" BackgroundColor="#AA222222"
                        WidthRequest="38" HeightRequest="30" CornerRadius="15" Padding="0"
                        Clicked="ZoomClicked" CommandParameter="1" />
                <Button x:Name="Zoom2Button" Text="2x" FontSize="11"
                        TextColor="White" BackgroundColor="#AA222222"
                        WidthRequest="38" HeightRequest="30" CornerRadius="15" Padding="0"
                        Clicked="ZoomClicked" CommandParameter="2" />
                <Button x:Name="Zoom4Button" Text="4x" FontSize="11"
                        TextColor="White" BackgroundColor="#AA222222"
                        WidthRequest="38" HeightRequest="30" CornerRadius="15" Padding="0"
                        Clicked="ZoomClicked" CommandParameter="4" />
            </HorizontalStackLayout>

            <!-- Recent Himo captures appear here as real thumbnails when available. -->
            <VerticalStackLayout x:Name="RecentStripHost"
                                 IsVisible="False"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="End"
                                 Spacing="4"
                                 ZIndex="8">
                <Border x:Name="RecentStripHandle"
                        WidthRequest="24"
                        HeightRequest="3"
                        HorizontalOptions="Center"
                        BackgroundColor="#F2FFFFFF"
                        StrokeThickness="0" />
                <CollectionView x:Name="RecentStrip"
                                HeightRequest="66"
                                SelectionMode="Single"
                                SelectionChanged="RecentCaptureSelected"
                                BackgroundColor="#77000000"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="58"
                                    HeightRequest="58"
                                    Margin="3,3,0,3"
                                    Padding="1"
                                    BackgroundColor="#222222"
                                    Stroke="#66FFFFFF"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" />
                                    <Border IsVisible="{Binding IsVideo}"
                                            BackgroundColor="#66000000"
                                            StrokeThickness="0">
                                        <Image Source="himo_cam_video_white.png"
                                               WidthRequest="21"
                                               HeightRequest="21"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Border x:Name="StatusBorder"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,64,0,0"
                    BackgroundColor="#B3000000"
                    Stroke="#55FFFFFF"
                    StrokeThickness="1"
                    Padding="13,6"
                    IsVisible="False"
                    ZIndex="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Label x:Name="StatusLabel"
                       TextColor="White"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </Border>

            <!-- Filter drawer floats above the controls and does not resize preview. -->
            <Border x:Name="FilterPanel"
                    IsVisible="False"
                    ZIndex="19"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="12,0,12,76"
                    BackgroundColor="#F0141414"
                    Stroke="#66FFFFFF"
                    StrokeThickness="1"
                    Padding="8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="7">
                        <Button x:Name="FilterNaturalButton" Text="طبيعي" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="Natural" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterVividButton" Text="حيوي" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="Vivid" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterWarmButton" Text="دافئ" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="Warm" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterCoolButton" Text="بارد" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="Cool" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterMonoButton" Text="أبيض وأسود" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="Mono" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterSepiaButton" Text="سيبيا" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="Sepia" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterBeautyNaturalButton" Text="إشراقة طبيعية" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="BeautyNatural" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterBeautySoftButton" Text="بشرة مخملية" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="BeautySoft" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterBeautyGlowButton" Text="توهج حريري" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="BeautyGlow" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterBeautyMakeupSoftButton" Text="مكياج ناعم" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="BeautyMakeupSoft" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterBeautyMakeupButton" Text="مكياج متكامل" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="BeautyMakeup" Clicked="FilterSelectedClicked" />
                        <Button x:Name="FilterClearSkinButton" Text="بشرة صافية" FontSize="12" TextColor="{DynamicResource HimoPrimary}" BackgroundColor="{DynamicResource HimoCard}" CornerRadius="15" HeightRequest="32" Padding="13,0" CommandParameter="ClearSkin" Clicked="FilterSelectedClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Native-looking lower camera rail: compact controls, large central shutter, simple modes. -->
        <Grid Grid.Row="1"
              BackgroundColor="#000000"
              Padding="12,6,12,10"
              RowDefinitions="Auto,Auto"
              RowSpacing="8">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,*,*"
                  FlowDirection="LeftToRight"
                  HeightRequest="72">
                <Grid Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                    <Button x:Name="SwitchCameraButton"
                            Text=""
                            ImageSource="himo_cam_switch_white.png"
                            SemanticProperties.Description="تبديل الكاميرا الأمامية والخلفية"
                            BackgroundColor="#292929"
                            WidthRequest="42"
                            HeightRequest="42"
                            CornerRadius="21"
                            Padding="10"
                            Clicked="SwitchCameraClicked" />
                    <Button x:Name="PauseResumeButton"
                            Text=""
                            ImageSource="himo_cam_pause_white.png"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="24"
                            Padding="13"
                            BackgroundColor="#292929"
                            IsVisible="False"
                            Clicked="PauseResumeClicked" />
                </Grid>

                <Border Grid.Column="1"
                        WidthRequest="62"
                        HeightRequest="62"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent"
                        Stroke="#FFFFFF"
                        StrokeThickness="3">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="31" />
                    </Border.StrokeShape>
                    <Button x:Name="CaptureButton"
                            Text=""
                            BackgroundColor="#FFFFFF"
                            WidthRequest="50"
                            HeightRequest="50"
                            CornerRadius="25"
                            Padding="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Clicked="CaptureClicked" />
                </Border>

                <HorizontalStackLayout Grid.Column="2"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="12">
                    <Button x:Name="FilterToggleButton"
                            Text=""
                            ImageSource="himo_cam_filters_white.png"
                            SemanticProperties.Description="الفلاتر والتجميل"
                            BackgroundColor="#292929"
                            WidthRequest="42"
                            HeightRequest="42"
                            CornerRadius="21"
                            Padding="10"
                            Clicked="FilterToggleClicked" />
                    <Button x:Name="GalleryHintButton"
                            Text=""
                            ImageSource="himo_pro_ui_himo_ui_gallery_white.png"
                            SemanticProperties.Description="فتح المعرض"
                            BackgroundColor="#292929"
                            WidthRequest="42"
                            HeightRequest="42"
                            CornerRadius="21"
                            Padding="10"
                            Clicked="GalleryClicked" />
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="5"
                  FlowDirection="LeftToRight"
                  HeightRequest="44">
                <Button x:Name="VideoNoteModeButton"
                        Grid.Column="0"
                        Text="ملاحظة فيديو"
                        FontSize="12"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        CornerRadius="24"
                        Padding="4,0"
                        Clicked="VideoNoteModeClicked" />
                <Button x:Name="PhotoModeButton"
                        Grid.Column="1"
                        Text="صورة"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        BackgroundColor="#242424"
                        CornerRadius="24"
                        Padding="4,0"
                        Clicked="PhotoModeClicked" />
                <Button x:Name="VideoModeButton"
                        Grid.Column="2"
                        Text="فيديو"
                        FontSize="12"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        CornerRadius="24"
                        Padding="4,0"
                        Clicked="VideoModeClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
