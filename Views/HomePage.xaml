<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             xmlns:viewmodels="clr-namespace:Himo.ViewModels"
             x:Class="Himo.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Himo"
             FlowDirection="RightToLeft"
             BackgroundColor="#F7FAFE"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#2F80ED</Color>
            <Color x:Key="PrimaryDark">#1769D1</Color>
            <Color x:Key="PrimarySoft">#EAF3FF</Color>
            <Color x:Key="PageBg">#F7FAFE</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Text">#172033</Color>
            <Color x:Key="Secondary">#718096</Color>
            <Color x:Key="Divider">#E7EDF5</Color>
            <Color x:Key="Online">#28C76F</Color>
            <Color x:Key="Unread">#2F80ED</Color>
            <Style x:Key="RoundIcon" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="BottomIcon" TargetType="Image">
                <Setter Property="WidthRequest" Value="23" />
                <Setter Property="HeightRequest" Value="23" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="96,64,*,82" BackgroundColor="#F7FAFE">

        <!-- HEADER -->
        <Grid Grid.Row="0" Padding="18,10" ColumnDefinitions="52,*,120" FlowDirection="LeftToRight">
            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                    BackgroundColor="#FFFFFF" Stroke="#E3EAF3" StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid>
                    <Image x:Name="HomeProfilePlaceholderIcon"
                           Source="himo_phase1_icon_user.png"
                           WidthRequest="23" HeightRequest="23"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Image x:Name="HomeProfilePhotoImage"
                           IsVisible="False"
                           Aspect="AspectFill"
                           WidthRequest="42" HeightRequest="42"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Clip>
                            <EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21" />
                        </Image.Clip>
                    </Image>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ProfileClicked" />
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                <Label Text="Himo" FontSize="26" FontAttributes="Bold" TextColor="#172033"
                       HorizontalTextAlignment="Center" />
                <Label Text="محادثاتك في مكان واحد" FontSize="10.5" TextColor="#7B8798"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End" VerticalOptions="Center" FlowDirection="LeftToRight">
                <ImageButton Source="icon_search.png" Style="{StaticResource RoundIcon}"
                             Clicked="SearchUserClicked" SemanticProperties.Description="بحث" />
                <ImageButton Source="himo_phase1_icon_more.png" Style="{StaticResource RoundIcon}"
                             Clicked="OverflowMenuClicked" SemanticProperties.Description="المزيد" />
            </HorizontalStackLayout>
        </Grid>

        <!-- SEARCH -->
        <Border Grid.Row="1" Margin="16,0,16,8" Padding="10,0" HeightRequest="54"
                BackgroundColor="#FFFFFF" Stroke="#E3EAF3" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
            <Grid ColumnDefinitions="34,*" FlowDirection="LeftToRight">
                <Image Grid.Column="0" Source="icon_search.png" WidthRequest="20" HeightRequest="20"
                       VerticalOptions="Center" />
                <Entry x:Name="Search" Grid.Column="1" FlowDirection="RightToLeft"
                       Placeholder="البحث عن محادثة أو شخص..." PlaceholderColor="#98A4B5"
                       TextColor="#172033" FontSize="14.5" BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing" VerticalOptions="Center"
                       TextChanged="SearchTextChanged" />
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="2">
            <Grid x:Name="ConnectionStatusContainer" IsVisible="False" HeightRequest="0">
                <Label x:Name="ConnectionLabel" Text="" />
                <ActivityIndicator x:Name="RefreshIndicator" IsRunning="False" IsVisible="False" />
                <Button x:Name="RetryButton" IsVisible="False" Clicked="RetryClicked" />
            </Grid>

            <RefreshView x:Name="ConversationRefresh" Refreshing="ConversationRefresh_Refreshing" Margin="12,0,12,0">
                <CollectionView ItemsSource="{Binding FilteredConversations}" SelectionMode="Single"
                                SelectionChanged="ConversationSelected" ItemSizingStrategy="MeasureAllItems"
                                BackgroundColor="Transparent" FlowDirection="RightToLeft"
                                VerticalScrollBarVisibility="Never" Margin="0,0,0,0">
                    <CollectionView.EmptyView>
                        <Grid HeightRequest="300" Padding="20,30">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                <Border WidthRequest="70" HeightRequest="70" BackgroundColor="#EAF3FF"
                                        Stroke="#CFE2FB" StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                    <Image Source="himo_phase1_icon_chat_empty.png" WidthRequest="34" HeightRequest="34" />
                                </Border>
                                <Label x:Name="EmptyTitle" Text="لا توجد محادثات بعد" FontSize="18"
                                       FontAttributes="Bold" TextColor="#172033" HorizontalTextAlignment="Center" />
                                <Label x:Name="EmptyHint" Text="ابدأ محادثة جديدة مع أصدقائك" FontSize="13"
                                       TextColor="#718096" HorizontalTextAlignment="Center" />
                                <Button Text="بدء محادثة" Clicked="NewConversationClicked" HeightRequest="44"
                                        Padding="22,0" BackgroundColor="#2F80ED" TextColor="White"
                                        FontAttributes="Bold" CornerRadius="22" />
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Conversation">
                            <Grid FlowDirection="LeftToRight" ColumnDefinitions="58,*,74" ColumnSpacing="11"
                                  Padding="4,7" MinimumHeightRequest="72">

                                <!-- Avatar -->
                                <Grid Grid.Column="0" WidthRequest="54" HeightRequest="54" HorizontalOptions="Start" VerticalOptions="Center">
                                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#EAF3FF"
                                            Stroke="#D4E5FA" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                                        <Grid>
                                            <Label Text="{Binding Initial}" IsVisible="{Binding ShowProfileInitial}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#2F80ED" HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <Image Source="{Binding ProfilePhotoPath}"
                                                   IsVisible="{Binding HasLocalProfilePhoto}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="52" HeightRequest="52">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <Ellipse WidthRequest="12" HeightRequest="12" HorizontalOptions="End"
                                             VerticalOptions="End" Margin="0,0,0,1" Fill="#28C76F"
                                             Stroke="#FFFFFF" StrokeThickness="2" />
                                </Grid>

                                <!-- Name + last message -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3"
                                                     FlowDirection="RightToLeft">
                                    <Label Text="{Binding Name}" FontSize="15.5" FontAttributes="Bold"
                                           TextColor="#172033" LineBreakMode="TailTruncation" MaxLines="1" />
                                    <Label Text="{Binding LastMessage}" FontSize="12.5" TextColor="#718096"
                                           LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>

                                <!-- Time / unread -->
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="5"
                                                     HorizontalOptions="End" FlowDirection="RightToLeft">
                                    <Label Text="{Binding Time}" FontSize="11.5" TextColor="#718096"
                                           HorizontalTextAlignment="End" />
                                    <Border WidthRequest="24" HeightRequest="24" BackgroundColor="#2F80ED"
                                            StrokeThickness="0" HorizontalOptions="End">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding UnreadCount}" Value="0">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding UnreadCount}" TextColor="White" FontSize="10"
                                               FontAttributes="Bold" HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1" Grid.ColumnSpan="2" HeightRequest="1"
                                         Color="#E7EDF5" VerticalOptions="End" Margin="0,0,0,-7" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- FLOATING NEW CHAT -->
            <Border WidthRequest="60" HeightRequest="60" HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,12,14" BackgroundColor="#2F80ED" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
                <Image Source="icon_plus.png" WidthRequest="27" HeightRequest="27" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="NewConversationClicked" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- BOTTOM NAV -->
        <Border Grid.Row="3" Margin="10,8,10,10" BackgroundColor="#FFFFFF"
                Stroke="#E2EAF4" StrokeThickness="1" Padding="5,4">
            <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*,*" FlowDirection="LeftToRight">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Image Source="icon_home.png" Style="{StaticResource BottomIcon}" />
                    <Label Text="الرئيسية" FontSize="10" FontAttributes="Bold" TextColor="#2F80ED" HorizontalTextAlignment="Center" />
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer /></VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <Image Source="icon_search.png" Style="{StaticResource BottomIcon}" />
                    <Label Text="البحث" FontSize="10" TextColor="#718096" HorizontalTextAlignment="Center" />
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="SearchUserClicked" /></VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <Image Source="himo_phase1_icon_user.png" Style="{StaticResource BottomIcon}" />
                    <Label Text="الملف الشخصي" FontSize="10" TextColor="#718096" HorizontalTextAlignment="Center" />
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="ProfileClicked" /></VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <Image Source="himo_phase1_icon_settings.png" Style="{StaticResource BottomIcon}" />
                    <Label Text="الإعدادات" FontSize="10" TextColor="#718096" HorizontalTextAlignment="Center" />
                    <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="SettingsClicked" /></VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- OVERFLOW MENU -->
        <Border x:Name="OverflowMenu" IsVisible="False" Grid.Row="0" Grid.RowSpan="4"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,62,18,0" WidthRequest="190"
                BackgroundColor="#FFFFFF" Stroke="#E3EAF3" StrokeThickness="1"
                Padding="6" ZIndex="100">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,4" Radius="14" Opacity="0.18" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="2">
                <Grid ColumnDefinitions="38,*" Padding="8,10">
                    <Image Grid.Column="0" Source="himo_phase1_icon_settings.png" WidthRequest="21" HeightRequest="21"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="الإعدادات" FontSize="14" TextColor="#172033"
                           VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingsClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
                <Grid ColumnDefinitions="38,*" Padding="8,10">
                    <Image Grid.Column="0" Source="himo_phase1_icon_user.png" WidthRequest="21" HeightRequest="21"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="الملف الشخصي" FontSize="14" TextColor="#172033"
                           VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ProfileClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
                <BoxView HeightRequest="1" Color="#E7EDF5" Margin="8,2" />
                <Grid ColumnDefinitions="38,*" Padding="8,10">
                    <Image Grid.Column="0" Source="icon_plus.png" WidthRequest="21" HeightRequest="21"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="إنشاء مجموعة" FontSize="14" TextColor="#172033"
                           VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CreateGroupClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
