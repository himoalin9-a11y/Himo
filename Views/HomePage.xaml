<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             xmlns:viewmodels="clr-namespace:Himo.ViewModels"
             x:Class="Himo.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Himo"
             FlowDirection="RightToLeft"
             BackgroundColor="#F8F6FC"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F8F6FC">

        <!-- Premium compact header -->
        <Grid Grid.Row="0" Padding="18,16,18,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#EEE8FF" StrokeThickness="0" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Image Source="himo_logo.png" Aspect="AspectFit" Margin="7" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Himo" FontSize="24" FontAttributes="Bold" TextColor="#24143F" />
                <Label Text="محادثاتك في مكان واحد" FontSize="11" TextColor="#8A7D9D" />
            </VerticalStackLayout>

            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="White" Stroke="#E7DFF2" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Button Text="⚙" FontSize="19" WidthRequest="44" HeightRequest="44" Padding="0" BackgroundColor="Transparent" TextColor="#6336D6" Clicked="SettingsClicked" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,4,16,18">

                <!-- Hidden connection controls: networking logic remains intact. -->
                <Grid x:Name="ConnectionStatusContainer" IsVisible="False" HeightRequest="0">
                    <Label x:Name="ConnectionLabel" Text="" />
                    <ActivityIndicator x:Name="RefreshIndicator" IsRunning="False" IsVisible="False" />
                    <Button x:Name="RetryButton" IsVisible="False" Clicked="RetryClicked" />
                </Grid>

                <!-- Search -->
                <Border BackgroundColor="White" Stroke="#E5DEEE" StrokeThickness="1" Padding="8,3">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="42,*,42" HeightRequest="50" ColumnSpacing="4">
                        <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#F0EAFF" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Label Text="⌕" FontSize="23" TextColor="#6336D6" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <SearchBar x:Name="Search" Grid.Column="1" Placeholder="ابحث عن مستخدم أو محادثة..." FontSize="13" CancelButtonColor="#6336D6" TextChanged="SearchTextChanged" VerticalOptions="Center" />
                        <Border Grid.Column="2" WidthRequest="36" HeightRequest="36" BackgroundColor="#6336D6" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Button Text="⌕" FontSize="17" WidthRequest="36" HeightRequest="36" Padding="0" BackgroundColor="Transparent" TextColor="White" Clicked="SearchUserClicked" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Filters -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="المحادثات" FontSize="21" FontAttributes="Bold" TextColor="#24143F" />
                        <Label Text="آخر الرسائل والتحديثات" FontSize="11" TextColor="#91869E" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="End">
                        <Border BackgroundColor="#6336D6" StrokeThickness="0" Padding="15,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Label Text="الكل" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Border BackgroundColor="White" Stroke="#E5DEEE" StrokeThickness="1" Padding="13,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Label Text="غير مقروءة" FontSize="11" TextColor="#776B86" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <RefreshView x:Name="ConversationRefresh" Refreshing="ConversationRefresh_Refreshing" MinimumHeightRequest="180">
                    <CollectionView ItemsSource="{Binding FilteredConversations}"
                                    SelectionMode="Single"
                                    SelectionChanged="ConversationSelected"
                                    SemanticProperties.Description="قائمة المحادثات"
                                    ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="16,45" Spacing="11" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border WidthRequest="76" HeightRequest="76" BackgroundColor="#EEE8FF" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                                    <Label Text="✦" FontSize="28" TextColor="#6336D6" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label x:Name="EmptyTitle" Text="لا توجد محادثات بعد" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#24143F" />
                                <Label x:Name="EmptyHint" Text="ابدأ محادثة جديدة مع أصدقائك" FontSize="12" TextColor="#91869E" HorizontalTextAlignment="Center" />
                                <Button Text="＋  بدء محادثة" WidthRequest="190" HeightRequest="46" CornerRadius="15" BackgroundColor="#6336D6" TextColor="White" FontAttributes="Bold" Clicked="NewConversationClicked" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Conversation">
                                <Border Margin="0,3" Padding="11,10" BackgroundColor="White" Stroke="#E6DFEF" StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="11" MinimumHeightRequest="64">
                                        <Grid>
                                            <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#EEE8FF" Stroke="#DCCBFF" StrokeThickness="1" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                                <Label Text="{Binding Initial}" TextColor="#6336D6" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" />
                                            </Border>
                                            <Ellipse WidthRequest="11" HeightRequest="11" Fill="#35B978" Stroke="White" StrokeThickness="2" HorizontalOptions="Start" VerticalOptions="End" Margin="0,0,0,1" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#24143F" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding LastMessage}" FontSize="11.5" TextColor="#81758F" LineBreakMode="TailTruncation" MaxLines="1" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                            <Label Text="{Binding Time}" FontSize="9.5" TextColor="#9B91A8" HorizontalTextAlignment="End" />
                                            <Border BackgroundColor="#6336D6" WidthRequest="21" HeightRequest="21" StrokeThickness="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding UnreadCount}" Value="0">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                                <Label Text="{Binding UnreadCount}" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Border Grid.Row="2" BackgroundColor="White" Stroke="#E4DDEE" StrokeThickness="1" Padding="12,8,12,10">
            <Border.StrokeShape><RoundRectangle CornerRadius="25,25,0,0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="2">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                    <Border WidthRequest="42" HeightRequest="30" BackgroundColor="#EEE8FF" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Label Text="⌂" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#6336D6" />
                    </Border>
                    <Label Text="المحادثات" FontSize="9.5" TextColor="#6336D6" FontAttributes="Bold" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="1">
                    <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#6336D6" StrokeThickness="0" Margin="0,-16,0,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                        <Button Text="＋" FontSize="24" WidthRequest="46" HeightRequest="46" Padding="0" BackgroundColor="Transparent" TextColor="White" Clicked="NewConversationClicked" />
                    </Border>
                    <Label Text="محادثة جديدة" FontSize="9.5" TextColor="#6336D6" FontAttributes="Bold" Margin="0,-1,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="1">
                    <Border WidthRequest="42" HeightRequest="30" BackgroundColor="Transparent" StrokeThickness="0">
                        <Label Text="⌕" FontSize="22" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#968BA4" />
                    </Border>
                    <Label Text="البحث" FontSize="9.5" TextColor="#968BA4" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SearchUserClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="1">
                    <Border WidthRequest="42" HeightRequest="30" BackgroundColor="Transparent" StrokeThickness="0">
                        <Label Text="⚙" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#968BA4" />
                    </Border>
                    <Label Text="الإعدادات" FontSize="9.5" TextColor="#968BA4" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingsClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="1">
                    <Border WidthRequest="42" HeightRequest="30" BackgroundColor="Transparent" StrokeThickness="0">
                        <Label Text="◉" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#968BA4" />
                    </Border>
                    <Label Text="الملف الشخصي" FontSize="9.5" TextColor="#968BA4" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ProfileClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
