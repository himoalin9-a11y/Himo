<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             xmlns:viewmodels="clr-namespace:Himo.ViewModels"
             x:Class="Himo.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Himo"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="146,*,86" BackgroundColor="{DynamicResource HimoBackground}">

        <!-- Compact glossy purple header -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="18,7,18,9">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#32106F" Offset="0.0" />
                    <GradientStop Color="#6726D6" Offset="0.45" />
                    <GradientStop Color="#A95BFF" Offset="0.78" />
                    <GradientStop Color="#6B2FE8" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,34,34" />
            </Border.StrokeShape>

            <Grid RowDefinitions="50,56" RowSpacing="2">
                <!-- Vertical overflow menu on the left side of the purple header -->
                <Border Grid.Row="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label Text="⋮"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
 />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OverflowMenuClicked" />
                    </Border.GestureRecognizers>
                </Border>
                <VerticalStackLayout Grid.Row="0"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="0">
                    <Label Text="Himo"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label Text="تواصل أقرب .. دائماً"
                           FontSize="10"
                           TextColor="#F1E8FF"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Search is intentionally inside the purple header -->
                <Border Grid.Row="1"
                        BackgroundColor="#FFFFFF"
                        Stroke="#E8D9FF"
                        StrokeThickness="1.5"
                        Padding="7"
                        HeightRequest="56"
                        VerticalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Grid FlowDirection="RightToLeft"
                          ColumnDefinitions="52,*,52"
                          ColumnSpacing="3">
                        <Border Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="#7435E8"
                                Stroke="#A979FF"
                                StrokeThickness="1"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SearchUserClicked" />
                            </Border.GestureRecognizers>
                            <Image Source="icon_search.png"
                                   WidthRequest="21"
                                   HeightRequest="21"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Entry x:Name="Search"
                               Grid.Column="1"
                               FlowDirection="RightToLeft"
                               Placeholder="ابحث عن محادثة أو شخص..."
                               PlaceholderColor="#8B8795"
                               FontSize="15"
                               TextColor="#252331"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing"
                               HorizontalOptions="Fill"
                               VerticalOptions="Center"
                               TextChanged="SearchTextChanged" />
                        <BoxView Grid.Column="2"
                                 WidthRequest="1"
                                 HeightRequest="28"
                                 BackgroundColor="#E8E1F3"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1" BackgroundColor="{DynamicResource HimoBackground}">
            <VerticalStackLayout Padding="18,20,18,16" Spacing="14">

                <!-- Kept for existing connection logic; hidden. -->
                <Grid x:Name="ConnectionStatusContainer" IsVisible="False" HeightRequest="0">
                    <Label x:Name="ConnectionLabel" Text="" />
                    <ActivityIndicator x:Name="RefreshIndicator" IsRunning="False" IsVisible="False" />
                    <Button x:Name="RetryButton" IsVisible="False" Clicked="RetryClicked" />
                </Grid>

                <!-- Home heading replaces the old conversations header and filters -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <Label Text="الرئيسية"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="#151521"
                           HorizontalTextAlignment="End" />
                    <Button Grid.Column="1" Text="+ مجموعة" Style="{StaticResource HimoPillButton}" Clicked="CreateGroupClicked" />
                </Grid>

                <RefreshView x:Name="ConversationRefresh"
                             Refreshing="ConversationRefresh_Refreshing"
                             MinimumHeightRequest="240">
                    <CollectionView ItemsSource="{Binding FilteredConversations}"
                                    SelectionMode="Single"
                                    SelectionChanged="ConversationSelected"

                                    ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.EmptyView>
                            <Grid HeightRequest="280" Padding="12,28">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                    <Border WidthRequest="72" HeightRequest="72" BackgroundColor="{DynamicResource HimoSoft}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                        <Label Text="✦" FontSize="30" TextColor="#6736D8" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label x:Name="EmptyTitle" Text="لا توجد محادثات بعد" FontSize="18" FontAttributes="Bold" TextColor="#24222D" HorizontalTextAlignment="Center" />
                                    <Label x:Name="EmptyHint" Text="ابدأ محادثة جديدة مع أصدقائك" FontSize="12.5" TextColor="#85818E" HorizontalTextAlignment="Center" />
                                    <Button Text="بدء محادثة" Clicked="NewConversationClicked" Style="{StaticResource HimoActionButton}" HeightRequest="44" Padding="22,0" BackgroundColor="{DynamicResource HimoAccent}" TextColor="White" />
                                </VerticalStackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Conversation">
                                <Border Margin="0,4"
                                        Padding="13,11"
                                        BackgroundColor="{DynamicResource HimoCard}"
                                        Stroke="{DynamicResource HimoBorder}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="46,*,Auto"
                                          ColumnSpacing="11"
                                          MinimumHeightRequest="60">
                                        <Grid>
                                            <Border WidthRequest="46"
                                                    HeightRequest="46"
                                                    BackgroundColor="#EEE9FF"
                                                    Stroke="#E4D9FF"
                                                    StrokeThickness="1"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Initial}"
                                                       TextColor="#6736D8"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       FontSize="17"
                                                       FontAttributes="Bold" />
                                            </Border>
                                            <Ellipse WidthRequest="10"
                                                     HeightRequest="10"
                                                     Fill="#35B978"
                                                     Stroke="White"
                                                     StrokeThickness="2"
                                                     HorizontalOptions="Start"
                                                     VerticalOptions="End" />
                                        </Grid>

                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center"
                                                             Spacing="3">
                                            <Label Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource HimoPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding LastMessage}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource HimoTextSecondary}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="5"
                                                             HorizontalOptions="End"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Time}"
                                                   FontSize="9"
                                                   TextColor="{DynamicResource HimoTextSecondary}"
                                                   HorizontalTextAlignment="End" />
                                            <Border BackgroundColor="#3476D8"
                                                    WidthRequest="20"
                                                    HeightRequest="20"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="End">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding UnreadCount}"
                                                                 Value="0">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding UnreadCount}"
                                                       TextColor="White"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Grid Grid.Row="2" Margin="14,0,14,10">
            <Border BackgroundColor="{DynamicResource HimoHeader}"
                    Stroke="{DynamicResource HimoAccentDark}"
                    StrokeThickness="1"
                    Padding="10,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">

                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NewConversationClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image Source="icon_plus.png" WidthRequest="21" HeightRequest="21" Opacity="0.82" Aspect="AspectFit" HorizontalOptions="Center" />
                        <Label Text="محادثة جديدة" FontSize="9" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SearchUserClicked" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image Source="icon_search_white.svg" WidthRequest="21" HeightRequest="21" Aspect="AspectFit" HorizontalOptions="Center" />
                        <Label Text="بحث" FontSize="9" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2" BackgroundColor="#FFFFFF" Stroke="#FFFFFF" StrokeThickness="1" Padding="15,4" HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Image Source="icon_home.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                            <Label Text="الرئيسية" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource HimoAccent}" HorizontalTextAlignment="Start" HorizontalOptions="Start" />
                            <Border HeightRequest="3" WidthRequest="30" BackgroundColor="{DynamicResource HimoAccent}" StrokeThickness="0" HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="2" /></Border.StrokeShape>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Floating overflow menu kept outside the header so it cannot be clipped. -->
        <Border x:Name="OverflowMenu"
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="False"
                WidthRequest="190"
                HeightRequest="104"
                Padding="8"
                BackgroundColor="#FFFFFF"
                Stroke="#E8D9FF"
                StrokeThickness="1"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="12,58,0,0"
                ZIndex="100">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#55000000" Offset="0,5" Radius="14" Opacity="0.35" />
            </Border.Shadow>
            <Grid RowDefinitions="48,48" ColumnDefinitions="34,*" ColumnSpacing="8" RowSpacing="0">
                <Image Grid.Row="0" Grid.Column="0" Source="icon_settings.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" Text="الإعدادات" FontSize="15" FontAttributes="Bold" TextColor="#4B20B7" VerticalTextAlignment="Center" />
                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="SettingsClicked" /></Grid.GestureRecognizers>
                </Grid>
                <Image Grid.Row="1" Grid.Column="0" Source="icon_profile.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="1" Text="الملف الشخصي" FontSize="15" FontAttributes="Bold" TextColor="#4B20B7" VerticalTextAlignment="Center" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="ProfileClicked" /></Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
