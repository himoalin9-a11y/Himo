<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             xmlns:viewmodels="clr-namespace:Himo.ViewModels"
             x:Class="Himo.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Himo"
             FlowDirection="RightToLeft"
             BackgroundColor="#F7F4FC"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F4FC">

        <!-- Header / visual only -->
        <Border Grid.Row="0" BackgroundColor="#5420B8" StrokeThickness="0" Padding="16,14,16,20">
            <Border.StrokeShape><RoundRectangle CornerRadius="0,0,28,28" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="13">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#FFFFFF" Opacity="0.14" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Button Text="⚙" FontSize="18" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="Transparent" TextColor="White" Clicked="SettingsClicked" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="0">
                        <Label Text="Himo" FontSize="21" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Text="تواصل أقرب .. دائمًا" FontSize="9" TextColor="#E9DDFF" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2" WidthRequest="48" HeightRequest="48" BackgroundColor="White" Stroke="#DCC6FF" StrokeThickness="1.5" Padding="3">
                        <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                        <Image Source="himo_logo.png" Aspect="AspectFit" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="محادثاتك" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                        <Label Text="كل من يهمك في مكان واحد" FontSize="11" TextColor="#E9DDFF" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" BackgroundColor="#FFFFFF" Opacity="0.14" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Label Text="✦" FontSize="20" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="14,14,14,18">

                <!-- Hidden connection controls: networking logic remains intact. -->
                <Grid x:Name="ConnectionStatusContainer" IsVisible="False" HeightRequest="0">
                    <Label x:Name="ConnectionLabel" Text="" />
                    <ActivityIndicator x:Name="RefreshIndicator" IsRunning="False" IsVisible="False" />
                    <Button x:Name="RetryButton" IsVisible="False" Clicked="RetryClicked" />
                </Grid>

                <!-- Search -->
                <Border BackgroundColor="White" Stroke="#E4DDF0" StrokeThickness="1" Padding="6,3">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="44,*,44" HeightRequest="50" ColumnSpacing="4">
                        <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#F0E9FF" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Label Text="⌕" FontSize="25" TextColor="#6336D6" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <SearchBar x:Name="Search" Grid.Column="1" Placeholder="ابحث في محادثاتك..." FontSize="13" CancelButtonColor="#6336D6" TextChanged="SearchTextChanged" VerticalOptions="Center" />
                        <Border Grid.Column="2" WidthRequest="38" HeightRequest="38" BackgroundColor="#F0E9FF" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Button Text="⌕" FontSize="18" WidthRequest="38" HeightRequest="38" Padding="0" BackgroundColor="Transparent" TextColor="#6336D6" Clicked="SearchUserClicked" />
                        </Border>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="2,2,2,0">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="المحادثات" FontSize="20" FontAttributes="Bold" TextColor="#24134F" />
                        <Label Text="رسائلك الأخيرة" FontSize="11" TextColor="#8A809B" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#E8DEFF" StrokeThickness="0" Padding="14,8" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Label Text="الكل" FontSize="11" FontAttributes="Bold" TextColor="#6336D6" />
                    </Border>
                </Grid>

                <RefreshView x:Name="ConversationRefresh" Refreshing="ConversationRefresh_Refreshing" MinimumHeightRequest="180">
                    <CollectionView ItemsSource="{Binding FilteredConversations}"
                                    SelectionMode="Single"
                                    SelectionChanged="ConversationSelected"
                                    SemanticProperties.Description="قائمة المحادثات">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="16,40" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border WidthRequest="78" HeightRequest="78" BackgroundColor="#EEE6FF" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                                    <Label Text="•••" FontSize="28" TextColor="#6336D6" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label x:Name="EmptyTitle" Text="لا توجد محادثات بعد" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#24134F" />
                                <Label x:Name="EmptyHint" Text="ابدأ محادثة جديدة مع أصدقائك" FontSize="12" TextColor="#8A809B" HorizontalTextAlignment="Center" />
                                <Button Text="＋  بدء محادثة" WidthRequest="185" HeightRequest="45" CornerRadius="15" BackgroundColor="#6336D6" TextColor="White" FontAttributes="Bold" Clicked="NewConversationClicked" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Conversation">
                                <Border Margin="0,3" Padding="11,10" BackgroundColor="White" Stroke="#E7E0F1" StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="11" MinimumHeightRequest="66">
                                        <Grid>
                                            <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#EEE6FF" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                                <Label Text="{Binding Initial}" TextColor="#6336D6" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" />
                                            </Border>
                                            <Ellipse WidthRequest="11" HeightRequest="11" Fill="#31B56B" Stroke="White" StrokeThickness="2" HorizontalOptions="Start" VerticalOptions="End" Margin="0,0,0,1" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#24134F" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding LastMessage}" FontSize="11.5" TextColor="#81768F" LineBreakMode="TailTruncation" MaxLines="1" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="End" VerticalOptions="Center">
                                            <Label Text="{Binding Time}" FontSize="9.5" TextColor="#9B91A8" HorizontalTextAlignment="End" />
                                            <Border BackgroundColor="#6336D6" WidthRequest="21" HeightRequest="21" StrokeThickness="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding UnreadCount}" Value="0">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                                <Label Text="{Binding UnreadCount}" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Border Grid.Row="2" BackgroundColor="White" Stroke="#E3DCEE" StrokeThickness="1" Padding="10,7,10,9">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                    <Label Text="⌂" FontSize="21" HorizontalTextAlignment="Center" TextColor="#9A90A8" />
                    <Label Text="الرئيسية" FontSize="9.5" TextColor="#9A90A8" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="1">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#6336D6" StrokeThickness="0" Margin="0,-17,0,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                        <Button Text="＋" FontSize="25" WidthRequest="48" HeightRequest="48" Padding="0" BackgroundColor="Transparent" TextColor="White" Clicked="NewConversationClicked" />
                    </Border>
                    <Label Text="محادثة" FontSize="9.5" TextColor="#6336D6" FontAttributes="Bold" Margin="0,-3,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="1">
                    <Label Text="⌕" FontSize="21" HorizontalTextAlignment="Center" TextColor="#9A90A8" />
                    <Label Text="البحث" FontSize="9.5" TextColor="#9A90A8" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SearchUserClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="1">
                    <Label Text="⚙" FontSize="20" HorizontalTextAlignment="Center" TextColor="#9A90A8" />
                    <Label Text="الإعدادات" FontSize="9.5" TextColor="#9A90A8" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingsClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
