<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.AccountManagementPage"
             Title="إدارة الحساب"
             FlowDirection="RightToLeft"
             BackgroundColor="#080817"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.RowSpan="2" WidthRequest="300" HeightRequest="300"
                HorizontalOptions="Start" VerticalOptions="End"
                TranslationX="-190" TranslationY="120" BackgroundColor="#713BC7"
                Opacity="0.08" StrokeThickness="0" InputTransparent="True" ZIndex="-1">
            <Border.StrokeShape><RoundRectangle CornerRadius="150" /></Border.StrokeShape>
        </Border>
        <Grid Grid.Row="0" Padding="18,12,18,10" ColumnDefinitions="48,*,48"
              ColumnSpacing="8" FlowDirection="LeftToRight">
            <Button Grid.Column="0" Text="‹" HeightRequest="42" WidthRequest="42" Padding="0"
                    FontSize="34" FontAttributes="Bold" BackgroundColor="#1B2850"
                    TextColor="#E7ECFF" BorderColor="#334A82" BorderWidth="1" CornerRadius="15"
                    Clicked="BackClicked" HorizontalOptions="Start" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End"
                                 VerticalOptions="Center" FlowDirection="RightToLeft">
                <Label Text="إدارة الحساب" FontSize="24" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="End" />
                <Label Text="كل معلومة في صفحة مستقلة" FontSize="12"
                       TextColor="#A6B9E9" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
            <BoxView Grid.Column="2" WidthRequest="42" HeightRequest="42" Opacity="0" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,8,16,30" Spacing="15">
                <Border Stroke="#5549B4" StrokeThickness="1.2" Padding="15" MinimumHeightRequest="100">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#26216B" Offset="0.0" />
                            <GradientStop Color="#102A55" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="34,*,74" ColumnSpacing="10" FlowDirection="LeftToRight">
                        <Label Grid.Column="0" Text="›" FontSize="30" TextColor="#B7C8FF"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"
                                             FlowDirection="RightToLeft">
                            <Label x:Name="AccountNameSummaryLabel" Text="حسابك في Himo"
                                   FontSize="17" FontAttributes="Bold" TextColor="#F3F6FF"
                                   HorizontalTextAlignment="End" />
                            <Label x:Name="AccountEmailSummaryLabel" Text=""
                                   FontSize="12" TextColor="#A9B9E2" HorizontalTextAlignment="End" />
                            <Label x:Name="AccountLoadStatusLabel" Text="بيانات حسابك محفوظة بأمان"
                                   FontSize="10.5" TextColor="#C7D8FF" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="68" HeightRequest="68" BackgroundColor="#423FC0"
                                Stroke="#7778FF" StrokeThickness="1.2" HorizontalOptions="End" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="34" /></Border.StrokeShape>
                            <Label Text="👤" FontSize="35" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Label Text="المعلومات الشخصية" FontSize="14" FontAttributes="Bold"
                       TextColor="#F0F3FF" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="#101D3D" Stroke="#263B6B" StrokeThickness="1" Padding="8,2">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenUsernamePage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="#AFC1FF" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="اسم المستخدم" FontSize="15" FontAttributes="Bold" TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="تغيير الاسم الظاهر في Himo" FontSize="11" TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="#6038C7" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="👤" FontSize="21" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#26365F" Margin="4,0" />
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenPhonePage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="#AFC1FF" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="رقم الهاتف" FontSize="15" FontAttributes="Bold" TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="رمز الدولة والخصوصية المرتبطة بالرقم" FontSize="11" TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="#008D83" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="☎" FontSize="22" TextColor="White" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="الدخول والأمان" FontSize="14" FontAttributes="Bold"
                       TextColor="#F0F3FF" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="#101D3D" Stroke="#263B6B" StrokeThickness="1" Padding="8,2">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenLoginDetailsPage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="#AFC1FF" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="بيانات تسجيل الدخول" FontSize="15" FontAttributes="Bold" TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="البريد الإلكتروني ومعلومات الدخول" FontSize="11" TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="#245AC7" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="✉" FontSize="21" TextColor="White" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#26365F" Margin="4,0" />
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenPasswordPage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="#AFC1FF" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="كلمة المرور" FontSize="15" FontAttributes="Bold" TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="تغيير كلمة المرور برمز تحقق آمن" FontSize="11" TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="#6038C7" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="🔒" FontSize="21" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#26365F" Margin="4,0" />
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenAddAccountPage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="#AFC1FF" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="إضافة حساب" FontSize="15" FontAttributes="Bold" TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="فتح صفحة تسجيل الدخول بحساب آخر" FontSize="11" TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="#245AC7" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="＋" FontSize="25" TextColor="White" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="اضغط على أي خيار لفتح صفحته الخاصة. لا يتم تغيير أي بيانات قبل تأكيد الحفظ."
                       FontSize="10.5" TextColor="#7F92BF" HorizontalTextAlignment="Center" Margin="4,2,4,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
