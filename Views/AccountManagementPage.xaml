<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.AccountManagementPage"
             Title="إدارة الحساب"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.RowSpan="2" WidthRequest="300" HeightRequest="300"
                HorizontalOptions="Start" VerticalOptions="End"
                TranslationX="-190" TranslationY="120" BackgroundColor="{DynamicResource HimoAccent}"
                Opacity="0.08" StrokeThickness="0" InputTransparent="True" ZIndex="-1">
            <Border.StrokeShape><RoundRectangle CornerRadius="150" /></Border.StrokeShape>
        </Border>
        <Grid Grid.Row="0" Padding="18,12,18,10" ColumnDefinitions="48,*,48"
              ColumnSpacing="8" FlowDirection="LeftToRight">
            <Button Grid.Column="0" Text="‹" HeightRequest="42" WidthRequest="42" Padding="0"
                    FontSize="34" FontAttributes="Bold" BackgroundColor="{DynamicResource HimoSoft}"
                    TextColor="{DynamicResource HimoPrimary}" BorderColor="{DynamicResource HimoBorder}" BorderWidth="1" CornerRadius="15"
                    Clicked="BackClicked" HorizontalOptions="Start" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End"
                                 VerticalOptions="Center" FlowDirection="RightToLeft">
                <Label Text="إدارة الحساب" FontSize="24" FontAttributes="Bold"
                       TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="End" />
                <Label Text="كل معلومة في صفحة مستقلة" FontSize="12"
                       TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
            <BoxView Grid.Column="2" WidthRequest="42" HeightRequest="42" Opacity="0" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,8,16,30" Spacing="15">
                <Border Stroke="{DynamicResource HimoBorder}" StrokeThickness="1.2" Padding="15" MinimumHeightRequest="100">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EDE1FF" Offset="0.0" />
                            <GradientStop Color="#FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="34,*,74" ColumnSpacing="10" FlowDirection="LeftToRight">
                        <Label Grid.Column="0" Text="›" FontSize="30" TextColor="{DynamicResource HimoPrimary}"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"
                                             FlowDirection="RightToLeft">
                            <Label x:Name="AccountNameSummaryLabel" Text="حسابك في Himo"
                                   FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}"
                                   HorizontalTextAlignment="End" />
                            <Label x:Name="AccountEmailSummaryLabel" Text=""
                                   FontSize="12" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
                            <Label x:Name="AccountLoadStatusLabel" Text="بيانات حسابك محفوظة بأمان"
                                   FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="68" HeightRequest="68" BackgroundColor="{DynamicResource HimoSoft}"
                                Stroke="{DynamicResource HimoAccent}" StrokeThickness="1.2" HorizontalOptions="End" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="34" /></Border.StrokeShape>
                            <Grid WidthRequest="68" HeightRequest="68">
                                <Image x:Name="AccountProfilePhotoImage"
                                       WidthRequest="68" HeightRequest="68"
                                       Aspect="AspectFill"
                                       IsVisible="False">
                                    <Image.Clip>
                                        <EllipseGeometry Center="34,34" RadiusX="34" RadiusY="34" />
                                    </Image.Clip>
                                </Image>
                                <Image x:Name="AccountPhotoPlaceholderLabel"
                                       Source="settings_icon_user.png"
                                       WidthRequest="38" HeightRequest="38"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Label Text="المعلومات الشخصية" FontSize="14" FontAttributes="Bold"
                       TextColor="{DynamicResource HimoPrimary}" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="8,2">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenUsernamePage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="{DynamicResource HimoTextSecondary}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="اسم المستخدم" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="End" />
                                <Label Text="تغيير الاسم الظاهر في Himo" FontSize="11" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{DynamicResource HimoSoft}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Image Source="settings_icon_user.png" WidthRequest="25" HeightRequest="25" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource HimoSurface}" Margin="4,0" />
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenPhonePage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="{DynamicResource HimoTextSecondary}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="رقم الهاتف" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="End" />
                                <Label Text="رمز الدولة والخصوصية المرتبطة بالرقم" FontSize="11" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{DynamicResource HimoSoft}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Image Source="settings_icon_phone.png" WidthRequest="25" HeightRequest="25" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="الدخول والأمان" FontSize="14" FontAttributes="Bold"
                       TextColor="{DynamicResource HimoPrimary}" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="8,2">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenLoginDetailsPage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="{DynamicResource HimoTextSecondary}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="بيانات تسجيل الدخول" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="End" />
                                <Label Text="البريد الإلكتروني ومعلومات الدخول" FontSize="11" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{DynamicResource HimoSoft}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Image Source="settings_icon_mail.png" WidthRequest="25" HeightRequest="25" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource HimoSurface}" Margin="4,0" />
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenPasswordPage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="{DynamicResource HimoTextSecondary}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="كلمة المرور" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="End" />
                                <Label Text="تغيير كلمة المرور برمز تحقق آمن" FontSize="11" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{DynamicResource HimoSoft}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Image Source="settings_icon_lock.png" WidthRequest="25" HeightRequest="25" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource HimoSurface}" Margin="4,0" />
                        <Grid HeightRequest="78" ColumnDefinitions="42,*,54" ColumnSpacing="10" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OpenAddAccountPage" /></Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="‹" FontSize="30" TextColor="{DynamicResource HimoTextSecondary}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                                <Label Text="إضافة حساب" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="End" />
                                <Label Text="فتح صفحة تسجيل الدخول بحساب آخر" FontSize="11" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{DynamicResource HimoSoft}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Image Source="settings_icon_plus.png" WidthRequest="25" HeightRequest="25" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="اضغط على أي خيار لفتح صفحته الخاصة. لا يتم تغيير أي بيانات قبل تأكيد الحفظ."
                       FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" Margin="4,2,4,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
