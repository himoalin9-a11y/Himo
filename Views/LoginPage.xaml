<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.LoginPage"
             Title="Himo"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource LoginBackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Himo login palette -->
            <Color x:Key="LoginBackgroundColor">#09071A</Color>
            <Color x:Key="LoginPrimaryPurple">#7C3AED</Color>
            <Color x:Key="LoginSecondaryPurple">#5B21B6</Color>
            <Color x:Key="LoginLightPurple">#C4B5FD</Color>
            <Color x:Key="LoginTextColor">#FFFFFF</Color>
            <Color x:Key="LoginSecondaryTextColor">#C4B5FD</Color>
            <Color x:Key="LoginInputBackground">#15122B</Color>
            <Color x:Key="LoginBorderColor">#51438F</Color>

            <LinearGradientBrush x:Key="LoginBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#09071A" Offset="0" />
                <GradientStop Color="#0D0A24" Offset="0.52" />
                <GradientStop Color="#160B35" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="LoginButtonBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#7C3AED" Offset="0" />
                <GradientStop Color="#6D28D9" Offset="0.5" />
                <GradientStop Color="#5B21B6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9B5CFF" Offset="0" />
                <GradientStop Color="#7C3AED" Offset="0.52" />
                <GradientStop Color="#5B21B6" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="LoginInputBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource LoginInputBackground}" />
                <Setter Property="Stroke" Value="{StaticResource LoginBorderColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="LoginFieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource LoginSecondaryTextColor}" />
                <Setter Property="Margin" Value="4,2,4,6" />
            </Style>

            <Style x:Key="LoginSecondaryButtonStyle" TargetType="Button">
                <Setter Property="HeightRequest" Value="62" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{StaticResource LoginBorderColor}" />
                <Setter Property="BorderWidth" Value="1.2" />
                <Setter Property="TextColor" Value="{StaticResource LoginTextColor}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Background="{StaticResource LoginBackgroundBrush}">
        <!-- Soft top glow -->
        <Border WidthRequest="330" HeightRequest="330"
                HorizontalOptions="Start" VerticalOptions="Start"
                TranslationX="-185" TranslationY="-195"
                BackgroundColor="#4C1D95" Opacity="0.24" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="165" />
            </Border.StrokeShape>
        </Border>
        <Border WidthRequest="230" HeightRequest="230"
                HorizontalOptions="End" VerticalOptions="Start"
                TranslationX="125" TranslationY="-125"
                BackgroundColor="#7C3AED" Opacity="0.08" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="115" />
            </Border.StrokeShape>
        </Border>

        <ScrollView x:Name="LoginScroll"
                    VerticalScrollBarVisibility="Never"
                    >
            <Grid Padding="20,30,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>

                <!-- Header / brand -->
                <VerticalStackLayout Grid.Row="0"
                                     HorizontalOptions="Center"
                                     Spacing="0"
                                     Margin="0,0,0,24">
                    <Border WidthRequest="104" HeightRequest="104"
                            HorizontalOptions="Center"
                            Background="{StaticResource LogoBrush}"
                            Stroke="#A78BFA"
                            StrokeThickness="1.2"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#7C3AED" Offset="0,7" Radius="26" Opacity="0.55" />
                        </Border.Shadow>
                        <Grid>
                            <Border WidthRequest="78" HeightRequest="66"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    BackgroundColor="#FFFFFF"
                                    StrokeThickness="0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Label Text="H"
                                           FontSize="43"
                                           FontAttributes="Bold"
                                           TextColor="#6D28D9"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           Margin="0,-2,0,0" />
                                    <BoxView WidthRequest="22" HeightRequest="10"
                                             BackgroundColor="#FFFFFF"
                                             HorizontalOptions="Start"
                                             VerticalOptions="End"
                                             TranslationX="7"
                                             TranslationY="5"
                                             Rotation="-18" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Label Text="Himo"
                           FontSize="38"
                           FontAttributes="Bold"
                           TextColor="{StaticResource LoginTextColor}"
                           HorizontalTextAlignment="Center"
                           Margin="0,9,0,1" />

                    <Label Text="تواصل أسهل .. أقرب إليك"
                           FontSize="18"
                           TextColor="{StaticResource LoginLightPurple}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Form -->
                <VerticalStackLayout Grid.Row="1" Spacing="0">
                    <Label Text="البريد الإلكتروني" Style="{StaticResource LoginFieldLabelStyle}" />
                    <Border x:Name="EmailBorder" Style="{StaticResource LoginInputBorderStyle}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="8"
                              FlowDirection="LeftToRight">
                            <Image Grid.Column="0"
                                   Source="himo_phase1_icon_mail.png"
                                   WidthRequest="26"
                                   HeightRequest="26"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="EmailEntry"
                                   Grid.Column="1"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   Placeholder="البريد الإلكتروني"
                                   ClearButtonVisibility="WhileEditing"
                                   FontSize="18"
                                   TextColor="{StaticResource LoginTextColor}"
                                   PlaceholderColor="#8F86AD"
                                   FlowDirection="RightToLeft"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label x:Name="NameLabel"
                           Text="الاسم"
                           Style="{StaticResource LoginFieldLabelStyle}"
                           IsVisible="False" />
                    <Border x:Name="NameBorder"
                            Style="{StaticResource LoginInputBorderStyle}"
                            IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="8"
                              FlowDirection="LeftToRight">
                            <Image Grid.Column="0"
                                   Source="himo_phase1_icon_user.png"
                                   WidthRequest="26"
                                   HeightRequest="26"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="NameEntry"
                                   Grid.Column="1"
                                   Placeholder="اسمك في Himo"
                                   ReturnType="Next"
                                   MaxLength="60"
                                   FontSize="18"
                                   TextColor="{StaticResource LoginTextColor}"
                                   PlaceholderColor="#8F86AD"
                                   FlowDirection="RightToLeft"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label x:Name="VerificationLabel"
                           Text="رمز التحقق"
                           Style="{StaticResource LoginFieldLabelStyle}"
                           IsVisible="False" />
                    <Border x:Name="VerificationBorder"
                            Style="{StaticResource LoginInputBorderStyle}"
                            IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="8"
                              FlowDirection="LeftToRight">
                            <Image Grid.Column="0"
                                   Source="himo_phase1_icon_shield.png"
                                   WidthRequest="25"
                                   HeightRequest="25"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="VerificationCodeEntry"
                                   Grid.Column="1"
                                   Keyboard="Numeric"
                                   Placeholder="رمز التحقق المكوّن من 6 أرقام"
                                   MaxLength="6"
                                   FontSize="17"
                                   TextColor="{StaticResource LoginTextColor}"
                                   PlaceholderColor="#8F86AD"
                                   FlowDirection="RightToLeft"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Button x:Name="ResendButton"
                            Text="إعادة إرسال رمز التحقق"
                            Style="{StaticResource LoginSecondaryButtonStyle}"
                            Clicked="ResendClicked"
                            IsVisible="False"
                            Margin="0,0,0,10" />

                    <Label Text="كلمة المرور" Style="{StaticResource LoginFieldLabelStyle}" />
                    <Border x:Name="PasswordBorder"
                            Style="{StaticResource LoginInputBorderStyle}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="42,*,54"
                              ColumnSpacing="5"
                              FlowDirection="LeftToRight">
                            <Image Grid.Column="0"
                                   Source="himo_phase1_icon_lock.png"
                                   WidthRequest="25"
                                   HeightRequest="25"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="1"
                                   IsPassword="True"
                                   Placeholder="كلمة المرور"
                                   ReturnType="Done"
                                   MaxLength="128"
                                   FontSize="18"
                                   TextColor="{StaticResource LoginTextColor}"
                                   PlaceholderColor="#8F86AD"
                                   FlowDirection="RightToLeft"
                                   VerticalOptions="Center" />
                            <ImageButton x:Name="PasswordEyeButton"
                                         Grid.Column="2"
                                         Source="eye_open.png"
                                         BackgroundColor="Transparent"
                                         Padding="11"
                                         WidthRequest="50"
                                         HeightRequest="50"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Clicked="TogglePasswordClicked" />
                        </Grid>
                    </Border>

                    <Button x:Name="PrimaryButton"
                            Text="تسجيل الدخول"
                            HeightRequest="68"
                            CornerRadius="32"
                            Background="{StaticResource LoginButtonBrush}"
                            TextColor="{StaticResource LoginTextColor}"
                            FontSize="20"
                            FontAttributes="Bold"
                            ImageSource="himo_phase1_icon_login.png"
                            ContentLayout="Left,10"
                            Clicked="PrimaryClicked"
                            Margin="0,6,0,4">
                        <Button.Shadow>
                            <Shadow Brush="#7C3AED" Offset="0,8" Radius="18" Opacity="0.38" />
                        </Button.Shadow>
                    </Button>

                    <Button x:Name="ForgotPasswordButton"
                            Text="نسيت كلمة المرور؟"
                            HeightRequest="44"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource LoginLightPurple}"
                            FontSize="17"
                            FontAttributes="Bold"
                            Clicked="ForgotPasswordClicked"
                            HorizontalOptions="Center"
                            Margin="0,1,0,9" />

                    <Grid ColumnDefinitions="*,Auto,*"
                          ColumnSpacing="14"
                          Margin="2,0,2,14">
                        <BoxView Grid.Column="0"
                                 HeightRequest="1"
                                 BackgroundColor="#30265C"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="أو"
                               FontSize="15"
                               TextColor="{StaticResource LoginLightPurple}"
                               VerticalOptions="Center" />
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 BackgroundColor="#30265C"
                                 VerticalOptions="Center" />
                    </Grid>

                    <Button x:Name="ModeButton"
                            Text="إنشاء حساب جديد"
                            Style="{StaticResource LoginSecondaryButtonStyle}"
                            Clicked="ModeClicked"
                            ImageSource="himo_phase1_icon_user.png"
                            ContentLayout="Left,10"
                            Margin="0,0,0,6" />

                    <ActivityIndicator x:Name="BusyIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       HorizontalOptions="Center"
                                       WidthRequest="28"
                                       HeightRequest="28"
                                       Color="{StaticResource LoginLightPurple}"
                                       Margin="0,2,0,0" />
                    <Label x:Name="StatusLabel"
                           FontSize="12"
                           TextColor="{StaticResource LoginSecondaryTextColor}"
                           HorizontalTextAlignment="Center"
                           Margin="8,4,8,0" />
                </VerticalStackLayout>

                <!-- The wave asset sits behind the final content area and scales with width. -->
                <Image Grid.Row="2"
                       Source="himo_phase1_login_waves.png"
                       Aspect="Fill"
                       HorizontalOptions="Fill"
                       VerticalOptions="End"
                       Margin="-20,0,-20,-24"
                       InputTransparent="True" />
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
