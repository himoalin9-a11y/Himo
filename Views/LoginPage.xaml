<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.LoginPage"
             Title="Himo"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#050A24">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="LoginInputBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#0A1535" />
                <Setter Property="Stroke" Value="#293E7D" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,0,13" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#050A24">
        <!-- Lightweight decorative shapes; these stay behind the scrollable form. -->
        <Border WidthRequest="255" HeightRequest="255" BackgroundColor="#20105D" Opacity="0.70"
                HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-142" TranslationY="-132"
                StrokeThickness="0" InputTransparent="True">
            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
        </Border>
        <Border WidthRequest="205" HeightRequest="205" BackgroundColor="#111B57" Opacity="0.62"
                HorizontalOptions="End" VerticalOptions="Start" TranslationX="105" TranslationY="18"
                StrokeThickness="0" InputTransparent="True">
            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
        </Border>
        <Border WidthRequest="560" HeightRequest="178" BackgroundColor="#24106E" Opacity="0.66"
                HorizontalOptions="End" VerticalOptions="End" TranslationX="150" TranslationY="82"
                StrokeThickness="0" InputTransparent="True">
            <Border.StrokeShape><RoundRectangle CornerRadius="150" /></Border.StrokeShape>
        </Border>
        <Border WidthRequest="520" HeightRequest="138" BackgroundColor="#101B58" Opacity="0.80"
                HorizontalOptions="Start" VerticalOptions="End" TranslationX="-158" TranslationY="103"
                StrokeThickness="0" InputTransparent="True">
            <Border.StrokeShape><RoundRectangle CornerRadius="120" /></Border.StrokeShape>
        </Border>

        <ScrollView x:Name="LoginScroll" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,27,24,30" Spacing="0">
                <!-- Himo wordmark and custom H mark, matching the approved mockup. -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalOptions="Center"
                      FlowDirection="LeftToRight" Margin="0,7,0,34">
                    <Border Grid.Column="0" WidthRequest="58" HeightRequest="58" Padding="0"
                            BackgroundColor="#120E3D" Stroke="#5E3CC5" StrokeThickness="1"
                            VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                        <Grid>
                            <Border WidthRequest="10" HeightRequest="34" Background="{DynamicResource HimoAccentGradient}"
                                    HorizontalOptions="Start" VerticalOptions="Center" TranslationX="14" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            </Border>
                            <Border WidthRequest="10" HeightRequest="34" Background="{DynamicResource HimoAccentGradient}"
                                    HorizontalOptions="End" VerticalOptions="Center" TranslationX="-14" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            </Border>
                            <Border WidthRequest="29" HeightRequest="10" Background="{DynamicResource HimoAccentGradient}"
                                    HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            </Border>
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label FontSize="37" FontAttributes="Bold" HorizontalTextAlignment="Start" LineBreakMode="NoWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="H" TextColor="#F8FAFF" />
                                    <Span Text="i" TextColor="#A56BFF" />
                                    <Span Text="mo" TextColor="#F8FAFF" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="معك في كل خطوة" FontSize="13" TextColor="#C1A5FF"
                               HorizontalTextAlignment="Start" Margin="2,0,0,0" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="7" Margin="0,0,0,24">
                    <Label Text="مرحبًا بعودتك" FontSize="28" FontAttributes="Bold"
                           TextColor="#F8FAFF" HorizontalTextAlignment="Center" />
                    <Label Text="سجّل الدخول إلى حسابك للمتابعة" FontSize="14"
                           TextColor="#AEBBE6" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Padding="17,19" BackgroundColor="#B20B1535" Stroke="#253A7B" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="27" /></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#4E2CC9" Offset="0,7" Radius="20" Opacity="0.12" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">
                        <Border x:Name="EmailBorder" Style="{StaticResource LoginInputBorderStyle}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="42,*" ColumnSpacing="8" FlowDirection="LeftToRight">
                                <Image Grid.Column="0" Source="himo_pro_ui_himo_login_icon_mail.png"
                                       WidthRequest="23" HeightRequest="23" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                                <Entry x:Name="EmailEntry" Grid.Column="1" Keyboard="Email" ReturnType="Next"
                                       Completed="EmailCompleted" Placeholder="البريد الإلكتروني"
                                       ClearButtonVisibility="WhileEditing" MaxLength="254" FontSize="15"
                                       TextColor="#F8FAFF" PlaceholderColor="#8392C5" BackgroundColor="Transparent"
                                       HorizontalTextAlignment="End" FlowDirection="RightToLeft" VerticalOptions="Center"
                                       Focused="InputFocused" Unfocused="InputUnfocused" />
                            </Grid>
                        </Border>

                        <Border x:Name="PasswordBorder" Style="{StaticResource LoginInputBorderStyle}" Margin="0,0,0,5">
                            <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="42,*,38" ColumnSpacing="3" FlowDirection="LeftToRight">
                                <ImageButton x:Name="PasswordEyeButton" Grid.Column="0"
                                             Source="himo_pro_ui_himo_login_eye_open.png" BackgroundColor="Transparent"
                                             Padding="10" WidthRequest="40" HeightRequest="44"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Clicked="TogglePasswordClicked"
                                             SemanticProperties.Description="إظهار أو إخفاء كلمة المرور" />
                                <Entry x:Name="PasswordEntry" Grid.Column="1" IsPassword="True"
                                       Placeholder="كلمة المرور" ReturnType="Done" Completed="PasswordCompleted"
                                       MaxLength="128" FontSize="15" TextColor="#F8FAFF" PlaceholderColor="#8392C5"
                                       BackgroundColor="Transparent" HorizontalTextAlignment="End"
                                       FlowDirection="RightToLeft" VerticalOptions="Center"
                                       Focused="InputFocused" Unfocused="InputUnfocused" />
                                <Image Grid.Column="2" Source="himo_pro_ui_himo_login_icon_lock.png"
                                       WidthRequest="21" HeightRequest="21" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Border>

                        <Button x:Name="ForgotPasswordButton" Text="نسيت كلمة المرور؟"
                                Clicked="ForgotPasswordClicked" BackgroundColor="Transparent"
                                TextColor="#B58AFF" FontSize="13" FontAttributes="Bold"
                                Padding="4,2" HeightRequest="36" HorizontalOptions="End"
                                BorderWidth="0" />

                        <Label x:Name="StatusLabel" Text="" FontSize="12" TextColor="#C1A5FF"
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="0,3,0,5" />
                        <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False"
                                           Color="#B58AFF" HorizontalOptions="Center" WidthRequest="28" HeightRequest="28" />

                        <Button x:Name="PrimaryButton" Text="تسجيل الدخول   ←"
                                HeightRequest="58" CornerRadius="19" Background="{DynamicResource HimoAccentGradient}"
                                TextColor="#FFFFFF" FontSize="17" FontAttributes="Bold"
                                Clicked="PrimaryClicked" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="13" Margin="0,22,0,13">
                    <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="#2A3C78" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="أو" FontSize="13" TextColor="#9EACD7"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#2A3C78" VerticalOptions="Center" />
                </Grid>

                <Label x:Name="ModePromptLabel" Text="ليس لديك حساب؟" FontSize="14"
                       TextColor="#B7C1E7" HorizontalTextAlignment="Center" Margin="0,0,0,9" />
                <Button x:Name="ModeButton" Text="إنشاء حساب جديد   ←" Clicked="ModeClicked"
                        HeightRequest="54" CornerRadius="19" BackgroundColor="#080F2D"
                        BorderColor="#8B52FF" BorderWidth="1.4" TextColor="#DCC8FF"
                        FontSize="15" FontAttributes="Bold" />

                <Label Text="بمتابعة استخدامك للتطبيق، فإنك توافق على شروط الاستخدام وسياسة الخصوصية"
                       FontSize="10" TextColor="#7382B3" HorizontalTextAlignment="Center"
                       Margin="14,22,14,0" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
