<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             x:Class="Himo.Views.CreateGroupPage"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,10,16,18" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="48,*,48">
            <Button Grid.Column="0" Text="‹" Style="{StaticResource HimoBackButton}" Clicked="BackClicked" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                <Label Text="إنشاء مجموعة" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Center" />
                <Label Text="ابدأ محادثة جماعية مع أصدقائك" FontSize="12" TextColor="{DynamicResource HimoMuted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Border Grid.Row="1" Padding="14,3" Style="{StaticResource HimoInputBorder}">
            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
            <Entry x:Name="GroupNameEntry" Placeholder="اسم المجموعة" MaxLength="60" FontSize="16" ReturnType="Next" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" Padding="12,2" Style="{StaticResource HimoInputBorder}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Entry x:Name="MemberLookupEntry" Placeholder="البريد الإلكتروني أو رقم الهاتف" FontSize="14" Keyboard="Text" ReturnType="Search" Completed="MemberLookupCompleted" ClearButtonVisibility="WhileEditing" />
            </Border>
            <Button Grid.Column="1" x:Name="FindMemberButton" Text="إضافة" Style="{StaticResource HimoOutlineButton}" Clicked="FindMemberClicked" />
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Text="أعضاء المجموعة" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" VerticalTextAlignment="Center" />
                <Border Grid.Column="1" Padding="10,4" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Label x:Name="MembersCountLabel" Text="0 عضو" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource HimoAccent}" />
                </Border>
            </Grid>
            <CollectionView Grid.Row="1" x:Name="MembersView" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="22">
                        <Label Text="👥" FontSize="42" HorizontalTextAlignment="Center" />
                        <Label Text="أضف أعضاء إلى مجموعتك" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Center" />
                        <Label Text="اكتب البريد الإلكتروني أو رقم الهاتف المسجل في Himo، ثم اضغط إضافة." FontSize="12" TextColor="{DynamicResource HimoMuted}" HorizontalTextAlignment="Center" MaximumWidthRequest="300" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GroupMemberDraft">
                        <Border Margin="0,4" Padding="12" Style="{StaticResource HimoListCard}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="46" HeightRequest="46" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                                    <Label Text="{Binding Initial}" FontAttributes="Bold" FontSize="18" TextColor="{DynamicResource HimoAccent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                                    <Label Text="{Binding Email}" FontSize="11" TextColor="{DynamicResource HimoMuted}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="إزالة" Style="{StaticResource HimoPillButton}" Clicked="RemoveMemberClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="8">
            <ActivityIndicator x:Name="GroupBusyIndicator" IsVisible="False" IsRunning="False" Color="{DynamicResource HimoAccent}" HorizontalOptions="Center" />
            <Button Grid.Row="1" x:Name="CreateGroupButton" Text="إنشاء المجموعة" Style="{StaticResource HimoActionButton}" Clicked="CreateClicked" />
        </Grid>
    </Grid>
</ContentPage>
