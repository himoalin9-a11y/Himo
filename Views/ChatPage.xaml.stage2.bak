<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             x:Class="Himo.Views.ChatPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F3FA"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="TextColor" Value="#6427C7" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="42" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Opacity" Value="0.96" />
        </Style>

        <Style x:Key="MetaTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextColor" Value="#91879E" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F6F3FA">

        <!-- STAGE 2: compact premium conversation header -->
        <Border Grid.Row="0" Margin="0" Padding="14,10,14,12"
                BackgroundColor="#6427C7" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,24,24" />
            </Border.StrokeShape>

            <Grid RowDefinitions="44,Auto" RowSpacing="5">
                <Grid Grid.Row="0" ColumnDefinitions="48,*,48">
                    <Button Grid.Column="0" Text="‹" Style="{StaticResource HeaderIconButtonStyle}"
                            Clicked="BackClicked"
                            SemanticProperties.Description="العودة إلى المحادثات" />

                    <Button Grid.Column="2" Text="⋮" Style="{StaticResource HeaderIconButtonStyle}"
                            FontSize="25" SemanticProperties.Description="خيارات المحادثة" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="48,Auto,Auto,48" ColumnSpacing="10"
                      HorizontalOptions="Center" HeightRequest="66">
                    <Grid Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="62" HeightRequest="62"
                                BackgroundColor="#F6EEFF" Stroke="#FFFFFF" StrokeThickness="2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="31" /></Border.StrokeShape>
                            <Label x:Name="InitialLabel" Text="H" FontSize="25" FontAttributes="Bold"
                                   TextColor="#6427C7" HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                    </Grid>

                    <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                        <Label x:Name="NameLabel" Text="محادثة" FontSize="17" FontAttributes="Bold"
                               TextColor="White" MaxLines="1" LineBreakMode="TailTruncation"
                               WidthRequest="150" />
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                     Color="#49D486" VerticalOptions="Center" />
                            <Label Text="متصل الآن" FontSize="12" TextColor="#EDE3FF" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <!-- STAGE 2: clean message surface -->
        <Grid Grid.Row="1" Padding="10,10,10,6">
            <CollectionView x:Name="Messages" SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Padding="3,3">
                            <Border Padding="11,9" MaximumWidthRequest="326"
                                    HorizontalOptions="End"
                                    BackgroundColor="#FFFFFF" Stroke="#E8E1EF" StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>

                                <VerticalStackLayout Spacing="7">
                                    <!-- Image preview: shown only when a real local file exists. -->
                                    <Border IsVisible="{Binding HasLocalImagePreview}"
                                            HeightRequest="176" MaximumWidthRequest="296"
                                            StrokeThickness="0" BackgroundColor="#EDE8F5">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                        <Image Source="{Binding AttachmentLocalPath}" Aspect="AspectFill"
                                               SemanticProperties.Description="معاينة الصورة المرفقة" />
                                    </Border>

                                    <!-- Compact attachment card. -->
                                    <Border IsVisible="{Binding IsAttachment}" Padding="8"
                                            BackgroundColor="#F8F5FB" Stroke="#E7DEEF" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="9">
                                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                                    BackgroundColor="#E9DDF8" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                                <Label Text="📎" FontSize="16" HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="مرفق" FontSize="9" TextColor="#91879E" />
                                                <Label Text="{Binding AttachmentFileName}" FontSize="12" FontAttributes="Bold"
                                                       TextColor="#332740" MaxLines="2" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2" Text="فتح" FontSize="10" FontAttributes="Bold"
                                                    Padding="11,0" HeightRequest="30" BackgroundColor="#6427C7"
                                                    TextColor="White" CornerRadius="15" Clicked="AttachmentClicked"
                                                    SemanticProperties.Description="فتح المرفق" />
                                        </Grid>
                                    </Border>

                                    <Label x:Name="MessageTextLabel" Text="{Binding Text}" FontSize="16" LineHeight="1.12"
                                           TextColor="#30283A" LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasLocalImagePreview}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <HorizontalStackLayout Spacing="5" IsVisible="{Binding IsAudioAttachment}">
                                        <Button Text="▶  تشغيل الصوت" FontSize="12" Padding="11,2"
                                                HeightRequest="31" BackgroundColor="#F0EBF7"
                                                TextColor="#6427C7" CornerRadius="15"
                                                Clicked="AudioClicked" SemanticProperties.Description="تشغيل الرسالة الصوتية">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#8050DB" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </HorizontalStackLayout>

                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                                        <Label Grid.Column="0" Text="{Binding SentAt, StringFormat='{0:HH:mm}'}"
                                               Style="{StaticResource MetaTextStyle}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="TextColor" Value="#E9DDFF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </VerticalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="Margin" Value="38,0,0,0" />
                                        <Setter Property="BackgroundColor" Value="#6D35D5" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout x:Name="EmptyState" IsVisible="False"
                                 HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="28">
                <Border WidthRequest="64" HeightRequest="64" BackgroundColor="#EAE0F7" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="32" /></Border.StrokeShape>
                    <Label Text="💬" FontSize="27" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Text="لا توجد رسائل بعد" FontSize="18" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="#30283A" />
                <Label Text="ابدأ المحادثة بإرسال أول رسالة" FontSize="13"
                       HorizontalTextAlignment="Center" TextColor="#8D8496" />
            </VerticalStackLayout>
        </Grid>

        <!-- STAGE 2: refined message composer -->
        <Border Grid.Row="2" Margin="10,3,10,10" Padding="4"
                BackgroundColor="#FFFFFF" Stroke="#DED6E7" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Grid ColumnDefinitions="50,*,44" ColumnSpacing="2" HeightRequest="58">
                <Button x:Name="RecordButton" Grid.Column="0" Text="🎙" FontSize="17"
                        WidthRequest="44" HeightRequest="44" Padding="0"
                        BackgroundColor="#EFE8FA" TextColor="#6427C7" CornerRadius="22"
                        Clicked="RecordAudioClicked" SemanticProperties.Description="تسجيل رسالة صوتية أو إيقاف التسجيل"
                        HorizontalOptions="Center" VerticalOptions="Center" />

                <Grid Grid.Column="1" ColumnDefinitions="*,38" VerticalOptions="Fill">
                    <Entry x:Name="MessageEntry" Grid.Column="0" Placeholder="اكتب رسالتك..."
                           ReturnType="Send" ClearButtonVisibility="WhileEditing" MaxLength="4000"
                           Completed="SendClicked" FontSize="16" TextColor="#30283A"
                           PlaceholderColor="#A39AAA" VerticalOptions="Center"
                           HorizontalTextAlignment="Start" />
                    <Button Grid.Column="1" Text="📎" FontSize="19" WidthRequest="36" HeightRequest="36"
                            Padding="0" BackgroundColor="Transparent" TextColor="#687384"
                            Clicked="AttachmentButtonClicked" SemanticProperties.Description="إضافة صورة أو ملف"
                            VerticalOptions="Center" />
                </Grid>

                <Button x:Name="SendButton" Grid.Column="2" Text="➤" FontSize="21" FontAttributes="Bold"
                        WidthRequest="48" HeightRequest="48" Padding="0"
                        BackgroundColor="#6427C7" TextColor="White" CornerRadius="24"
                        Clicked="SendClicked" SemanticProperties.Description="إرسال الرسالة"
                        HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
