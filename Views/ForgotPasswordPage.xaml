<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.ForgotPasswordPage"
             Title="استعادة كلمة المرور"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource HimoBackground}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ResetFieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="Margin" Value="3,0,3,7" />
            </Style>
            <Style x:Key="ResetInputBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoInput}" />
                <Setter Property="Stroke" Value="{DynamicResource HimoBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style x:Key="ResetSecondaryButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BackgroundColor" Value="{DynamicResource HimoCard}" />
                <Setter Property="BorderColor" Value="{DynamicResource HimoBorder}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="TextColor" Value="{DynamicResource HimoPrimary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Background="{DynamicResource HimoBackgroundGradient}">
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="22,16,22,28" Spacing="0">
                <Grid ColumnDefinitions="48,*" ColumnSpacing="12" FlowDirection="LeftToRight" Margin="0,0,0,22">
                    <ImageButton Grid.Column="0"
                                 Source="himo_pro_ui_himo_icon_arrow_back_purple.png"
                                 WidthRequest="44" HeightRequest="44"
                                 Padding="12"
                                 CornerRadius="14"
                                 BackgroundColor="{DynamicResource HimoCard}"
                                 BorderColor="{DynamicResource HimoBorder}"
                                 BorderWidth="1"
                                 Aspect="AspectFit"
                                 Clicked="BackClicked"
                                 SemanticProperties.Description="رجوع إلى تسجيل الدخول" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3" FlowDirection="RightToLeft">
                        <Label Text="استعادة كلمة المرور"
                               FontSize="23" FontAttributes="Bold"
                               TextColor="{DynamicResource HimoPrimary}"
                               HorizontalTextAlignment="Start" />
                        <Label Text="استعد الوصول إلى حسابك بخطوات آمنة"
                               FontSize="13"
                               TextColor="{DynamicResource HimoTextSecondary}"
                               HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                </Grid>

                <Border Padding="22" BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Border WidthRequest="76" HeightRequest="76" Padding="19"
                                HorizontalOptions="Center" Margin="0,0,0,17"
                                BackgroundColor="{DynamicResource HimoIconBackground}"
                                Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                            <Image Source="himo_pro_ui_himo_login_icon_shield.png" Aspect="AspectFit" />
                        </Border>
                        <Label Text="لنعد إلى حسابك"
                               FontSize="21" FontAttributes="Bold"
                               TextColor="{DynamicResource HimoPrimary}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="أدخل بريدك الإلكتروني، وسنرسل إليك رمزًا لإعادة تعيين كلمة المرور."
                               FontSize="13" LineHeight="1.35"
                               TextColor="{DynamicResource HimoTextSecondary}"
                               HorizontalTextAlignment="Center"
                               Margin="0,7,0,23" />

                        <Label Text="البريد الإلكتروني" Style="{StaticResource ResetFieldLabel}" />
                        <Border x:Name="EmailBorder" Style="{StaticResource ResetInputBorder}" Margin="0,0,0,13">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,42" ColumnSpacing="8" FlowDirection="LeftToRight">
                                <Entry x:Name="EmailEntry" Grid.Column="0"
                                       Placeholder="name@example.com" Keyboard="Email"
                                       MaxLength="254" ReturnType="Go" Completed="SendCodeCompleted"
                                       TextColor="{DynamicResource HimoPrimary}"
                                       PlaceholderColor="{DynamicResource HimoTextSecondary}"
                                       FlowDirection="LeftToRight" HorizontalTextAlignment="Start"
                                       VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="himo_pro_ui_himo_login_icon_mail.png"
                                       WidthRequest="22" HeightRequest="22" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Button x:Name="SendCodeButton" Text="إرسال رمز التحقق"
                                HeightRequest="50" CornerRadius="15"
                                BackgroundColor="{DynamicResource HimoAccent}"
                                TextColor="{DynamicResource HimoOnAccent}"
                                FontAttributes="Bold" FontSize="15"
                                Clicked="SendCodeClicked" />

                        <Border x:Name="ResetSection" IsVisible="False" Padding="0"
                                Margin="0,22,0,0" BackgroundColor="Transparent" StrokeThickness="0">
                            <VerticalStackLayout Spacing="0">
                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource HimoBorder}" Margin="0,0,0,19" />
                                <Label Text="إكمال الاستعادة" FontSize="17" FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoPrimary}" Margin="0,0,0,13" />
                                <Label Text="رمز التحقق (6 أرقام)" Style="{StaticResource ResetFieldLabel}" />
                                <Border Style="{StaticResource ResetInputBorder}" Margin="0,0,0,13">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                    <Entry x:Name="CodeEntry" Placeholder="أدخل الرمز المرسل إلى بريدك"
                                           Keyboard="Numeric" MaxLength="6" ReturnType="Next"
                                           TextColor="{DynamicResource HimoPrimary}"
                                           PlaceholderColor="{DynamicResource HimoTextSecondary}"
                                           HorizontalTextAlignment="Center" CharacterSpacing="4" />
                                </Border>

                                <Label Text="كلمة المرور الجديدة" Style="{StaticResource ResetFieldLabel}" />
                                <Border Style="{StaticResource ResetInputBorder}" Margin="0,0,0,13">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,44" ColumnSpacing="6" FlowDirection="LeftToRight">
                                        <Entry x:Name="NewPasswordEntry" Grid.Column="0" Placeholder="8 أحرف على الأقل"
                                               IsPassword="True" MaxLength="128" ReturnType="Next"
                                               TextColor="{DynamicResource HimoPrimary}"
                                               PlaceholderColor="{DynamicResource HimoTextSecondary}"
                                               FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                                        <ImageButton x:Name="NewPasswordEyeButton" Grid.Column="1"
                                                     Source="himo_pro_ui_himo_login_eye_open.png"
                                                     BackgroundColor="Transparent" Padding="10"
                                                     Aspect="AspectFit" Clicked="TogglePasswordClicked"
                                                     SemanticProperties.Description="إظهار أو إخفاء كلمة المرور" />
                                    </Grid>
                                </Border>

                                <Label Text="تأكيد كلمة المرور" Style="{StaticResource ResetFieldLabel}" />
                                <Border Style="{StaticResource ResetInputBorder}" Margin="0,0,0,13">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,44" ColumnSpacing="6" FlowDirection="LeftToRight">
                                        <Entry x:Name="ConfirmPasswordEntry" Grid.Column="0" Placeholder="أعد كتابة كلمة المرور"
                                               IsPassword="True" MaxLength="128" ReturnType="Done"
                                               Completed="ResetPasswordCompleted"
                                               TextColor="{DynamicResource HimoPrimary}"
                                               PlaceholderColor="{DynamicResource HimoTextSecondary}"
                                               FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                                        <ImageButton x:Name="ConfirmPasswordEyeButton" Grid.Column="1"
                                                     Source="himo_pro_ui_himo_login_eye_open.png"
                                                     BackgroundColor="Transparent" Padding="10"
                                                     Aspect="AspectFit" Clicked="TogglePasswordClicked"
                                                     SemanticProperties.Description="إظهار أو إخفاء تأكيد كلمة المرور" />
                                    </Grid>
                                </Border>
                                <Label Text="استخدم كلمة مرور جديدة لا تقل عن 8 أحرف. لا تشارك رمز التحقق مع أي شخص."
                                       FontSize="12" LineHeight="1.25"
                                       TextColor="{DynamicResource HimoTextSecondary}"
                                       Margin="2,0,2,15" />
                                <Button x:Name="ResetPasswordButton" Text="حفظ كلمة المرور الجديدة"
                                        HeightRequest="50" CornerRadius="15"
                                        BackgroundColor="{DynamicResource HimoAccent}"
                                        TextColor="{DynamicResource HimoOnAccent}"
                                        FontAttributes="Bold" FontSize="15"
                                        Clicked="ResetPasswordClicked" />
                            </VerticalStackLayout>
                        </Border>

                        <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False"
                                           Color="{DynamicResource HimoAccent}" HeightRequest="32" Margin="0,9,0,0" />
                        <Label x:Name="StatusLabel" Text="" FontSize="12" LineHeight="1.3"
                               TextColor="{DynamicResource HimoTextSecondary}"
                               HorizontalTextAlignment="Center" Margin="0,13,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="لم يصلك البريد؟ تحقق من مجلد الرسائل غير المرغوب فيها قبل طلب رمز جديد."
                       FontSize="12" LineHeight="1.3"
                       TextColor="{DynamicResource HimoTextSecondary}"
                       HorizontalTextAlignment="Center" Margin="10,18,10,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
