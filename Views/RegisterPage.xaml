<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Himo.Views.RegisterPage"
             Title="إنشاء حساب"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource HimoBackground}">

    <Grid Background="{DynamicResource HimoBackgroundGradient}">
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="22,14,22,28" Spacing="0">
                <Grid ColumnDefinitions="Auto,*" FlowDirection="RightToLeft" Margin="0,0,0,12">
                    <Button Grid.Column="0"
                            Text="رجوع"
                            Padding="13,7"
                            HeightRequest="40"
                            CornerRadius="14"
                            BackgroundColor="{DynamicResource HimoCard}"
                            BorderColor="{DynamicResource HimoBorder}"
                            BorderWidth="1"
                            TextColor="{DynamicResource HimoPrimary}"
                            FontSize="13"
                            Clicked="BackClicked"
                            SemanticProperties.Description="العودة إلى تسجيل الدخول" />
                    <Label Grid.Column="1"
                           Text="Himo"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource HimoAccent}"
                           HorizontalTextAlignment="End"
                           VerticalTextAlignment="Center" />
                </Grid>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,2,0,20">
                    <Border WidthRequest="74" HeightRequest="74"
                            BackgroundColor="{DynamicResource HimoCard}"
                            Stroke="{DynamicResource HimoBorder}"
                            StrokeThickness="1">
                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                        <Image Source="himo_pro_ui_himo_login_icon_user.png"
                               WidthRequest="34" HeightRequest="34"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="إنشاء حساب جديد"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource HimoPrimary}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="انضم إلى Himo وابدأ التواصل بسهولة"
                           FontSize="14"
                           TextColor="{DynamicResource HimoTextSecondary}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Padding="20,22"
                        BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}"
                        StrokeThickness="1">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <VerticalStackLayout x:Name="RegistrationFieldsContainer" Spacing="0">
                            <Label Text="الاسم الكامل" FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" Margin="3,0,3,7" />
                            <Border x:Name="NameBorder" HeightRequest="56" Padding="12,0"
                                    Margin="0,0,0,14"
                                    BackgroundColor="{DynamicResource HimoInput}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="8" FlowDirection="LeftToRight">
                                    <Image Grid.Column="0" Source="himo_pro_ui_himo_login_icon_user.png"
                                           WidthRequest="21" HeightRequest="21" VerticalOptions="Center" HorizontalOptions="Center" />
                                    <Entry x:Name="NameEntry" Grid.Column="1"
                                           Placeholder="اكتب اسمك كما تريد ظهوره"
                                           MaxLength="60" ReturnType="Next" Completed="NameCompleted"
                                           TextColor="{DynamicResource HimoPrimary}"
                                           PlaceholderColor="{DynamicResource HimoMuted}"
                                           BackgroundColor="Transparent" FontSize="15"
                                           HorizontalTextAlignment="End" FlowDirection="RightToLeft"
                                           Focused="InputFocused" Unfocused="InputUnfocused" />
                                </Grid>
                            </Border>

                            <Label Text="البريد الإلكتروني" FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" Margin="3,0,3,7" />
                            <Border x:Name="EmailBorder" HeightRequest="56" Padding="12,0"
                                    Margin="0,0,0,14"
                                    BackgroundColor="{DynamicResource HimoInput}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="8" FlowDirection="LeftToRight">
                                    <Image Grid.Column="0" Source="himo_pro_ui_himo_login_icon_mail.png"
                                           WidthRequest="21" HeightRequest="21" VerticalOptions="Center" HorizontalOptions="Center" />
                                    <Entry x:Name="EmailEntry" Grid.Column="1" Keyboard="Email"
                                           Placeholder="name@example.com" MaxLength="254"
                                           ReturnType="Next" Completed="EmailCompleted"
                                           ClearButtonVisibility="WhileEditing"
                                           TextColor="{DynamicResource HimoPrimary}"
                                           PlaceholderColor="{DynamicResource HimoMuted}"
                                           BackgroundColor="Transparent" FontSize="15"
                                           HorizontalTextAlignment="End" FlowDirection="LeftToRight"
                                           Focused="InputFocused" Unfocused="InputUnfocused" />
                                </Grid>
                            </Border>

                            <Label Text="رقم الهاتف (اختياري)" FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" Margin="3,0,3,7" />
                            <Border x:Name="PhoneBorder" HeightRequest="56" Padding="12,0"
                                    Margin="0,0,0,14"
                                    BackgroundColor="{DynamicResource HimoInput}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="8" FlowDirection="LeftToRight">
                                    <Image Grid.Column="0" Source="himo_pro_ui_himo_signup_icon_phone.png"
                                           WidthRequest="21" HeightRequest="21" VerticalOptions="Center" HorizontalOptions="Center" />
                                    <Entry x:Name="PhoneEntry" Grid.Column="1" Keyboard="Telephone"
                                           Placeholder="+966..." MaxLength="25"
                                           ReturnType="Next" Completed="PhoneCompleted"
                                           TextColor="{DynamicResource HimoPrimary}"
                                           PlaceholderColor="{DynamicResource HimoMuted}"
                                           BackgroundColor="Transparent" FontSize="15"
                                           HorizontalTextAlignment="End" FlowDirection="LeftToRight"
                                           Focused="InputFocused" Unfocused="InputUnfocused" />
                                </Grid>
                            </Border>

                            <Label Text="كلمة المرور" FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" Margin="3,0,3,7" />
                            <Border x:Name="PasswordBorder" HeightRequest="56" Padding="8,0"
                                    Margin="0,0,0,14"
                                    BackgroundColor="{DynamicResource HimoInput}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="42,*,42" ColumnSpacing="3" FlowDirection="LeftToRight">
                                    <ImageButton x:Name="PasswordEyeButton" Grid.Column="0"
                                                 Source="himo_pro_ui_himo_login_eye_open.png"
                                                 BackgroundColor="Transparent" Padding="10"
                                                 WidthRequest="40" HeightRequest="44"
                                                 Clicked="TogglePasswordClicked"
                                                 SemanticProperties.Description="إظهار أو إخفاء كلمة المرور" />
                                    <Entry x:Name="PasswordEntry" Grid.Column="1" IsPassword="True"
                                           Placeholder="8 أحرف على الأقل" MaxLength="128"
                                           ReturnType="Next" Completed="PasswordCompleted"
                                           TextColor="{DynamicResource HimoPrimary}"
                                           PlaceholderColor="{DynamicResource HimoMuted}"
                                           BackgroundColor="Transparent" FontSize="15"
                                           HorizontalTextAlignment="End" FlowDirection="RightToLeft"
                                           Focused="InputFocused" Unfocused="InputUnfocused" />
                                    <Image Grid.Column="2" Source="himo_pro_ui_himo_login_icon_lock.png"
                                           WidthRequest="21" HeightRequest="21" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Grid>
                            </Border>

                            <Label Text="تأكيد كلمة المرور" FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" Margin="3,0,3,7" />
                            <Border x:Name="ConfirmPasswordBorder" HeightRequest="56" Padding="8,0"
                                    Margin="0,0,0,14"
                                    BackgroundColor="{DynamicResource HimoInput}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="42,*,42" ColumnSpacing="3" FlowDirection="LeftToRight">
                                    <ImageButton x:Name="ConfirmPasswordEyeButton" Grid.Column="0"
                                                 Source="himo_pro_ui_himo_login_eye_open.png"
                                                 BackgroundColor="Transparent" Padding="10"
                                                 WidthRequest="40" HeightRequest="44"
                                                 Clicked="TogglePasswordClicked"
                                                 SemanticProperties.Description="إظهار أو إخفاء تأكيد كلمة المرور" />
                                    <Entry x:Name="ConfirmPasswordEntry" Grid.Column="1" IsPassword="True"
                                           Placeholder="أعد كتابة كلمة المرور" MaxLength="128"
                                           ReturnType="Done" Completed="ConfirmPasswordCompleted"
                                           TextColor="{DynamicResource HimoPrimary}"
                                           PlaceholderColor="{DynamicResource HimoMuted}"
                                           BackgroundColor="Transparent" FontSize="15"
                                           HorizontalTextAlignment="End" FlowDirection="RightToLeft"
                                           Focused="InputFocused" Unfocused="InputUnfocused" />
                                    <Image Grid.Column="2" Source="himo_pro_ui_himo_login_icon_lock.png"
                                           WidthRequest="21" HeightRequest="21" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Grid>
                            </Border>

                            <Border x:Name="TermsPanel" Padding="12,12" Margin="0,1,0,12"
                                    BackgroundColor="{DynamicResource HimoBackground}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" FlowDirection="RightToLeft">
                                    <CheckBox x:Name="TermsCheckBox" Grid.Column="0"
                                              Color="{DynamicResource HimoAccent}"
                                              VerticalOptions="Start" />
                                    <Label Grid.Column="1" FontSize="13" LineHeight="1.25"
                                           TextColor="{DynamicResource HimoTextSecondary}"
                                           VerticalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="أوافق على " />
                                                <Span Text="شروط الاستخدام" TextColor="{DynamicResource HimoAccent}" TextDecorations="Underline" FontAttributes="Bold">
                                                    <Span.GestureRecognizers><TapGestureRecognizer Tapped="TermsTapped" /></Span.GestureRecognizers>
                                                </Span>
                                                <Span Text=" و" />
                                                <Span Text="سياسة الخصوصية" TextColor="{DynamicResource HimoAccent}" TextDecorations="Underline" FontAttributes="Bold">
                                                    <Span.GestureRecognizers><TapGestureRecognizer Tapped="PrivacyTapped" /></Span.GestureRecognizers>
                                                </Span>
                                                <Span Text=" قبل إنشاء الحساب." />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="VerificationContainer" IsVisible="False" Spacing="0">
                            <Border HeightRequest="60" Padding="12,0" Margin="0,0,0,12"
                                    BackgroundColor="{DynamicResource HimoInput}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="44,*" FlowDirection="LeftToRight">
                                    <Image Source="himo_pro_ui_himo_login_icon_shield.png" Grid.Column="0"
                                           WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Entry x:Name="VerificationCodeEntry" Grid.Column="1"
                                           Placeholder="رمز التحقق المكوّن من 6 أرقام"
                                           Keyboard="Numeric" MaxLength="6" ReturnType="Done"
                                           Completed="VerificationCompleted"
                                           TextColor="{DynamicResource HimoPrimary}"
                                           PlaceholderColor="{DynamicResource HimoMuted}"
                                           BackgroundColor="Transparent" FontSize="16"
                                           HorizontalTextAlignment="Center" FlowDirection="LeftToRight" />
                                </Grid>
                            </Border>
                            <Label Text="أدخل الرمز الذي أرسلناه إلى بريدك الإلكتروني لإكمال إنشاء الحساب."
                                   FontSize="13" TextColor="{DynamicResource HimoTextSecondary}"
                                   HorizontalTextAlignment="Center" Margin="0,0,0,12" />
                            <Button x:Name="ResendButton" Text="إعادة إرسال رمز التحقق"
                                    HeightRequest="45" CornerRadius="14"
                                    BackgroundColor="{DynamicResource HimoBackground}"
                                    BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                                    TextColor="{DynamicResource HimoPrimary}" FontSize="14"
                                    Clicked="ResendClicked" />
                        </VerticalStackLayout>

                        <Label x:Name="StatusLabel" Text="" FontSize="12"
                               TextColor="{DynamicResource HimoTextSecondary}"
                               HorizontalTextAlignment="Center" Margin="0,2,0,8" />
                        <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False"
                                           Color="{DynamicResource HimoAccent}"
                                           HorizontalOptions="Center" WidthRequest="28" HeightRequest="28" />

                        <Button x:Name="PrimaryButton" Text="إنشاء الحساب"
                                HeightRequest="56" CornerRadius="17"
                                Background="{DynamicResource HimoAccentGradient}"
                                TextColor="{DynamicResource HimoOnAccent}"
                                FontSize="17" FontAttributes="Bold"
                                Clicked="PrimaryClicked" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,18,0,0">
                    <Label Text="لديك حساب بالفعل؟" FontSize="14"
                           TextColor="{DynamicResource HimoTextSecondary}"
                           VerticalTextAlignment="Center" />
                    <Button Text="تسجيل الدخول" Clicked="BackClicked"
                            BackgroundColor="Transparent" Padding="3,5" HeightRequest="38"
                            TextColor="{DynamicResource HimoAccent}" FontSize="14" FontAttributes="Bold" />
                </HorizontalStackLayout>

                <Label Text="بحسابك، يمكنك التحكم في أذونات الجهاز من الإعدادات في أي وقت."
                       FontSize="11" TextColor="{DynamicResource HimoMuted}"
                       HorizontalTextAlignment="Center" Margin="12,8,12,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
