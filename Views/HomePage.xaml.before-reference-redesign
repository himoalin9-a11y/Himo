<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             xmlns:viewmodels="clr-namespace:Himo.ViewModels"
             x:Class="Himo.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Himo"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoHomeBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="HimoHomeBackground">#08071A</Color>
            <Color x:Key="HimoHomeSurface">#15132D</Color>
            <Color x:Key="HimoHomeSurface2">#0D0B20</Color>
            <Color x:Key="HimoHomePrimary">#7C3AED</Color>
            <Color x:Key="HimoHomeBright">#8B5CF6</Color>
            <Color x:Key="HimoHomeLight">#C4B5FD</Color>
            <Color x:Key="HimoHomeDark">#25145F</Color>
            <Color x:Key="HimoHomeText">#FFFFFF</Color>
            <Color x:Key="HimoHomeSecondary">#B9B1D9</Color>
            <Color x:Key="HimoHomeDivider">#292354</Color>
            <Color x:Key="HimoHomeOnline">#20D66B</Color>
            <Color x:Key="HimoHomeDanger">#FF334A</Color>

            <Style x:Key="HomeNavText" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{DynamicResource HimoHomeSecondary}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          BackgroundColor="{DynamicResource HimoHomeBackground}">

        <!-- Soft top glow -->
        <Ellipse Grid.Row="0"
                 WidthRequest="300"
                 HeightRequest="190"
                 Fill="#2A145F"
                 Opacity="0.46"
                 HorizontalOptions="Start"
                 VerticalOptions="Start"
                 TranslationX="-110"
                 TranslationY="-82"
                 InputTransparent="True" />

        <!-- HEADER -->
        <Grid Grid.Row="0"
              HeightRequest="84"
              Padding="18,10,18,6"
              ColumnDefinitions="56,*,56"
              FlowDirection="LeftToRight">

            <!-- Left side: search + more -->
            <HorizontalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Start" VerticalOptions="Center">
                <Border WidthRequest="46" HeightRequest="46" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                    <Image Source="icon_search_header_white.svg" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SearchUserClicked" />
                    </Border.GestureRecognizers>
                </Border>
                <Border WidthRequest="46" HeightRequest="46" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                    <Image Source="icon_more.svg" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OverflowMenuClicked" />
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>

            <!-- Center brand -->
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" FlowDirection="LeftToRight">
                <Label Text="Himo"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource HimoHomeText}"
                       VerticalTextAlignment="Center" />
                <Border WidthRequest="42"
                        HeightRequest="42"
                        BackgroundColor="{DynamicResource HimoHomePrimary}"
                        Stroke="#9C72FF"
                        StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#6E3CEB" Offset="0,2" Radius="10" Opacity="0.38" />
                    </Border.Shadow>
                    <Label Text="H"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
            </HorizontalStackLayout>

            <!-- Right side: profile -->
            <Border Grid.Column="2"
                    WidthRequest="52"
                    HeightRequest="52"
                    BackgroundColor="#1C173D"
                    Stroke="#51438F"
                    StrokeThickness="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                <Image Source="icon_profile_white.svg" WidthRequest="27" HeightRequest="27" Aspect="AspectFit" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ProfileClicked" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- SEARCH -->
        <Border Grid.Row="1"
                Margin="36,3,36,10"
                HeightRequest="60"
                Padding="7"
                BackgroundColor="{DynamicResource HimoHomeSurface}"
                Stroke="#43357A"
                StrokeThickness="1.2">
            <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
            <Grid FlowDirection="LeftToRight" ColumnDefinitions="48,*">
                <Border Grid.Column="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Image Source="icon_search_header_white.svg" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" Opacity="0.78" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SearchUserClicked" />
                    </Border.GestureRecognizers>
                </Border>
                <Entry x:Name="Search"
                       Grid.Column="1"
                       FlowDirection="RightToLeft"
                       Placeholder="البحث في المحادثات..."
                       PlaceholderColor="{DynamicResource HimoHomeLight}"
                       TextColor="{DynamicResource HimoHomeText}"
                       FontSize="17"
                       BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing"
                       HorizontalOptions="Fill"
                       VerticalOptions="Center"
                       TextChanged="SearchTextChanged" />
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="2"
                Margin="36,0,36,8"
                HeightRequest="60"
                BackgroundColor="#0F0C24"
                Stroke="#3C306F"
                StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*" FlowDirection="RightToLeft" Padding="4">
                <Border Grid.Column="0"
                        BackgroundColor="{DynamicResource HimoHomePrimary}"
                        StrokeThickness="0"
                        Margin="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Image Source="icon_chat_empty.svg" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" />
                        <Label Text="المحادثات" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0">
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Image Source="icon_user.svg" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" />
                        <Label Text="الجهات" FontSize="16" TextColor="{DynamicResource HimoHomeLight}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0">
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Image Source="icon_call_end.svg" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" Opacity="0.78" />
                        <Label Text="المكالمات" FontSize="16" TextColor="{DynamicResource HimoHomeLight}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="3">
            <!-- Kept for existing connection logic; hidden. -->
            <Grid x:Name="ConnectionStatusContainer" IsVisible="False" HeightRequest="0">
                <Label x:Name="ConnectionLabel" Text="" />
                <ActivityIndicator x:Name="RefreshIndicator" IsRunning="False" IsVisible="False" />
                <Button x:Name="RetryButton" IsVisible="False" Clicked="RetryClicked" />
            </Grid>

            <RefreshView x:Name="ConversationRefresh"
                         Refreshing="ConversationRefresh_Refreshing"
                         Margin="18,0,18,0">
                <CollectionView ItemsSource="{Binding FilteredConversations}"
                                SelectionMode="Single"
                                SelectionChanged="ConversationSelected"
                                ItemSizingStrategy="MeasureAllItems"
                                BackgroundColor="Transparent"
                                FlowDirection="RightToLeft"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.EmptyView>
                        <Grid HeightRequest="300" Padding="20,34">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                <Border WidthRequest="72" HeightRequest="72"
                                        BackgroundColor="{DynamicResource HimoHomeDark}"
                                        Stroke="#51438F"
                                        StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                    <Image Source="icon_chat_empty.svg" WidthRequest="36" HeightRequest="36" />
                                </Border>
                                <Label x:Name="EmptyTitle"
                                       Text="لا توجد محادثات بعد"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoHomeText}"
                                       HorizontalTextAlignment="Center" />
                                <Label x:Name="EmptyHint"
                                       Text="ابدأ محادثة جديدة مع أصدقائك"
                                       FontSize="14"
                                       TextColor="{DynamicResource HimoHomeSecondary}"
                                       HorizontalTextAlignment="Center" />
                                <Button Text="بدء محادثة"
                                        Clicked="NewConversationClicked"
                                        HeightRequest="46"
                                        Padding="24,0"
                                        BackgroundColor="{DynamicResource HimoHomePrimary}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="23" />
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Conversation">
                            <Grid FlowDirection="LeftToRight"
                                  ColumnDefinitions="74,*,96"
                                  ColumnSpacing="12"
                                  Padding="0,9"
                                  MinimumHeightRequest="76">

                                <!-- Left meta: time, unread, chevron -->
                                <Grid Grid.Column="0"
                                      ColumnDefinitions="*,28"
                                      RowDefinitions="Auto,Auto"
                                      VerticalOptions="Center">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Time}"
                                           FontSize="13"
                                           TextColor="{DynamicResource HimoHomeSecondary}"
                                           HorizontalTextAlignment="Start"
                                           VerticalTextAlignment="Center" />
                                    <Border Grid.Row="1" Grid.Column="0"
                                            WidthRequest="27"
                                            HeightRequest="27"
                                            BackgroundColor="{DynamicResource HimoHomePrimary}"
                                            StrokeThickness="0"
                                            HorizontalOptions="Start"
                                            Margin="0,5,0,0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding UnreadCount}" Value="0">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding UnreadCount}"
                                               TextColor="White"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                           Source="icon_chevron_right.svg"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Opacity="0.9" />
                                </Grid>

                                <!-- Center conversation details -->
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="Fill"
                                                     Spacing="4"
                                                     FlowDirection="RightToLeft">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource HimoHomeText}"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="End" />
                                    <Label Text="{Binding LastMessage}"
                                           FontSize="14"
                                           TextColor="{DynamicResource HimoHomeSecondary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>

                                <!-- Right avatar -->
                                <Grid Grid.Column="2"
                                      WidthRequest="62"
                                      HeightRequest="62"
                                      HorizontalOptions="End"
                                      VerticalOptions="Center">
                                    <Border WidthRequest="58"
                                            HeightRequest="58"
                                            BackgroundColor="#352078"
                                            Stroke="#5D43A2"
                                            StrokeThickness="1.2"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="29" /></Border.StrokeShape>
                                        <Label Text="{Binding Initial}"
                                               TextColor="{DynamicResource HimoHomeLight}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Ellipse WidthRequest="15"
                                             HeightRequest="15"
                                             Fill="{DynamicResource HimoHomeOnline}"
                                             Stroke="#08071A"
                                             StrokeThickness="3"
                                             HorizontalOptions="End"
                                             VerticalOptions="End"
                                             TranslationX="-1"
                                             TranslationY="-1" />
                                </Grid>

                                <!-- Divider -->
                                <BoxView Grid.Column="0"
                                         Grid.ColumnSpan="3"
                                         HeightRequest="1"
                                         BackgroundColor="{DynamicResource HimoHomeDivider}"
                                         Opacity="0.82"
                                         VerticalOptions="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Bottom decorative waves -->
            <Image Source="login_waves.svg"
                   HeightRequest="130"
                   Aspect="Fill"
                   VerticalOptions="End"
                   HorizontalOptions="Fill"
                   Opacity="0.50"
                   InputTransparent="True"
                   ZIndex="-1" />

            <!-- Floating new conversation button -->
            <Border WidthRequest="66"
                    HeightRequest="66"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="20,0,0,12"
                    BackgroundColor="{DynamicResource HimoHomeBright}"
                    Stroke="#A58AFF"
                    StrokeThickness="1"
                    ZIndex="5">
                <Border.StrokeShape><RoundRectangle CornerRadius="33" /></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#7C3AED" Offset="0,4" Radius="15" Opacity="0.55" />
                </Border.Shadow>
                <Image Source="icon_plus.png" WidthRequest="31" HeightRequest="31" Aspect="AspectFit" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="NewConversationClicked" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- BOTTOM NAVIGATION -->
        <Border Grid.Row="4"
                Margin="16,4,16,10"
                Padding="7,7,7,5"
                BackgroundColor="#0D0B20"
                Stroke="#302762"
                StrokeThickness="1"
                HeightRequest="84"
                ZIndex="10">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*,*" FlowDirection="RightToLeft">
                <!-- Home -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="icon_home.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" />
                    <Label Text="الرئيسية" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource HimoHomeBright}" HorizontalTextAlignment="Center" />
                    <Border HeightRequest="3" WidthRequest="30" BackgroundColor="{DynamicResource HimoHomeBright}" StrokeThickness="0" HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="2" /></Border.StrokeShape>
                    </Border>
                </VerticalStackLayout>

                <!-- Conversations -->
                <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="icon_chat_empty.svg" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" Opacity="0.72" />
                    <Label Text="المحادثات" Style="{StaticResource HomeNavText}" />
                </VerticalStackLayout>

                <!-- Calls -->
                <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="icon_call_end.svg" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" Opacity="0.72" />
                    <Label Text="المكالمات" Style="{StaticResource HomeNavText}" />
                </VerticalStackLayout>

                <!-- Contacts -->
                <VerticalStackLayout Grid.Column="3" Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="icon_profile_white.svg" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" Opacity="0.72" />
                    <Label Text="الجهات" Style="{StaticResource HomeNavText}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Existing overflow menu/navigation remains intact. -->
        <Border x:Name="OverflowMenu"
                Grid.Row="0"
                Grid.RowSpan="3"
                IsVisible="False"
                WidthRequest="190"
                HeightRequest="152"
                Padding="8"
                BackgroundColor="#15132D"
                Stroke="#51438F"
                StrokeThickness="1"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="12,66,0,0"
                ZIndex="100">
            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,5" Radius="14" Opacity="0.5" />
            </Border.Shadow>
            <Grid RowDefinitions="48,48,48" ColumnDefinitions="34,*" ColumnSpacing="8" RowSpacing="0" FlowDirection="RightToLeft">
                <Image Grid.Row="0" Grid.Column="1" Source="icon_settings.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="End" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="0" Text="الإعدادات" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoHomeText}" VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="SettingsClicked" /></Grid.GestureRecognizers>
                </Grid>
                <Image Grid.Row="1" Grid.Column="1" Source="icon_profile_white.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="End" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="0" Text="الملف الشخصي" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoHomeText}" VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="ProfileClicked" /></Grid.GestureRecognizers>
                </Grid>
                <Image Grid.Row="2" Grid.Column="1" Source="icon_plus.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="End" VerticalOptions="Center" />
                <Label Grid.Row="2" Grid.Column="0" Text="إنشاء مجموعة" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoHomeText}" VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="CreateGroupClicked" /></Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
