<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="Himo.Views.QrScannerPage"
             Title="مسح رمز QR"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Shell.NavBarIsVisible="False">
    <Grid BackgroundColor="#080B12">
        <!-- Live camera fills the screen; controls are layered above it. -->
        <zxing:CameraBarcodeReaderView x:Name="ScannerView"
                                       BarcodesDetected="BarcodesDetected"
                                       HorizontalOptions="Fill" VerticalOptions="Fill" />

        <Grid RowDefinitions="Auto,*,Auto" Padding="18,18,18,26">
            <!-- Top toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="48,*,48,48" ColumnSpacing="10"
                  FlowDirection="LeftToRight" HeightRequest="52">
                <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" BackgroundColor="#66080B12"
                        Stroke="#55FFFFFF" StrokeThickness="1" HorizontalOptions="Start">
                    <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                    <ImageButton Source="himo_icon_arrow_back_purple.png" Clicked="BackClicked"
                                 BackgroundColor="Transparent" Padding="12" Aspect="AspectFit"
                                 SemanticProperties.Description="رجوع" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="مسح رمز QR" FontSize="19" FontAttributes="Bold" TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label Text="امسح رمز حساب Himo" FontSize="12" TextColor="#D6DCE8"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="#66080B12"
                        Stroke="#55FFFFFF" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Label Text="▧" FontSize="23" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border Grid.Column="3" WidthRequest="44" HeightRequest="44" BackgroundColor="#66080B12"
                        Stroke="#55FFFFFF" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Label Text="ϟ" FontSize="26" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Scanner target with blue corner guides, matching the reference screenshot. -->
            <Grid Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center"
                  WidthRequest="300" HeightRequest="300">
                <Border BackgroundColor="#10080B12" Stroke="#55FFFFFF" StrokeThickness="1"
                        InputTransparent="True">
                    <Border.StrokeShape><RoundRectangle CornerRadius="2" /></Border.StrokeShape>
                </Border>
                <BoxView HeightRequest="1" BackgroundColor="#66FFFFFF" VerticalOptions="Center"
                         HorizontalOptions="Fill" Opacity="0.45" />
                <Border WidthRequest="34" HeightRequest="34" Stroke="#168BFF" StrokeThickness="5"
                        BackgroundColor="Transparent" HorizontalOptions="Start" VerticalOptions="Start"
                        Margin="-1,-1,0,0" InputTransparent="True">
                    <Border.StrokeShape><RoundRectangle CornerRadius="1" /></Border.StrokeShape>
                </Border>
                <Border WidthRequest="34" HeightRequest="34" Stroke="#168BFF" StrokeThickness="5"
                        BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="Start"
                        Margin="0,-1,-1,0" InputTransparent="True">
                    <Border.StrokeShape><RoundRectangle CornerRadius="1" /></Border.StrokeShape>
                </Border>
                <Border WidthRequest="34" HeightRequest="34" Stroke="#168BFF" StrokeThickness="5"
                        BackgroundColor="Transparent" HorizontalOptions="Start" VerticalOptions="End"
                        Margin="-1,0,0,-1" InputTransparent="True">
                    <Border.StrokeShape><RoundRectangle CornerRadius="1" /></Border.StrokeShape>
                </Border>
                <Border WidthRequest="34" HeightRequest="34" Stroke="#168BFF" StrokeThickness="5"
                        BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="End"
                        Margin="0,0,-1,-1" InputTransparent="True">
                    <Border.StrokeShape><RoundRectangle CornerRadius="1" /></Border.StrokeShape>
                </Border>
            </Grid>

            <!-- Bottom guidance and zoom-style control -->
            <VerticalStackLayout Grid.Row="2" Spacing="18" VerticalOptions="End">
                <Border BackgroundColor="#B3080B12" Stroke="#33FFFFFF" StrokeThickness="1" Padding="16,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Label x:Name="ScannerStatusLabel"
                           Text="ضع رمز QR داخل الإطار وسيتم التعرف عليه تلقائيًا"
                           FontSize="13" TextColor="White" HorizontalTextAlignment="Center" />
                </Border>
                <Grid ColumnDefinitions="42,*,42" ColumnSpacing="12" FlowDirection="LeftToRight" HeightRequest="44">
                    <Label Grid.Column="0" Text="⊕" FontSize="30" TextColor="White"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="1" Maximum="4" Value="1" MinimumTrackColor="#168BFF"
                            MaximumTrackColor="#99FFFFFF" ThumbColor="White" VerticalOptions="Center"
                            IsEnabled="False" />
                    <Label Grid.Column="2" Text="⊖" FontSize="30" TextColor="White"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
