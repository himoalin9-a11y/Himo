<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Himo.Views.MediaEditorPage"
    BackgroundColor="{DynamicResource HimoBackground}"
    Shell.NavBarIsVisible="False"
    Padding="0">

    <Grid BackgroundColor="{DynamicResource HimoBackground}">
        <Grid x:Name="PreviewHost" BackgroundColor="{DynamicResource HimoBackground}">
            <Image x:Name="PreviewImage"
                   Aspect="AspectFit"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   Rotation="0" />

            <!-- Professional crop overlay: the image remains fixed while the crop model moves independently. -->
            <Grid x:Name="CropOverlay"
                  IsVisible="False"
                  ZIndex="400"
                  InputTransparent="False"
                  BackgroundColor="Transparent"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <GraphicsView x:Name="CropVisual"
                              InputTransparent="False"
                              IsEnabled="True"
                              ZIndex="0"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill" />
            </Grid>

            <Border x:Name="VideoPreviewBadge"
                    IsVisible="False"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="#99000000"
                    StrokeThickness="0"
                    Padding="18,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Image Source="himo_pro_ui_mediaeditor_play.png"
                           WidthRequest="48" HeightRequest="48"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="تشغيل معاينة الفيديو" />
                    <Label Text="فيديو جاهز للتحرير" TextColor="{DynamicResource HimoPrimary}" FontSize="13" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Grid x:Name="AnnotationLayer"
                  IsVisible="False"
                  ZIndex="200"
                  BackgroundColor="Transparent"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill"
                  InputTransparent="False">
                <GraphicsView x:Name="DrawingView"
                              BackgroundColor="Transparent"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              InputTransparent="False"
                              IsEnabled="True"
                              ZIndex="220" />
                <Grid x:Name="TextOverlay"
                      BackgroundColor="Transparent"
                      InputTransparent="True"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />
                <GraphicsView x:Name="TextTouchView"
                              BackgroundColor="Transparent"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              InputTransparent="False"
                              IsVisible="False" />
            </Grid>

            <!-- Professional photo toolbar: native buttons avoid missing SVG glyphs and keep touch targets reliable. -->
            <Grid x:Name="PhotoControls"
                  IsVisible="False"
                  ZIndex="500"
                  VerticalOptions="Start"
                  HorizontalOptions="Fill"
                  Padding="10,16,10,10"
                  BackgroundColor="#55000000"
                  ColumnDefinitions="Auto,*,Auto">
                <ImageButton Grid.Column="0"
                             Source="himo_pro_ui_mediaeditor_close.png"
                             Clicked="CancelClicked"
                             WidthRequest="44"
                             HeightRequest="44"
                             CornerRadius="22"
                             Padding="11"
                             BackgroundColor="{DynamicResource HimoSurface}"
                             BorderColor="{DynamicResource HimoBorder}"
                             BorderWidth="1"
                             Aspect="AspectFit"
                             SemanticProperties.Description="إغلاق محرر الوسائط" />

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="6"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center">
                    <ImageButton x:Name="GalleryButton"
                                 Source="himo_pro_ui_mediaeditor_download.png"
                                 Clicked="SaveToGalleryClicked"
                                 WidthRequest="42" HeightRequest="42" CornerRadius="21"
                                 Padding="10"
                                 BackgroundColor="{DynamicResource HimoSurface}"
                                 BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="حفظ الصورة في مكتبة الصور" />
                    <ImageButton x:Name="RotateButton"
                                 Source="himo_pro_ui_mediaeditor_rotate.png"
                                 Clicked="RotateClicked"
                                 WidthRequest="42" HeightRequest="42" CornerRadius="21"
                                 Padding="10"
                                 BackgroundColor="{DynamicResource HimoSurface}"
                                 BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="تدوير الصورة 90 درجة" />
                    <ImageButton x:Name="TextButton"
                                 Source="himo_pro_ui_mediaeditor_text.png"
                                 Clicked="TextModeClicked"
                                 WidthRequest="42" HeightRequest="42" CornerRadius="21"
                                 Padding="10"
                                 BackgroundColor="{DynamicResource HimoSurface}"
                                 BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="إضافة نص بالعربية أو الإنجليزية" />
                    <ImageButton x:Name="CropButton"
                                 Source="himo_pro_ui_mediaeditor_crop.png"
                                 Clicked="CropModeClicked"
                                 WidthRequest="42" HeightRequest="42" CornerRadius="21"
                                 Padding="10"
                                 BackgroundColor="{DynamicResource HimoSurface}"
                                 BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="قص الصورة؛ اضغط مرة أخرى لتطبيق القص" />
                    <ImageButton x:Name="PenButton"
                                 Source="himo_pro_ui_mediaeditor_pen.png"
                                 Clicked="PenModeClicked"
                                 WidthRequest="42" HeightRequest="42" CornerRadius="21"
                                 Padding="10"
                                 BackgroundColor="{DynamicResource HimoSurface}"
                                 BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="قلم حر للرسم" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Pen palette appears vertically on the side only when the pen is active. -->
            <VerticalStackLayout x:Name="AnnotationPalette"
                                 IsVisible="False"
                                 ZIndex="520"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 Margin="0,0,10,0"
                                 Spacing="9">
                <Button WidthRequest="38" HeightRequest="38" CornerRadius="19"
                        BackgroundColor="#FFFFFFFF"
                        CommandParameter="#FFFFFFFF"
                        Clicked="AnnotationColorClicked"
                        Text="" />
                <Button WidthRequest="38" HeightRequest="38" CornerRadius="19"
                        BackgroundColor="#FFFF3B30"
                        CommandParameter="#FFFF3B30"
                        Clicked="AnnotationColorClicked"
                        Text="" />
                <Button WidthRequest="38" HeightRequest="38" CornerRadius="19"
                        BackgroundColor="#FFFFFFCC"
                        CommandParameter="#FFFFFFCC"
                        Clicked="AnnotationColorClicked"
                        Text="" />
                <Button WidthRequest="38" HeightRequest="38" CornerRadius="19"
                        BackgroundColor="#FF34C759"
                        CommandParameter="#FF34C759"
                        Clicked="AnnotationColorClicked"
                        Text="" />
                <Button WidthRequest="38" HeightRequest="38" CornerRadius="19"
                        BackgroundColor="#FF0A84FF"
                        CommandParameter="#FF0A84FF"
                        Clicked="AnnotationColorClicked"
                        Text="" />
                <Button WidthRequest="38" HeightRequest="38" CornerRadius="19"
                        BackgroundColor="#FFFF2D55"
                        CommandParameter="#FFFF2D55"
                        Clicked="AnnotationColorClicked"
                        Text="" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="AnnotationToolsPanel"
                                 IsVisible="False"
                                 ZIndex="520"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center"
                                 Margin="10,0,0,0"
                                 Spacing="8">
                <ImageButton Source="himo_pro_ui_mediaeditor_undo.png"
                             WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="10"
                             BackgroundColor="{DynamicResource HimoSurface}"
                             BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                             Aspect="AspectFit"
                             Clicked="UndoDrawingClicked"
                             SemanticProperties.Description="التراجع عن آخر رسم" />
                <ImageButton x:Name="FreehandToolButton"
                             Source="himo_pro_ui_mediaeditor_pen.png"
                             Clicked="FreehandToolClicked"
                             BackgroundColor="{DynamicResource HimoSurface}"
                             BorderColor="{DynamicResource HimoAccent}"
                             BorderWidth="2"
                             Padding="10"
                             HeightRequest="42" WidthRequest="42" CornerRadius="21"
                             Aspect="AspectFit"
                             SemanticProperties.Description="قلم حر" />
                <ImageButton Source="himo_pro_ui_mediaeditor_minus.png"
                             WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="11"
                             BackgroundColor="{DynamicResource HimoSurface}"
                             BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                             Aspect="AspectFit"
                             Clicked="DecreaseBrushSizeClicked"
                             SemanticProperties.Description="تصغير حجم القلم" />
                <Label x:Name="BrushSizeLabel"
                       Text="33%"
                       WidthRequest="44"
                       HeightRequest="34"
                       TextColor="{DynamicResource HimoPrimary}"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       BackgroundColor="{DynamicResource HimoSurface}" />
                <ImageButton Source="himo_pro_ui_mediaeditor_plus.png"
                             WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="10"
                             BackgroundColor="{DynamicResource HimoSurface}"
                             BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                             Aspect="AspectFit"
                             Clicked="IncreaseBrushSizeClicked"
                             SemanticProperties.Description="تكبير حجم القلم" />
                <HorizontalStackLayout x:Name="BrushSizePanel"
                                       IsVisible="False"
                                       Spacing="4" />
            </VerticalStackLayout>

            <!-- Caption + send bar -->
            <Border x:Name="CaptionBar"
                    ZIndex="500"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="10,0,10,14"
                    Padding="10,8"
                    BackgroundColor="{DynamicResource HimoCard}"
                    Stroke="{DynamicResource HimoBorder}"
                    StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="CaptionEntry"
                           Grid.Column="0"
                           Placeholder="أضف وصفًا للصورة…"
                           PlaceholderColor="{DynamicResource HimoTextSecondary}"
                           TextColor="{DynamicResource HimoPrimary}"
                           FontSize="15"
                           BackgroundColor="Transparent"
                           HorizontalOptions="Fill"
                           ClearButtonVisibility="WhileEditing" />
                    <ImageButton x:Name="SendButton"
                                 Grid.Column="1"
                                 Source="himo_pro_ui_mediaeditor_send.png"
                                 Clicked="SaveClicked"
                                 WidthRequest="48" HeightRequest="48" CornerRadius="24"
                                 Padding="12"
                                 BackgroundColor="{DynamicResource HimoAccent}"
                                 BorderWidth="0"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="إرسال الوسائط" />
                </Grid>
            </Border>

            <Border x:Name="BusyOverlay"
                    ZIndex="1000"
                    IsVisible="False"
                    BackgroundColor="#B8000000"
                    StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <ActivityIndicator IsRunning="True" Color="White" WidthRequest="42" HeightRequest="42" />
                    <Label x:Name="BusyLabel"
                           Text="جارٍ تجهيز الملف…"
                           TextColor="{DynamicResource HimoPrimary}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="VideoEditorPanel"
                    IsVisible="False"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    BackgroundColor="{DynamicResource HimoCard}"
                    Stroke="{DynamicResource HimoBorder}"
                    StrokeThickness="1"
                    Padding="14,12,14,18">
                <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="SubtitleLabel"
                           Text="قص الفيديو وكتم الصوت"
                           TextColor="{DynamicResource HimoPrimary}"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8">
                        <Label Text="البداية" TextColor="{DynamicResource HimoPrimary}" FontSize="12" VerticalTextAlignment="Center" />
                        <Slider x:Name="StartSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" />
                        <Label x:Name="StartValueLabel" Grid.Column="2" Text="00:00" TextColor="{DynamicResource HimoTextSecondary}" WidthRequest="48" HorizontalTextAlignment="End" />
                        <Label Grid.Row="1" Text="النهاية" TextColor="{DynamicResource HimoPrimary}" FontSize="12" VerticalTextAlignment="Center" />
                        <Slider x:Name="EndSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="1" />
                        <Label x:Name="EndValueLabel" Grid.Row="1" Grid.Column="2" Text="00:00" TextColor="{DynamicResource HimoTextSecondary}" WidthRequest="48" HorizontalTextAlignment="End" />
                    </Grid>
                    <HorizontalStackLayout Spacing="10">
                        <Switch x:Name="MuteVideoSwitch" />
                        <Label Text="كتم صوت الفيديو" TextColor="{DynamicResource HimoPrimary}" FontSize="13" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Button Text="حفظ وإرسال"
                            Clicked="SaveClicked"
                            TextColor="{DynamicResource HimoOnAccent}"
                            BackgroundColor="{DynamicResource HimoAccent}"
                            CornerRadius="20"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
