<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.ProfilePage"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Title="الملف الشخصي"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">

        <!-- Reference-style purple header -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource HimoHeader}"
                StrokeThickness="0"
                Padding="16,7,16,14">
            <Grid ColumnDefinitions="48,*,48" HeightRequest="58">
                <Button Grid.Column="0"
                        Text="›"
                        Style="{StaticResource HimoBackButton}"
                        Clicked="BackClicked" />

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="1">
                    <Label Text="ملفي الشخصي"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label Text="معلوماتك التي تظهر للآخرين"
                           FontSize="11"
                           TextColor="{DynamicResource HimoHeaderTextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <BoxView Grid.Column="2" Opacity="0" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,28" Spacing="12">

                <!-- Avatar -->
                <Border HorizontalOptions="Center"
                        WidthRequest="80"
                        HeightRequest="80"
                        BackgroundColor="{DynamicResource HimoSoft}"
                        Stroke="{DynamicResource HimoAccent}"
                        StrokeThickness="2"
                        Margin="0,2,0,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40" />
                    </Border.StrokeShape>
                    <Label x:Name="InitialLabel"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource HimoPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="معلوماتك"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource HimoMuted}"
                       Margin="4,4,4,0" />

                <!-- Name -->
                <Border BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}"
                        StrokeThickness="1"
                        Padding="13,12"
                        Margin="0,0,0,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="الاسم"
                               FontSize="11"
                               TextColor="{DynamicResource HimoMuted}" />
                        <Entry x:Name="NameEntry"

                               TextChanged="ProfileFieldChanged"
                               Placeholder="اسمك"
                               FontSize="16"
                               MaxLength="60"
                               BackgroundColor="Transparent"
                               TextColor="{DynamicResource HimoPrimary}"
                               PlaceholderColor="{DynamicResource HimoMuted}"
                               HeightRequest="40" />
                        <Label Text="استخدم اسمًا واضحًا ليسهل على أصدقائك العثور عليك."
                               FontSize="10"
                               TextColor="{DynamicResource HimoTextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Border BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}"
                        StrokeThickness="1"
                        Padding="13,12"
                        Margin="0,0,0,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="الحالة"
                               FontSize="11"
                               TextColor="{DynamicResource HimoMuted}" />
                        <Entry x:Name="StatusEntry"

                               TextChanged="ProfileFieldChanged"
                               Placeholder="مثال: متاح الآن"
                               FontSize="16"
                               MaxLength="100"
                               BackgroundColor="Transparent"
                               TextColor="{DynamicResource HimoPrimary}"
                               PlaceholderColor="{DynamicResource HimoMuted}"
                               HeightRequest="40" />
                        <Label Text="اكتب جملة قصيرة تعبّر عن حالتك الآن."
                               FontSize="10"
                               TextColor="{DynamicResource HimoTextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Save -->
                <Border BackgroundColor="{DynamicResource HimoAccent}"
                        StrokeThickness="0"
                        Margin="0,5,0,0"
                        HeightRequest="52">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Button Text="حفظ التغييرات"
                            HeightRequest="52"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            Clicked="SaveClicked" />
                </Border>

                <Label Text="يتم حفظ التغييرات على حسابك عند توفر الاتصال."
                       FontSize="10"
                       TextColor="{DynamicResource HimoTextSecondary}"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
