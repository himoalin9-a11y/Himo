<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.ProfilePage"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Title="الملف الشخصي"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0"
          BackgroundColor="{DynamicResource HimoBackground}">
        <!-- Soft, theme-aware background glow. -->
        <Ellipse Grid.RowSpan="3" WidthRequest="310" HeightRequest="310"
                 Fill="{DynamicResource HimoAccentGradient}" Opacity="0.08"
                 HorizontalOptions="Start" VerticalOptions="Start"
                 TranslationX="-190" TranslationY="-180"
                 InputTransparent="True" />
        <Ellipse Grid.RowSpan="3" WidthRequest="260" HeightRequest="260"
                 Fill="{DynamicResource HimoAccentGradient}" Opacity="0.07"
                 HorizontalOptions="End" VerticalOptions="End"
                 TranslationX="130" TranslationY="120"
                 InputTransparent="True" />

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10,16,8"
              ColumnDefinitions="44,*,44" ColumnSpacing="10"
              FlowDirection="LeftToRight">
            <ImageButton Grid.Column="0" Source="settings_icon_gear.png"
                         WidthRequest="42" HeightRequest="42" Padding="10"
                         Aspect="AspectFit" BackgroundColor="{DynamicResource HimoSoft}"
                         BorderColor="{DynamicResource HimoBorder}" BorderWidth="1"
                         CornerRadius="15" HorizontalOptions="Start" VerticalOptions="Center"
                         SemanticProperties.Description="الإعدادات"
                         Clicked="SettingsHeaderClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="2"
                                 HorizontalOptions="Center" VerticalOptions="Center"
                                 FlowDirection="RightToLeft">
                <Label Text="ملفي الشخصي" FontSize="21" FontAttributes="Bold"
                       TextColor="{DynamicResource HimoPrimary}"
                       HorizontalTextAlignment="Center" />
                <Label Text="هويتك ومساحتك على Himo" FontSize="11.5"
                       TextColor="{DynamicResource HimoTextSecondary}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <BoxView Grid.Column="2" WidthRequest="42" HeightRequest="42" Opacity="0" />
        </Grid>

        <ScrollView x:Name="ProfileScroll" Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,7,16,22" Spacing="15">
                <!-- Profile hero -->
                <Border BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}" StrokeThickness="1.2"
                        Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="27" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,116" ColumnSpacing="10"
                          FlowDirection="LeftToRight">
                        <VerticalStackLayout Grid.Column="0" Spacing="7"
                                             VerticalOptions="Center"
                                             FlowDirection="RightToLeft">
                            <Border HorizontalOptions="Start" Padding="9,4"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="0.8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label Text="ملف Himo الشخصي" FontSize="10.5"
                                       FontAttributes="Bold" TextColor="{DynamicResource HimoAccent}" />
                            </Border>
                            <Label x:Name="ProfileNameLabel" Text="مستخدم Himo"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}"
                                   HorizontalTextAlignment="Start"
                                   LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label x:Name="ProfileStatusLabel" Text="متاح على Himo"
                                   FontSize="13" TextColor="{DynamicResource HimoTextSecondary}"
                                   HorizontalTextAlignment="Start" LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                            <HorizontalStackLayout Spacing="6" FlowDirection="RightToLeft"
                                                   HorizontalOptions="Start" Margin="0,2,0,0">
                                <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="4"
                                         Color="#20C997" VerticalOptions="Center" />
                                <Label Text="حسابك على Himo" FontSize="11.5"
                                       TextColor="{DynamicResource HimoTextSecondary}"
                                       VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Grid Grid.Column="1" WidthRequest="112" HeightRequest="112"
                              HorizontalOptions="End" VerticalOptions="Center"
                              FlowDirection="LeftToRight">
                            <Border WidthRequest="108" HeightRequest="108" Padding="3"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoAccent}" StrokeThickness="2"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="54" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ProfilePhotoTapped" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Image x:Name="ProfilePhotoImage" WidthRequest="100" HeightRequest="100"
                                           Aspect="AspectFill" IsVisible="False">
                                        <Image.Clip>
                                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                                        </Image.Clip>
                                    </Image>
                                    <Label x:Name="InitialLabel" Text="H" FontSize="37"
                                           FontAttributes="Bold" TextColor="{DynamicResource HimoAccent}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <ImageButton x:Name="CameraPhotoButton" Source="settings_icon_camera.png"
                                         WidthRequest="35" HeightRequest="35" Padding="8"
                                         Aspect="AspectFit" CornerRadius="18"
                                         BackgroundColor="{DynamicResource HimoAccent}"
                                         BorderColor="{DynamicResource HimoCard}" BorderWidth="2"
                                         HorizontalOptions="End" VerticalOptions="End"
                                         SemanticProperties.Description="تغيير صورة الملف الشخصي"
                                         Clicked="ChangePhotoClicked" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Dedicated account-sharing entry; keeps friend search in the People section. -->
                <Border BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}" StrokeThickness="1.1"
                        Padding="14,13">
                    <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,56" ColumnSpacing="12" FlowDirection="LeftToRight">
                        <VerticalStackLayout Grid.Column="0" Spacing="4"
                                             VerticalOptions="Center" FlowDirection="RightToLeft">
                            <Label Text="مشاركة الحساب" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="اعرض رمز QR أو شارك رابط حسابك مع الآخرين" FontSize="12"
                                   TextColor="{DynamicResource HimoTextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="48" HeightRequest="48"
                                BackgroundColor="{DynamicResource HimoSoft}"
                                Stroke="{DynamicResource HimoBorder}" StrokeThickness="1"
                                HorizontalOptions="End" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Image Source="himo_ui_share.png" WidthRequest="25" HeightRequest="25"
                                   Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ShareAccountTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Profile and app shortcuts -->
                <Border BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}" StrokeThickness="1"
                        Padding="8,3">
                    <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid HeightRequest="76" ColumnDefinitions="*,48" ColumnSpacing="10"
                              Padding="7,4" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="EditProfileTapped" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="الملف الشخصي" FontSize="15.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Start" />
                                <Label Text="الاسم والحالة وبيانات الاتصال" FontSize="11.5"
                                       TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="0.8"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Image Source="himo_pro_ui_settings_icon_user.png" WidthRequest="23" HeightRequest="23"
                                       Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource HimoBorder}" Opacity="0.65" />

                        <Grid HeightRequest="76" ColumnDefinitions="*,48" ColumnSpacing="10"
                              Padding="7,4" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="SecurityPrivacyTapped" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="الأمان والخصوصية" FontSize="15.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Start" />
                                <Label Text="حماية حسابك والتحكم في معلوماتك" FontSize="11.5"
                                       TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="0.8"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Image Source="himo_pro_ui_settings_icon_shield.png" WidthRequest="23" HeightRequest="23"
                                       Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource HimoBorder}" Opacity="0.65" />

                        <Grid HeightRequest="76" ColumnDefinitions="*,48" ColumnSpacing="10"
                              Padding="7,4" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="NotificationsTapped" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="الإشعارات" FontSize="15.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Start" />
                                <Label Text="الأصوات والتنبيهات والاهتزاز" FontSize="11.5"
                                       TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="0.8"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Image Source="himo_pro_ui_settings_icon_bell.png" WidthRequest="23" HeightRequest="23"
                                       Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource HimoBorder}" Opacity="0.65" />

                        <Grid HeightRequest="76" ColumnDefinitions="*,48" ColumnSpacing="10"
                              Padding="7,4" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="AppearanceTapped" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="المظهر والواجهة" FontSize="15.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Start" />
                                <Label Text="تخصيص الألوان والأيقونات" FontSize="11.5"
                                       TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="0.8"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Image Source="himo_pro_ui_settings_icon_palette.png" WidthRequest="23" HeightRequest="23"
                                       Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource HimoBorder}" Opacity="0.65" />

                        <Grid HeightRequest="76" ColumnDefinitions="*,48" ColumnSpacing="10"
                              Padding="7,4" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="HelpTapped" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="مساعدة ودعم" FontSize="15.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Start" />
                                <Label Text="خطوات سريعة لحل مشكلات التطبيق" FontSize="11.5"
                                       TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="0.8"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Image Source="himo_s8_account_info.png" WidthRequest="23" HeightRequest="23"
                                       Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="8,0" Color="{DynamicResource HimoBorder}" Opacity="0.65" />

                        <Grid HeightRequest="76" ColumnDefinitions="*,48" ColumnSpacing="10"
                              Padding="7,4" FlowDirection="LeftToRight">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="AboutTapped" /></Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="حول التطبيق" FontSize="15.5" FontAttributes="Bold"
                                       TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Start" />
                                <Label Text="معلومات عن Himo والإصدار الحالي" FontSize="11.5"
                                       TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{DynamicResource HimoSoft}"
                                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="0.8"
                                    HorizontalOptions="End" VerticalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Image Source="himo_s9_info.png" WidthRequest="23" HeightRequest="23"
                                       Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="تسجيل الخروج" Clicked="LogoutClicked"
                        HeightRequest="52" CornerRadius="17"
                        BackgroundColor="{DynamicResource HimoSoft}"
                        BorderColor="#D94B73" BorderWidth="1"
                        TextColor="#FF5C83" FontSize="15" FontAttributes="Bold" />
                <Label Text="إدارة ملفك الشخصي وإعدادات Himo من مكان واحد"
                       FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}"
                       HorizontalTextAlignment="Center" Margin="3,0,3,2" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- The same five-item bottom navigation used in Home/Calls/Search. -->
        <Border x:Name="BottomNavigationBar" Grid.Row="2" Margin="9,7,9,9"
                HeightRequest="68" MinimumHeightRequest="68" MaximumHeightRequest="68" VerticalOptions="End"
                BackgroundColor="{DynamicResource HimoCard}"
                Stroke="{DynamicResource HimoBorder}" StrokeThickness="1.1"
                Padding="3,4">
            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*,*,*" FlowDirection="RightToLeft">
                <Border Grid.Column="0" Margin="2,0" Padding="2,5"
                        BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="home_chat_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="المحادثات" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ChatsNavTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" Margin="2,0" Padding="2,5"
                        BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_call_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="المكالمات" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="CallsNavTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="2" Margin="2,0" Padding="2,5"
                        BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_search_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="بحث الأشخاص" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="PeopleNavTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="3" Margin="2,0" Padding="2,5"
                        BackgroundColor="{DynamicResource HimoSoft}"
                        Stroke="{DynamicResource HimoAccent}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_user_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="الملف" FontSize="10.5" FontAttributes="Bold"
                               TextColor="{DynamicResource HimoAccent}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="4" Margin="2,0" Padding="2,5"
                        BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_settings_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="الإعدادات" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="SettingsNavTapped" /></Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="PageSwiped" />
            <SwipeGestureRecognizer Direction="Right" Swiped="PageSwiped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentPage>
