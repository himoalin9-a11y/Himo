<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             x:Class="Himo.Views.ChatPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F5F9FE"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ChatHeaderButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="ComposerButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="9" />
                <Setter Property="BackgroundColor" Value="#EEF5FD" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="Meta" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="#7A8798" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="86,Auto,*,Auto" BackgroundColor="#F5F9FE">

        <!-- CHAT HEADER -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" Stroke="#E3EBF5" StrokeThickness="1" Padding="12,7">
            <Grid ColumnDefinitions="Auto,*,Auto" FlowDirection="LeftToRight">
                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center" HorizontalOptions="Start">
                    <ImageButton Source="himo_icon_arrow_back_purple.png" Style="{StaticResource ChatHeaderButton}" Clicked="BackClicked" />
                    <ImageButton Source="himo_phase1_icon_more.png" Style="{StaticResource ChatHeaderButton}" />
                    <ImageButton Source="himo_icon_camera.png" Style="{StaticResource ChatHeaderButton}" Clicked="VideoCallClicked" />
                    <ImageButton Source="himo_phase1_icon_call_phone.png" Style="{StaticResource ChatHeaderButton}" Clicked="AudioCallClicked" />
                </HorizontalStackLayout>

                <Grid Grid.Column="2" ColumnDefinitions="58,*" ColumnSpacing="9" VerticalOptions="Center" HorizontalOptions="End">
                    <Grid Grid.Column="0" WidthRequest="54" HeightRequest="54">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#EAF3FF" Stroke="#CFE2FB" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                            <Label x:Name="InitialLabel" Text="H" FontSize="21" FontAttributes="Bold"
                                   TextColor="#2F80ED" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Ellipse x:Name="StatusDot" WidthRequest="12" HeightRequest="12"
                                 HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,2"
                                 Fill="#28C76F" Stroke="#FFFFFF" StrokeThickness="2" />
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center" MaximumWidthRequest="180" FlowDirection="RightToLeft">
                        <Label x:Name="NameLabel" Text="محادثة" FontSize="18" FontAttributes="Bold"
                               TextColor="#172033" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label x:Name="StatusLabel" Text="غير متصل" FontSize="11.5" TextColor="#718096" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <!-- SELECTION -->
        <Border x:Name="SelectionBar" Grid.Row="1" IsVisible="False" Margin="14,5" Padding="8,6"
                BackgroundColor="#FFFFFF" Stroke="#D9E5F2" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="SelectionCountLabel" Grid.Column="0" Text="0 محددة" FontSize="13"
                       FontAttributes="Bold" TextColor="#2F80ED" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="حذف" FontSize="11" Padding="12,0" HeightRequest="32"
                        BackgroundColor="#FDEBEC" TextColor="#D92D3E" CornerRadius="16" Clicked="DeleteSelectedClicked" />
                <Button Grid.Column="2" Text="إلغاء" FontSize="11" Padding="12,0" HeightRequest="32"
                        BackgroundColor="#EEF5FD" TextColor="#2F80ED" CornerRadius="16" Clicked="CancelSelectionClicked" />
            </Grid>
        </Border>

        <!-- MESSAGES -->
        <Grid Grid.Row="2" Padding="12,4,12,0">
            <Image Source="himo_phase1_login_waves.png" Aspect="AspectFill" Opacity="0.035" HeightRequest="190"
                   VerticalOptions="End" HorizontalOptions="Fill" InputTransparent="True" />

            <Border x:Name="UnreadDivider" IsVisible="False" ZIndex="3" HorizontalOptions="Center"
                    VerticalOptions="Start" Margin="0,4,0,0" Padding="14,6"
                    BackgroundColor="#FFFFFF" Stroke="#CFE2FB" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Label Text="رسائل جديدة" FontSize="11" FontAttributes="Bold" TextColor="#2F80ED" />
            </Border>

            <Border x:Name="MessageSearchBar" IsVisible="False" ZIndex="10" HorizontalOptions="Fill"
                    VerticalOptions="Start" Padding="7" BackgroundColor="#FFFFFF" Stroke="#D8E5F2" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                    <SearchBar x:Name="MessageSearchEntry" Grid.Column="0" Placeholder="بحث في الرسائل..."
                               FontSize="13.5" TextColor="#172033" PlaceholderColor="#94A3B8"
                               BackgroundColor="Transparent" SearchButtonPressed="MessageSearchChanged"
                               TextChanged="MessageSearchChanged" />
                    <Button Grid.Column="1" Text="×" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                            BackgroundColor="#EEF5FD" TextColor="#2F80ED" Clicked="CloseMessageSearchClicked" />
                </Grid>
            </Border>

            <CollectionView x:Name="Messages" SelectionMode="None" VerticalScrollBarVisibility="Never"
                            Loaded="MessagesLoaded" Scrolled="MessagesScrolled" BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <VerticalStackLayout Spacing="6" Padding="0,4">
                            <!-- DATE -->
                            <Grid IsVisible="{Binding HasDateSeparator}" ColumnDefinitions="*,Auto,*" Margin="8,8">
                                <BoxView Grid.Column="0" HeightRequest="1" Color="#DCE6F1" VerticalOptions="Center" Margin="0,0,9,0" />
                                <Border Grid.Column="1" Padding="13,5" BackgroundColor="#FFFFFF" Stroke="#DCE6F1" StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                    <Label Text="{Binding DateSeparatorText}" FontSize="10.5" TextColor="#718096" HorizontalTextAlignment="Center" />
                                </Border>
                                <BoxView Grid.Column="2" HeightRequest="1" Color="#DCE6F1" VerticalOptions="Center" Margin="9,0,0,0" />
                            </Grid>

                            <Border MaximumWidthRequest="360" Padding="13,10,13,8"
                                    HorizontalOptions="End" BackgroundColor="#FFFFFF"
                                    Stroke="#E0E8F2" StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="5">

                                    <!-- REPLY -->
                                    <Border IsVisible="{Binding HasReply}" Padding="8,5" BackgroundColor="#F4F8FD"
                                            Stroke="#DCE6F1" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <Label Text="{Binding ReplyToText}" FontSize="10.5" TextColor="#718096"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                    </Border>

                                    <!-- IMAGE ATTACHMENT -->
                                    <Image Source="{Binding AttachmentLocalPath}" Aspect="AspectFill" HeightRequest="190"
                                           HorizontalOptions="Fill" IsVisible="{Binding HasLocalImagePreview}" />

                                    <!-- FILE -->
                                    <Border IsVisible="{Binding IsAttachment}" Padding="8" BackgroundColor="#F4F8FD"
                                            Stroke="#DCE6F1" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="38,*" ColumnSpacing="8">
                                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#EAF3FF" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                <Image Source="icon_attachment.png" WidthRequest="19" HeightRequest="19" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding AttachmentFileName}" FontSize="11.5" FontAttributes="Bold"
                                                       TextColor="#172033" MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Text="مرفق" FontSize="9.5" TextColor="#718096" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- AUDIO -->
                                    <Grid IsVisible="{Binding IsAudioAttachment}" ColumnDefinitions="42,*,Auto" ColumnSpacing="9" Padding="2">
                                        <Button Grid.Column="0" Text="▶" FontSize="13" WidthRequest="42" HeightRequest="42"
                                                Padding="0" BackgroundColor="#EAF3FF" TextColor="#2F80ED" CornerRadius="21"
                                                Clicked="AudioClicked" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <BoxView WidthRequest="3" HeightRequest="11" CornerRadius="2" Color="#A9C9F2" />
                                            <BoxView WidthRequest="3" HeightRequest="20" CornerRadius="2" Color="#6FA9EE" />
                                            <BoxView WidthRequest="3" HeightRequest="14" CornerRadius="2" Color="#2F80ED" />
                                            <BoxView WidthRequest="3" HeightRequest="25" CornerRadius="2" Color="#2F80ED" />
                                            <BoxView WidthRequest="3" HeightRequest="17" CornerRadius="2" Color="#73ACED" />
                                            <BoxView WidthRequest="3" HeightRequest="22" CornerRadius="2" Color="#2F80ED" />
                                            <BoxView WidthRequest="3" HeightRequest="12" CornerRadius="2" Color="#A9C9F2" />
                                            <BoxView WidthRequest="3" HeightRequest="19" CornerRadius="2" Color="#6FA9EE" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="2" Text="صوت" FontSize="9.5" TextColor="#718096" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- TEXT -->
                                    <Label Text="{Binding Text}" FontSize="16" LineHeight="1.12" TextColor="#172033" LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasLocalImagePreview}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAttachment}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAudioAttachment}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- TIME / STATUS -->
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                                        <Label Text="{Binding EditedLabel}" Style="{StaticResource Meta}" VerticalOptions="Center" />
                                        <Label Text="{Binding SentAt, StringFormat='{0:HH:mm}'}" Style="{StaticResource Meta}" VerticalOptions="Center" />
                                        <Label FontSize="11" VerticalOptions="Center" Text="{Binding DeliveryStatusText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsPending}" Value="True">
                                                    <Setter Property="Text" Value="◷" /><Setter Property="TextColor" Value="#2F80ED" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="read">
                                                    <Setter Property="TextColor" Value="#2F80ED" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="failed">
                                                    <Setter Property="Text" Value="!" /><Setter Property="TextColor" Value="#D92D3E" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="Margin" Value="34,0,0,0" />
                                        <Setter Property="BackgroundColor" Value="#DDEEFF" />
                                        <Setter Property="Stroke" Value="#BBD8F8" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="#2F80ED" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="ScrollToBottomButton" Text="↓" IsVisible="False" HorizontalOptions="End"
                    VerticalOptions="End" Margin="0,0,5,12" WidthRequest="42" HeightRequest="42"
                    CornerRadius="21" BackgroundColor="#FFFFFF" TextColor="#2F80ED" FontSize="18"
                    FontAttributes="Bold" Clicked="ScrollToBottomClicked" BorderWidth="1" BorderColor="#D6E4F2" />

            <VerticalStackLayout x:Name="EmptyState" IsVisible="False" HorizontalOptions="Center"
                                 VerticalOptions="Center" Spacing="9" Padding="28">
                <Border WidthRequest="60" HeightRequest="60" BackgroundColor="#EAF3FF" Stroke="#CFE2FB" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
                    <Image Source="himo_phase1_icon_chat_empty.png" WidthRequest="28" HeightRequest="28" />
                </Border>
                <Label Text="لا توجد رسائل بعد" FontSize="18" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="#172033" />
                <Label Text="ابدأ المحادثة بإرسال أول رسالة" FontSize="13"
                       HorizontalTextAlignment="Center" TextColor="#718096" />
            </VerticalStackLayout>
        </Grid>

        <!-- COMPOSER -->
        <Border Grid.Row="3" Margin="12,6,12,12" Padding="6,6" BackgroundColor="#FFFFFF"
                Stroke="#DDE7F2" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Grid x:Name="ReplyPreview" IsVisible="False" Padding="9,5" ColumnDefinitions="*,Auto" BackgroundColor="#F4F8FD">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="رد على رسالة" FontSize="10" FontAttributes="Bold" TextColor="#2F80ED" />
                        <Label x:Name="ReplyPreviewLabel" FontSize="11" TextColor="#718096" MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="×" FontSize="18" WidthRequest="32" HeightRequest="32"
                            Padding="0" BackgroundColor="Transparent" TextColor="#2F80ED" Clicked="ClearReplyClicked" />
                </Grid>
                <Grid x:Name="RecordingBar" IsVisible="False" Padding="9,3" ColumnDefinitions="Auto,*,Auto">
                    <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#EF4444" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="جارٍ تسجيل رسالة صوتية..." FontSize="11.5" FontAttributes="Bold"
                           TextColor="#172033" VerticalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="اضغط لإيقاف التسجيل" FontSize="9.5" TextColor="#718096" VerticalTextAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="48,*,48,48" ColumnSpacing="4" HeightRequest="54">
                    <ImageButton x:Name="RecordButton" Grid.Column="0" Source="himo_icon_mic.png"
                                 Style="{StaticResource ComposerButton}" Clicked="RecordAudioClicked" />
                    <Entry x:Name="MessageEntry" Grid.Column="1" Placeholder="اكتب رسالة..." ReturnType="Send"
                           ClearButtonVisibility="Never" MaxLength="4000" Completed="SendClicked"
                           TextChanged="MessageEntryTextChanged" FontSize="15.5" TextColor="#172033"
                           PlaceholderColor="#94A3B8" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    <ImageButton Grid.Column="2" Source="himo_icon_attachment.png" Style="{StaticResource ComposerButton}"
                                 Clicked="AttachmentButtonClicked" VerticalOptions="Center" />
                    <ImageButton x:Name="SendButton" Grid.Column="3" Source="himo_icon_send.png"
                                 WidthRequest="46" HeightRequest="46" Padding="10" BackgroundColor="#2F80ED"
                                 CornerRadius="23" Clicked="SendClicked" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
