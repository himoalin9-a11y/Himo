<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             x:Class="Himo.Views.ChatPage"
             x:Name="ChatRoot"
             FlowDirection="RightToLeft"
             BackgroundColor="#F5F9FE"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ChatHeaderButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="ComposerButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="9" />
                <Setter Property="BackgroundColor" Value="#EEF5FD" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="Meta" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="#7A8798" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="86,Auto,*,Auto" BackgroundColor="#F5F9FE">

        <!-- CHAT HEADER -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" Stroke="#E3EBF5" StrokeThickness="1" Padding="12,7">
            <Grid ColumnDefinitions="Auto,*,Auto" FlowDirection="LeftToRight">
                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center" HorizontalOptions="Start">
                    <ImageButton Source="himo_icon_arrow_back_purple.png" Style="{StaticResource ChatHeaderButton}" Clicked="BackClicked" />
                    <ImageButton Source="himo_phase1_icon_more.png" Style="{StaticResource ChatHeaderButton}" />
                    <ImageButton Source="himo_icon_camera.png" Style="{StaticResource ChatHeaderButton}" Clicked="VideoCallClicked" />
                    <ImageButton Source="himo_phase1_icon_call_phone.png" Style="{StaticResource ChatHeaderButton}" Clicked="AudioCallClicked" />
                </HorizontalStackLayout>

                <Grid Grid.Column="2" ColumnDefinitions="58,*" ColumnSpacing="9" VerticalOptions="Center" HorizontalOptions="End">
                    <Grid Grid.Column="0" WidthRequest="54" HeightRequest="54">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#EAF3FF" Stroke="#CFE2FB" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                            <Label x:Name="InitialLabel" Text="H" FontSize="21" FontAttributes="Bold"
                                   TextColor="#2F80ED" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Ellipse x:Name="StatusDot" WidthRequest="12" HeightRequest="12"
                                 HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,2"
                                 Fill="#28C76F" Stroke="#FFFFFF" StrokeThickness="2" />
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center" MaximumWidthRequest="180" FlowDirection="RightToLeft">
                        <Label x:Name="NameLabel" Text="محادثة" FontSize="18" FontAttributes="Bold"
                               TextColor="#172033" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label x:Name="StatusLabel" Text="غير متصل" FontSize="11.5" TextColor="#718096" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <!-- SELECTION ACTION BAR -->
        <Border x:Name="SelectionBar" Grid.Row="0" IsVisible="False" ZIndex="50"
                HorizontalOptions="Fill" VerticalOptions="Start"
                HeightRequest="58" Padding="10,4"
                BackgroundColor="#10181B" StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="7" FlowDirection="LeftToRight">
                <!-- More -->
                <Button Grid.Column="0" Text="⋮" FontSize="28" FontAttributes="Bold"
                        WidthRequest="40" HeightRequest="50" Padding="0"
                        BackgroundColor="Transparent" TextColor="White" />

                <!-- Share / Forward -->
                <Button Grid.Column="1" Text="↗" FontSize="29" FontAttributes="Bold"
                        WidthRequest="44" HeightRequest="50" Padding="0"
                        BackgroundColor="Transparent" TextColor="White"
                        Clicked="ShareSelectedClicked" />

                <!-- Delete -->
                <Button Grid.Column="2" Text="🗑" FontSize="23"
                        WidthRequest="44" HeightRequest="50" Padding="0"
                        BackgroundColor="Transparent" TextColor="White"
                        Clicked="DeleteSelectedClicked" />

                <!-- Comment / Reply -->
                <Button Grid.Column="3" Text="↩" FontSize="30" FontAttributes="Bold"
                        WidthRequest="44" HeightRequest="50" Padding="0"
                        BackgroundColor="Transparent" TextColor="White"
                        Clicked="CommentSelectedClicked" />

                <!-- Selected count -->
                <Label Grid.Column="5" x:Name="SelectionCountLabel" Text="1"
                       FontSize="18" FontAttributes="Bold" TextColor="White"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                       WidthRequest="42" />

            </Grid>
        </Border>

        <!-- INLINE VIDEO PLAYER -->
        <Grid x:Name="InlineVideoOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="200"
              BackgroundColor="#000000" HorizontalOptions="Fill" VerticalOptions="Fill">
            <ContentView x:Name="InlineVideoHost"
                         HorizontalOptions="Fill" VerticalOptions="Fill"
                         BackgroundColor="#000000" />

            <ActivityIndicator x:Name="InlineVideoLoading"
                               IsVisible="False"
                               IsRunning="True"
                               Color="White"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               ZIndex="4" />

            <Border HorizontalOptions="Fill" VerticalOptions="Start"
                    Padding="14,12,12,8"
                    BackgroundColor="#8A0B0F14"
                    StrokeThickness="0"
                    ZIndex="5">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label x:Name="InlineVideoTitleLabel"
                           Text="الفيديو"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start" />
                    <Button Grid.Column="1"
                            Text="×"
                            FontSize="30"
                            Padding="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="#4AFFFFFF"
                            TextColor="White"
                            CornerRadius="22"
                            Clicked="CloseInlineVideoClicked" />
                </Grid>
            </Border>

            <Border HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Padding="14,10,14,12"
                    BackgroundColor="#D90B0F14"
                    StrokeThickness="0"
                    ZIndex="5">
                <VerticalStackLayout Spacing="7">
                    <Slider x:Name="InlineVideoSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            HeightRequest="26"
                            ThumbColor="White"
                            MinimumTrackColor="#5B8CFF"
                            MaximumTrackColor="#73808C"
                            ValueChanged="InlineVideoSliderValueChanged" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Button x:Name="InlineVideoPlayButton"
                                Grid.Column="0"
                                Text="▶"
                                FontSize="17"
                                FontAttributes="Bold"
                                WidthRequest="46"
                                HeightRequest="46"
                                Padding="0"
                                BackgroundColor="#2F80ED"
                                TextColor="White"
                                CornerRadius="23"
                                Clicked="InlineVideoPlayClicked" />

                        <Label x:Name="InlineVideoCurrentTimeLabel"
                               Grid.Column="1"
                               Text="00:00"
                               FontSize="12"
                               TextColor="#DDE7F3"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center" />

                        <Label x:Name="InlineVideoDurationLabel"
                               Grid.Column="2"
                               Text="00:00"
                               FontSize="12"
                               TextColor="#DDE7F3"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MESSAGES -->
        <Grid Grid.Row="2" Padding="12,4,12,0">
            <Image Source="himo_phase1_login_waves.png" Aspect="AspectFill" Opacity="0.035" HeightRequest="190"
                   VerticalOptions="End" HorizontalOptions="Fill" InputTransparent="True" />

            <Border x:Name="UnreadDivider" IsVisible="False" ZIndex="3" HorizontalOptions="Center"
                    VerticalOptions="Start" Margin="0,4,0,0" Padding="14,6"
                    BackgroundColor="#FFFFFF" Stroke="#CFE2FB" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Label Text="رسائل جديدة" FontSize="11" FontAttributes="Bold" TextColor="#2F80ED" />
            </Border>

            <Border x:Name="MessageSearchBar" IsVisible="False" ZIndex="10" HorizontalOptions="Fill"
                    VerticalOptions="Start" Padding="7" BackgroundColor="#FFFFFF" Stroke="#D8E5F2" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                    <SearchBar x:Name="MessageSearchEntry" Grid.Column="0" Placeholder="بحث في الرسائل..."
                               FontSize="13.5" TextColor="#172033" PlaceholderColor="#94A3B8"
                               BackgroundColor="Transparent" SearchButtonPressed="MessageSearchChanged"
                               TextChanged="MessageSearchChanged" />
                    <Button Grid.Column="1" Text="×" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                            BackgroundColor="#EEF5FD" TextColor="#2F80ED" Clicked="CloseMessageSearchClicked" />
                </Grid>
            </Border>

            <CollectionView x:Name="Messages" FlowDirection="LeftToRight" SelectionMode="None" VerticalScrollBarVisibility="Never"
                            Loaded="MessagesLoaded" Scrolled="MessagesScrolled" BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <VerticalStackLayout Spacing="6" Padding="0,4">
                            <!-- DATE -->
                            <Grid IsVisible="{Binding HasDateSeparator}" ColumnDefinitions="*,Auto,*" Margin="8,8">
                                <BoxView Grid.Column="0" HeightRequest="1" Color="#DCE6F1" VerticalOptions="Center" Margin="0,0,9,0" />
                                <Border Grid.Column="1" Padding="13,5" BackgroundColor="#FFFFFF" Stroke="#DCE6F1" StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                    <Label Text="{Binding DateSeparatorText}" FontSize="10.5" TextColor="#718096" HorizontalTextAlignment="Center" />
                                </Border>
                                <BoxView Grid.Column="2" HeightRequest="1" Color="#DCE6F1" VerticalOptions="Center" Margin="9,0,0,0" />
                            </Grid>

                            <Border MaximumWidthRequest="360" Padding="13,10,13,8"
                                    FlowDirection="RightToLeft" HorizontalOptions="Start" BackgroundColor="#FFFFFF"
                                    Stroke="#E0E8F2" StrokeThickness="1"
                                    Loaded="MessageBubbleLoaded">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="5">

                                    <!-- REPLY -->
                                    <Border IsVisible="{Binding HasReply}" Padding="8,5" BackgroundColor="#F4F8FD"
                                            Stroke="#DCE6F1" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <Label Text="{Binding ReplyToText}" FontSize="10.5" TextColor="#718096"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                    </Border>

                                    <!-- IMAGE ATTACHMENT -->
                                    <Border IsVisible="{Binding IsImageAttachment}" BackgroundColor="#EEF5FD"
                                            Stroke="#DCE6F1" StrokeThickness="1" Padding="0" Loaded="ImageAttachmentLoaded">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                        <Grid HeightRequest="220">
                                            <Image Source="{Binding AttachmentPreviewLocalPath}" Aspect="AspectFill"
                                                   HorizontalOptions="Fill" VerticalOptions="Fill"
                                                   IsVisible="{Binding HasLocalImagePreview}"
                                                   Loaded="ImagePreviewLoaded">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ImagePreviewClicked" NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                            <ActivityIndicator IsVisible="True" IsRunning="True" WidthRequest="32" HeightRequest="32"
                                                               HorizontalOptions="Center" VerticalOptions="Center" Color="#2F80ED">
                                                <ActivityIndicator.Triggers>
                                                    <DataTrigger TargetType="ActivityIndicator" Binding="{Binding HasLocalImagePreview}" Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </ActivityIndicator.Triggers>
                                            </ActivityIndicator>
                                        </Grid>
                                    </Border>

                                    <!-- VIDEO ATTACHMENT: downloaded locally first, then previewed from a local thumbnail -->
                                    <Border IsVisible="{Binding IsVideoAttachment}" Padding="0" BackgroundColor="#0F172A"
                                            Loaded="VideoAttachmentLoaded" Stroke="#C9DCF3" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                        <Grid HeightRequest="220">
                                            <Image Source="{Binding AttachmentPreviewLocalPath}" Aspect="AspectFill"
                                                   HorizontalOptions="Fill" VerticalOptions="Fill"
                                                   IsVisible="{Binding HasLocalAttachmentPreview}" />
                                            <BoxView Color="#33000000" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                            <ActivityIndicator IsRunning="True" WidthRequest="34" HeightRequest="34"
                                                               HorizontalOptions="Center" VerticalOptions="Center" Color="White">
                                                <ActivityIndicator.Triggers>
                                                    <DataTrigger TargetType="ActivityIndicator" Binding="{Binding HasLocalAttachmentPreview}" Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </ActivityIndicator.Triggers>
                                            </ActivityIndicator>
                                            <Border WidthRequest="62" HeightRequest="62" BackgroundColor="#CC2F80ED"
                                                    HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="31" /></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="VideoPreviewTapped" NumberOfTapsRequired="1" />
                                                </Border.GestureRecognizers>
                                                <Label Text="▶" FontSize="25" TextColor="White"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <Border HorizontalOptions="Fill" VerticalOptions="End" Padding="10,8"
                                                    BackgroundColor="#990B0F14" StrokeThickness="0">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Label Text="فيديو" FontSize="11" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" />
                                                    <Label Grid.Column="1" Text="{Binding AttachmentFileName}" FontSize="9.5" TextColor="#D8E2EE"
                                                           MaxLines="1" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                                    <Button Grid.Column="2" Text="▶" FontSize="14" WidthRequest="40" HeightRequest="40"
                                                            Padding="0" BackgroundColor="#2F80ED" TextColor="White" CornerRadius="20"
                                                            VerticalOptions="Center" Clicked="VideoPreviewClicked" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- FILE -->
                                    <Border IsVisible="{Binding IsAttachment}" Padding="8" BackgroundColor="#F4F8FD" Loaded="FileAttachmentLoaded"
                                            Stroke="#DCE6F1" StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AttachmentTapped" NumberOfTapsRequired="1" />
                                        </Border.GestureRecognizers>
                                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAudioAttachment}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsImageAttachment}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsVideoAttachment}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/mp4"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/webm"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/quicktime"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/3gpp"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/3gpp2"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/x-matroska"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/mpeg"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/ogg"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="38,*" ColumnSpacing="8">
                                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#EAF3FF" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                <Image Source="icon_attachment.png" WidthRequest="19" HeightRequest="19" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding AttachmentFileName}" FontSize="11.5" FontAttributes="Bold"
                                                       TextColor="#172033" MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Text="مرفق" FontSize="9.5" TextColor="#718096" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- AUDIO -->
                                    <Border IsVisible="{Binding IsAudioAttachment}" Padding="7,6"
                                            BackgroundColor="#F7FBFF" Stroke="#CFE2F8" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="9" HeightRequest="50">
                                            <Button Grid.Column="0" Text="▶" FontSize="13" WidthRequest="40" HeightRequest="40"
                                                    Padding="0" BackgroundColor="#2F80ED" TextColor="#FFFFFF" CornerRadius="20"
                                                    VerticalOptions="Center" Clicked="AudioClicked" />

                                            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="3" VerticalOptions="Center">
                                                <HorizontalStackLayout Grid.Row="0" Spacing="2.5" VerticalOptions="Center">
                                                    <BoxView WidthRequest="3" HeightRequest="10" CornerRadius="2" Color="#B7D5F5" />
                                                    <BoxView WidthRequest="3" HeightRequest="18" CornerRadius="2" Color="#8CB8EF" />
                                                    <BoxView WidthRequest="3" HeightRequest="26" CornerRadius="2" Color="#2F80ED" />
                                                    <BoxView WidthRequest="3" HeightRequest="15" CornerRadius="2" Color="#5D9FEB" />
                                                    <BoxView WidthRequest="3" HeightRequest="22" CornerRadius="2" Color="#2F80ED" />
                                                    <BoxView WidthRequest="3" HeightRequest="30" CornerRadius="2" Color="#2F80ED" />
                                                    <BoxView WidthRequest="3" HeightRequest="17" CornerRadius="2" Color="#6FA9EE" />
                                                    <BoxView WidthRequest="3" HeightRequest="24" CornerRadius="2" Color="#2F80ED" />
                                                    <BoxView WidthRequest="3" HeightRequest="12" CornerRadius="2" Color="#9CC3F0" />
                                                    <BoxView WidthRequest="3" HeightRequest="20" CornerRadius="2" Color="#6FA9EE" />
                                                    <BoxView WidthRequest="3" HeightRequest="28" CornerRadius="2" Color="#2F80ED" />
                                                    <BoxView WidthRequest="3" HeightRequest="14" CornerRadius="2" Color="#A5C8F2" />
                                                </HorizontalStackLayout>
                                                <BoxView Grid.Row="1" HeightRequest="2" CornerRadius="1" Color="#D7E7F8" HorizontalOptions="Fill" />
                                            </Grid>

                                            <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center" HorizontalOptions="End">
                                                <Label Text="صوت" FontSize="9" TextColor="#718096" HorizontalTextAlignment="Center" />
                                                <Label Text="♪" FontSize="15" TextColor="#7C96B5" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- TEXT -->
                                    <Label Text="{Binding Text}" FontSize="16" LineHeight="1.12" TextColor="#172033" LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasLocalImagePreview}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAttachment}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAudioAttachment}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- TIME / STATUS -->
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                                        <Label Text="{Binding EditedLabel}" Style="{StaticResource Meta}" VerticalOptions="Center" />
                                        <Label Text="{Binding SentAt, StringFormat='{0:HH:mm}'}" Style="{StaticResource Meta}" VerticalOptions="Center" />
                                        <Label FontSize="11" VerticalOptions="Center" Text="{Binding DeliveryStatusText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsPending}" Value="True">
                                                    <Setter Property="Text" Value="◷" /><Setter Property="TextColor" Value="#2F80ED" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="read">
                                                    <Setter Property="TextColor" Value="#2F80ED" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="failed">
                                                    <Setter Property="Text" Value="!" /><Setter Property="TextColor" Value="#D92D3E" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="Margin" Value="34,0,0,0" />
                                        <Setter Property="BackgroundColor" Value="#DDEEFF" />
                                        <Setter Property="Stroke" Value="#BBD8F8" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="#2F80ED" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="ScrollToBottomButton" Text="↓" IsVisible="False" HorizontalOptions="End"
                    VerticalOptions="End" Margin="0,0,5,12" WidthRequest="42" HeightRequest="42"
                    CornerRadius="21" BackgroundColor="#FFFFFF" TextColor="#2F80ED" FontSize="18"
                    FontAttributes="Bold" Clicked="ScrollToBottomClicked" BorderWidth="1" BorderColor="#D6E4F2" />

            <VerticalStackLayout x:Name="EmptyState" IsVisible="False" HorizontalOptions="Center"
                                 VerticalOptions="Center" Spacing="9" Padding="28">
                <Border WidthRequest="60" HeightRequest="60" BackgroundColor="#EAF3FF" Stroke="#CFE2FB" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
                    <Image Source="himo_phase1_icon_chat_empty.png" WidthRequest="28" HeightRequest="28" />
                </Border>
                <Label Text="لا توجد رسائل بعد" FontSize="18" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="#172033" />
                <Label Text="ابدأ المحادثة بإرسال أول رسالة" FontSize="13"
                       HorizontalTextAlignment="Center" TextColor="#718096" />
            </VerticalStackLayout>
        </Grid>

        <!-- COMPOSER -->
        <Border Grid.Row="3" Margin="12,6,12,12" Padding="6,6" BackgroundColor="#FFFFFF"
                Stroke="#DDE7F2" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Grid x:Name="ReplyPreview" IsVisible="False" Padding="9,5" ColumnDefinitions="*,Auto" BackgroundColor="#F4F8FD">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="رد على رسالة" FontSize="10" FontAttributes="Bold" TextColor="#2F80ED" />
                        <Label x:Name="ReplyPreviewLabel" FontSize="11" TextColor="#718096" MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="×" FontSize="18" WidthRequest="32" HeightRequest="32"
                            Padding="0" BackgroundColor="Transparent" TextColor="#2F80ED" Clicked="ClearReplyClicked" />
                </Grid>
                <Grid x:Name="RecordingBar" IsVisible="False" Padding="9,3" ColumnDefinitions="Auto,*,Auto">
                    <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#EF4444" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="جارٍ تسجيل رسالة صوتية..." FontSize="11.5" FontAttributes="Bold"
                           TextColor="#172033" VerticalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="اضغط لإيقاف التسجيل" FontSize="9.5" TextColor="#718096" VerticalTextAlignment="Center" />
                </Grid>
                <!-- ATTACHMENT / MEDIA PANEL -->
                <Border x:Name="AttachmentPanel" IsVisible="False" Margin="2,3,2,4"
                        BackgroundColor="#F7FAFD" Stroke="#E2EAF3" StrokeThickness="1"
                        Padding="8,7">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" HeightRequest="86">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <ImageButton Source="himo_icon_camera.png" WidthRequest="42" HeightRequest="42" Padding="9"
                                         BackgroundColor="#EAF3FF" CornerRadius="21" Clicked="CameraPanelClicked" />
                            <Label Text="الكاميرا" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Button Text="🖼" FontSize="22" WidthRequest="42" HeightRequest="42" Padding="0"
                                    BackgroundColor="#EAF3FF" TextColor="#2F80ED" CornerRadius="21" Clicked="PickPhotoClicked" />
                            <Label Text="الصور" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Button Text="▶" FontSize="18" WidthRequest="42" HeightRequest="42" Padding="0"
                                    BackgroundColor="#EAF3FF" TextColor="#2F80ED" CornerRadius="21" Clicked="PickVideoClicked" />
                            <Label Text="الفيديو" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                            <ImageButton Source="himo_icon_attachment.png" WidthRequest="42" HeightRequest="42" Padding="9"
                                         BackgroundColor="#EAF3FF" CornerRadius="21" Clicked="PickFileClicked" />
                            <Label Text="ملف" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="48,48,*,48,48" ColumnSpacing="4" HeightRequest="54">
                    <ImageButton x:Name="RecordButton" Grid.Column="0" Source="himo_icon_mic.png"
                                 Style="{StaticResource ComposerButton}" Clicked="RecordAudioClicked" />
                    <ImageButton x:Name="CameraButton" Grid.Column="1" Source="himo_icon_camera.png"
                                 Style="{StaticResource ComposerButton}" Clicked="CameraButtonClicked" />
                    <Entry x:Name="MessageEntry" Grid.Column="2" Placeholder="اكتب رسالة..." ReturnType="Send"
                           ClearButtonVisibility="Never" MaxLength="4000" Completed="SendClicked"
                           TextChanged="MessageEntryTextChanged" FontSize="15.5" TextColor="#172033"
                           PlaceholderColor="#94A3B8" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    <ImageButton x:Name="AttachmentButton" Grid.Column="3" Source="himo_icon_attachment.png" Style="{StaticResource ComposerButton}"
                                 Clicked="AttachmentButtonClicked" VerticalOptions="Center" />
                    <ImageButton x:Name="SendButton" Grid.Column="4" Source="himo_icon_send.png"
                                 WidthRequest="46" HeightRequest="46" Padding="10" BackgroundColor="#2F80ED"
                                 CornerRadius="23" Clicked="SendClicked" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
