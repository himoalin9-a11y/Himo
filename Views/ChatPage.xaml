<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Himo.Views.ChatPage"
             x:Name="ChatRoot"
             FlowDirection="RightToLeft"
             BackgroundColor="#F5F6FA"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ChatHeaderButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="38" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="Padding" Value="9" />
                <Setter Property="BackgroundColor" Value="#F7F5FB" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="ComposerButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="9" />
                <Setter Property="BackgroundColor" Value="#F4F1FA" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="ToolbarIconButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="9" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="MediaPlayButton" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="48" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Padding" Value="13" />
                <Setter Property="BackgroundColor" Value="#6C3FD1" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="Meta" TargetType="Label">
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="TextColor" Value="#7A8798" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="68,Auto,*,Auto" BackgroundColor="#F5F6FA">

        <!-- CHAT HEADER -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" Stroke="#E9E7EE" StrokeThickness="1" Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto" FlowDirection="LeftToRight">
                <HorizontalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center" HorizontalOptions="Start">
                    <ImageButton Source="himo_icon_arrow_back_purple.png" Style="{StaticResource ChatHeaderButton}" Clicked="BackClicked" />
                    <ImageButton Source="himo_phase1_icon_more.png" Style="{StaticResource ChatHeaderButton}" Clicked="ConversationOptionsClicked" AutomationId="ConversationMenuButton" />
                    <ImageButton Source="himo_icon_camera.png" Style="{StaticResource ChatHeaderButton}" Clicked="VideoCallClicked" />
                    <ImageButton Source="himo_phase1_icon_call_phone.png" Style="{StaticResource ChatHeaderButton}" Clicked="AudioCallClicked" />
                </HorizontalStackLayout>

                <Grid Grid.Column="2" ColumnDefinitions="58,*" ColumnSpacing="9" VerticalOptions="Center" HorizontalOptions="End">
                    <Grid Grid.Column="0" WidthRequest="50" HeightRequest="50">
                        <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#F3EDF9" Stroke="#D8C8F0" StrokeThickness="1">
                            <Border.StrokeShape><shapes:RoundRectangle CornerRadius="25" /></Border.StrokeShape>
                            <Label x:Name="InitialLabel" Text="H" FontSize="19" FontAttributes="Bold"
                                   TextColor="#6C3FD1" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Ellipse x:Name="StatusDot" WidthRequest="11" HeightRequest="11"
                                 HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,2"
                                 Fill="#28C76F" Stroke="#FFFFFF" StrokeThickness="2" />
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center" MaximumWidthRequest="190" FlowDirection="RightToLeft">
                        <Label x:Name="NameLabel" Text="محادثة" FontSize="16.5" FontAttributes="Bold"
                               TextColor="#2B2235" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label x:Name="StatusLabel" Text="غير متصل" FontSize="11" TextColor="#7B8492" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <!-- SELECTION ACTION BAR -->
        <Border x:Name="SelectionBar" Grid.Row="0" IsVisible="False" ZIndex="50"
                HorizontalOptions="Fill" VerticalOptions="Start"
                HeightRequest="58" Padding="10,4"
                BackgroundColor="#FFFFFF" Stroke="#E5DDF1" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="7" FlowDirection="LeftToRight">
                <!-- More -->
                <ImageButton Grid.Column="0" Source="himo_ui_more.png" Style="{StaticResource ToolbarIconButton}"
                             HeightRequest="46" WidthRequest="42" Padding="11" />

                <!-- Share / Forward -->
                <ImageButton Grid.Column="1" Source="himo_ui_share.png" Style="{StaticResource ToolbarIconButton}"
                             HeightRequest="46" WidthRequest="42" Padding="10"
                             Clicked="ShareSelectedClicked" />

                <!-- Delete -->
                <ImageButton Grid.Column="2" Source="himo_ui_delete.png" Style="{StaticResource ToolbarIconButton}"
                             HeightRequest="46" WidthRequest="42" Padding="10"
                             Clicked="DeleteSelectedClicked" />

                <!-- Comment / Reply -->
                <ImageButton Grid.Column="3" Source="himo_ui_reply.png" Style="{StaticResource ToolbarIconButton}"
                             HeightRequest="46" WidthRequest="42" Padding="10"
                             Clicked="CommentSelectedClicked" />

                <!-- Selected count -->
                <Label Grid.Column="5" x:Name="SelectionCountLabel" Text="1"
                       FontSize="16.5" FontAttributes="Bold" TextColor="#5B3CC4"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                       WidthRequest="42" />

            </Grid>
        </Border>

        <!-- INLINE VIDEO PLAYER -->
        <Grid x:Name="InlineVideoOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="200"
              BackgroundColor="#000000" HorizontalOptions="Fill" VerticalOptions="Fill">
            <ContentView x:Name="InlineVideoHost"
                         HorizontalOptions="Fill" VerticalOptions="Fill"
                         BackgroundColor="#000000" />

            <ActivityIndicator x:Name="InlineVideoLoading"
                               IsVisible="False"
                               IsRunning="True"
                               Color="White"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               ZIndex="8" />

            <!-- Top bar -->
            <Border HorizontalOptions="Fill" VerticalOptions="Start"
                    Padding="14,10,12,10"
                    BackgroundColor="#B20B0F14"
                    StrokeThickness="0"
                    ZIndex="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="InlineVideoTitleLabel"
                               Text="الفيديو"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Start"
                               LineBreakMode="TailTruncation" />
                        <Label Text="مشغل الفيديو"
                               FontSize="10.5"
                               TextColor="#BFC9D5"
                               VerticalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="×"
                            WidthRequest="42" HeightRequest="42"
                            Padding="0" FontSize="26" FontAttributes="Bold"
                            BackgroundColor="#4DFFFFFF" TextColor="White"
                            CornerRadius="21" Clicked="CloseInlineVideoClicked" />
                </Grid>
            </Border>

            <!-- Center play/pause control -->
            <Button x:Name="InlineVideoCenterPlayButton"
                    Text="▶"
                    WidthRequest="76" HeightRequest="76"
                    Padding="0"
                    FontSize="28" FontAttributes="Bold"
                    BackgroundColor="#A66C3FD1" TextColor="White"
                    CornerRadius="38"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    ZIndex="7" Clicked="InlineVideoPlayClicked" />

            <!-- Bottom transport controls -->
            <Border HorizontalOptions="Fill" VerticalOptions="End"
                    Padding="14,10,14,14"
                    BackgroundColor="#D90B0F14"
                    StrokeThickness="0"
                    ZIndex="10">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label x:Name="InlineVideoCurrentTimeLabel"
                               Grid.Column="0" Text="00:00" FontSize="11.5"
                               TextColor="#F1F5F9" VerticalTextAlignment="Center" />
                        <Slider x:Name="InlineVideoSlider"
                                Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                                HeightRequest="26" ThumbColor="White"
                                MinimumTrackColor="#8B5CF6"
                                MaximumTrackColor="#73808C"
                                ValueChanged="InlineVideoSliderValueChanged" />
                        <Label x:Name="InlineVideoDurationLabel"
                               Grid.Column="2" Text="00:00" FontSize="11.5"
                               TextColor="#F1F5F9" VerticalTextAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,*"
                          ColumnSpacing="10" HorizontalOptions="Center">
                        <Button x:Name="InlineVideoRewindButton"
                                Grid.Column="1" Text="↶ 10"
                                WidthRequest="62" HeightRequest="42" Padding="0"
                                FontSize="11" FontAttributes="Bold"
                                BackgroundColor="#3A4450" TextColor="White"
                                CornerRadius="21" Clicked="InlineVideoRewindClicked" />
                        <Button x:Name="InlineVideoPlayButton"
                                Grid.Column="2" Text="▶"
                                WidthRequest="50" HeightRequest="50" Padding="0"
                                FontSize="18" FontAttributes="Bold"
                                BackgroundColor="#6C3FD1" TextColor="White"
                                CornerRadius="25" Clicked="InlineVideoPlayClicked" />
                        <Button x:Name="InlineVideoForwardButton"
                                Grid.Column="3" Text="10 ↷"
                                WidthRequest="62" HeightRequest="42" Padding="0"
                                FontSize="11" FontAttributes="Bold"
                                BackgroundColor="#3A4450" TextColor="White"
                                CornerRadius="21" Clicked="InlineVideoForwardClicked" />
                        <Button x:Name="InlineVideoMuteButton"
                                Grid.Column="4" Text="🔊"
                                WidthRequest="48" HeightRequest="42" Padding="0"
                                FontSize="17" BackgroundColor="#3A4450" TextColor="White"
                                CornerRadius="21" Clicked="InlineVideoMuteClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MESSAGES -->
        <Grid Grid.Row="2" Padding="12,6,12,0">
            <Image Source="himo_phase1_login_waves.png" Aspect="AspectFill" Opacity="0.035" HeightRequest="190"
                   VerticalOptions="End" HorizontalOptions="Fill" InputTransparent="True" />

            <Border x:Name="UnreadDivider" IsVisible="False" ZIndex="3" HorizontalOptions="Center"
                    VerticalOptions="Start" Margin="0,4,0,0" Padding="14,6"
                    BackgroundColor="#FFFFFF" Stroke="#CFE2FB" StrokeThickness="1">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Label Text="رسائل جديدة" FontSize="11" FontAttributes="Bold" TextColor="#6C3FD1" />
            </Border>

            <Border x:Name="MessageSearchBar" IsVisible="False" ZIndex="10" HorizontalOptions="Fill"
                    VerticalOptions="Start" Padding="7" BackgroundColor="#FFFFFF" Stroke="#D8E5F2" StrokeThickness="1">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                    <SearchBar x:Name="MessageSearchEntry" Grid.Column="0" Placeholder="بحث في الرسائل..."
                               FontSize="13.5" TextColor="#2B2235" PlaceholderColor="#94A3B8"
                               BackgroundColor="Transparent" SearchButtonPressed="MessageSearchChanged"
                               TextChanged="MessageSearchChanged" />
                    <ImageButton Grid.Column="1" Source="himo_ui_close.png" WidthRequest="36" HeightRequest="36" Padding="10"
                                 CornerRadius="18" BackgroundColor="#F2EBFA" Clicked="CloseMessageSearchClicked" />
                </Grid>
            </Border>

            <CollectionView x:Name="Messages" SelectionMode="None" VerticalScrollBarVisibility="Never"
                            Loaded="MessagesLoaded" Scrolled="MessagesScrolled" BackgroundColor="Transparent"
                            Margin="0,3,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <VerticalStackLayout Spacing="5" Padding="0,2">
                            <!-- DATE -->
                            <Grid IsVisible="{Binding HasDateSeparator}" ColumnDefinitions="*,Auto,*" Margin="8,8">
                                <BoxView Grid.Column="0" HeightRequest="1" Color="#DCE6F1" VerticalOptions="Center" Margin="0,0,9,0" />
                                <Border Grid.Column="1" Padding="12,5" BackgroundColor="#FFFFFF" Stroke="#E5DFEA" StrokeThickness="1">
                                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                    <Label Text="{Binding DateSeparatorText}" FontSize="10.5" FontAttributes="Bold" TextColor="#806A97" HorizontalTextAlignment="Center" />
                                </Border>
                                <BoxView Grid.Column="2" HeightRequest="1" Color="#DCE6F1" VerticalOptions="Center" Margin="9,0,0,0" />
                            </Grid>

                            <Border MaximumWidthRequest="350" Padding="10,8,10,6"
                                    HorizontalOptions="End" Margin="34,1,0,1" BackgroundColor="#FFFFFF"
                                    Stroke="#E7E2EC" StrokeThickness="1"
                                    Loaded="MessageBubbleLoaded">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="5">

                                    <!-- REPLY -->
                                    <Border IsVisible="{Binding HasReply}" Padding="9,6" BackgroundColor="#F8F5FC"
                                            Stroke="#E6DDF0" StrokeThickness="1">
                                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                        <Label Text="{Binding ReplyToText}" FontSize="10.5" TextColor="#718096"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                    </Border>

                                    <!-- IMAGE ATTACHMENT: fixed media frame matching the video card size -->
                                    <Border IsVisible="{Binding IsImageAttachment}"
                                            BackgroundColor="Transparent"
                                            Stroke="#2196F3" StrokeThickness="4" Padding="0" Margin="0,1"
                                            HorizontalOptions="Start" VerticalOptions="Start"
                                            WidthRequest="300" HeightRequest="260"
                                            MaximumWidthRequest="300" MaximumHeightRequest="260">
                                        <Border.StrokeShape>
                                            <shapes:RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid WidthRequest="300" HeightRequest="260"
                                              HorizontalOptions="Fill" VerticalOptions="Fill">
                                            <Border Padding="0" BackgroundColor="Transparent"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Fill" VerticalOptions="Fill">
                                                <Border.StrokeShape>
                                                    <shapes:RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding AttachmentLocalPath}"
                                                       Aspect="AspectFit"
                                                       WidthRequest="300" HeightRequest="260"
                                                       MaximumWidthRequest="300" MaximumHeightRequest="260"
                                                       HorizontalOptions="Fill" VerticalOptions="Fill"
                                                       IsVisible="{Binding HasLocalImagePreview}" />
                                            </Border>

                                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                                                 Spacing="5" Margin="12" IsVisible="False"
                                                                 MaximumWidthRequest="260" MaximumHeightRequest="220">
                                                <VerticalStackLayout.Triggers>
                                                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding HasLocalImagePreview}" Value="False">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </VerticalStackLayout.Triggers>
                                                <Image Source="himo_ui_gallery.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
                                                <Label Text="صورة" FontSize="12" FontAttributes="Bold" TextColor="#2B2235" HorizontalTextAlignment="Center" />
                                                <Label Text="اضغط للعرض" FontSize="9.5" TextColor="#718096" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding AttachmentFileName}" FontSize="8.5" TextColor="#8A98AA" MaxLines="1" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="ImagePreviewCardTapped" NumberOfTapsRequired="1" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Border>

                                    <!-- VIDEO ATTACHMENT: WhatsApp-style natural preview -->
                                    <Border IsVisible="{Binding IsVideoAttachment}"
                                            Padding="0" Margin="0,2" BackgroundColor="Transparent"
                                            Stroke="#2196F3" StrokeThickness="4"
                                            HorizontalOptions="Start" VerticalOptions="Start"
                                            Loaded="VideoAttachmentLoaded">
                                        <Border.StrokeShape>
                                            <shapes:RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid WidthRequest="{Binding VideoDisplayWidth}"
                                              HeightRequest="{Binding VideoDisplayHeight}"
                                              HorizontalOptions="Start" VerticalOptions="Start">
                                            <Grid BackgroundColor="#17141D"
                                                  IsVisible="True">
                                                <Image Source="himo_ui_video.png" WidthRequest="34" HeightRequest="34"
                                                       Opacity="0.88" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Image.Triggers>
                                                        <DataTrigger TargetType="Image" Binding="{Binding HasVideoPreview}" Value="True">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Image.Triggers>
                                                </Image>
                                            </Grid>

                                            <Image Source="{Binding VideoThumbnailPath}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="{Binding VideoDisplayWidth}"
                                                   HeightRequest="{Binding VideoDisplayHeight}"
                                                   HorizontalOptions="Fill" VerticalOptions="Fill"
                                                   IsVisible="{Binding HasVideoPreview}" />

                                            <BoxView BackgroundColor="#000000" Opacity="0.10"
                                                     HorizontalOptions="Fill" VerticalOptions="Fill" />

                                            <Border WidthRequest="62" HeightRequest="62"
                                                    BackgroundColor="#80000000" StrokeThickness="0"
                                                    HorizontalOptions="Center" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <shapes:RoundRectangle CornerRadius="31" />
                                                </Border.StrokeShape>
                                                <Image Source="himo_ui_play_white.png" WidthRequest="28" HeightRequest="28"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>

                                            <Border HorizontalOptions="Start" VerticalOptions="End"
                                                    Margin="10" Padding="7,3" BackgroundColor="#99000000"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <shapes:RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="5">
                                                    <Image Source="himo_ui_video.png" WidthRequest="13" HeightRequest="13" />
                                                    <Label Text="{Binding VideoDurationText}" FontSize="10.5" TextColor="White"
                                                           VerticalTextAlignment="Center" />
                                                </HorizontalStackLayout>
                                            </Border>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="VideoPreviewClicked" NumberOfTapsRequired="1" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Border>

                                    <!-- FILE -->
                                    <Border IsVisible="{Binding IsAttachment}" Padding="8" BackgroundColor="#F8F4FC" Loaded="FileAttachmentLoaded"
                                            Stroke="#E4DAEC" StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AttachmentTapped" NumberOfTapsRequired="1" />
                                        </Border.GestureRecognizers>
                                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAudioAttachment}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsImageAttachment}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/mp4"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/webm"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/quicktime"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/3gpp"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/3gpp2"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/x-matroska"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/mpeg"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding AttachmentContentType}" Value="video/ogg"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="38,*" ColumnSpacing="8">
                                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#F2EBFA" StrokeThickness="0">
                                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                <Image Source="icon_attachment.png" WidthRequest="19" HeightRequest="19" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding AttachmentFileName}" FontSize="11.5" FontAttributes="Bold"
                                                       TextColor="#2B2235" MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Text="مرفق" FontSize="9.5" TextColor="#718096" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- AUDIO -->
                                    <Border IsVisible="{Binding IsAudioAttachment}" Padding="7,5" Margin="0,2"
                                            BackgroundColor="Transparent" StrokeThickness="0">
                                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="StrokeThickness" Value="0" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="11" HeightRequest="56">
                                            <ImageButton Grid.Column="0" Source="himo_ui_play_white.png" WidthRequest="48" HeightRequest="48"
                                                         Padding="13" BackgroundColor="#6C3FD1" CornerRadius="24"
                                                         VerticalOptions="Center" Clicked="AudioClicked">
                                                <ImageButton.Triggers>
                                                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="White" />
                                                        <Setter Property="Source" Value="himo_ui_play_purple.png" />
                                                    </DataTrigger>
                                                </ImageButton.Triggers>
                                            </ImageButton>

                                            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="3" VerticalOptions="Center">
                                                <HorizontalStackLayout Grid.Row="0" Spacing="3" VerticalOptions="Center">
                                                    <BoxView WidthRequest="2.5" HeightRequest="10" CornerRadius="2" Color="#C8B3E8" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="18" CornerRadius="2" Color="#9C7FD0" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="26" CornerRadius="2" Color="#6C3FD1" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="15" CornerRadius="2" Color="#8C69C5" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="22" CornerRadius="2" Color="#6C3FD1" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="30" CornerRadius="2" Color="#6C3FD1" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="17" CornerRadius="2" Color="#A17DD5" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="24" CornerRadius="2" Color="#6C3FD1" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="12" CornerRadius="2" Color="#B89CE1" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="20" CornerRadius="2" Color="#A17DD5" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="28" CornerRadius="2" Color="#6C3FD1" />
                                                    <BoxView WidthRequest="2.5" HeightRequest="14" CornerRadius="2" Color="#C0AAE3" />
                                                </HorizontalStackLayout>
                                                <BoxView Grid.Row="1" HeightRequest="2" CornerRadius="1" Color="#E6D9F1" HorizontalOptions="Fill" />
                                            </Grid>

                                            <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center" HorizontalOptions="End">
                                                <Label Text="صوت" FontSize="9" TextColor="#718096" HorizontalTextAlignment="Center">
                                                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True"><Setter Property="TextColor" Value="#F0E8FB" /></DataTrigger></Label.Triggers>
                                                </Label>
                                                <Label Text="♪" FontSize="15" TextColor="#7C96B5" HorizontalTextAlignment="Center">
                                                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True"><Setter Property="TextColor" Value="#E1D2F4" /></DataTrigger></Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- TEXT -->
                                    <Label Text="{Binding Text}" FontSize="16" LineHeight="1.16" TextColor="#2B2235" LineBreakMode="WordWrap"
                                           Margin="1,1,1,0">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasLocalImagePreview}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAttachment}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAudioAttachment}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- TIME / STATUS -->
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                                        <Label Text="{Binding EditedLabel}" Style="{StaticResource Meta}" VerticalOptions="Center">
                                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True"><Setter Property="TextColor" Value="#E9DCFF" /></DataTrigger></Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding SentAt, StringFormat='{0:HH:mm}'}" Style="{StaticResource Meta}" VerticalOptions="Center">
                                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True"><Setter Property="TextColor" Value="#E9DCFF" /></DataTrigger></Label.Triggers>
                                        </Label>
                                        <Label FontSize="10.5" FontAttributes="Bold" VerticalOptions="Center" Text="✓" IsVisible="False">
                                            <Label.Triggers>
                                                <!-- Delivery state belongs only to messages sent by this user. -->
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="IsVisible" Value="True" />
                                                    <Setter Property="TextColor" Value="#E9DCFF" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsPending}" Value="True">
                                                    <Setter Property="Text" Value="◷" />
                                                    <Setter Property="TextColor" Value="#E8D8FF" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="sent">
                                                    <Setter Property="Text" Value="✓" />
                                                    <Setter Property="TextColor" Value="#E9DCFF" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="delivered">
                                                    <Setter Property="Text" Value="✓✓" />
                                                    <Setter Property="TextColor" Value="#E9DCFF" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="read">
                                                    <Setter Property="Text" Value="✓✓" />
                                                    <Setter Property="TextColor" Value="#62B0FF" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding DeliveryStatus}" Value="failed">
                                                    <Setter Property="Text" Value="!" />
                                                    <Setter Property="TextColor" Value="#FFB4BD" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="Margin" Value="24,1,0,1" />
                                        <Setter Property="BackgroundColor" Value="#6C3FD1" />
                                        <Setter Property="Stroke" Value="#6C3FD1" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsImageAttachment}" Value="True">
                                        <Setter Property="StrokeThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAudioAttachment}" Value="True">
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsVideoAttachment}" Value="True">
                                        <Setter Property="StrokeThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="#A07BE0" />
                                        <Setter Property="StrokeThickness" Value="2.2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ContentView x:Name="HiddenAudioPlayerHost" Grid.RowSpan="4"
                         WidthRequest="1" HeightRequest="1"
                         HorizontalOptions="Start" VerticalOptions="Start"
                         Opacity="0.01" InputTransparent="True" IsVisible="True"
                         ZIndex="1" />

            <ImageButton x:Name="ScrollToBottomButton" Source="himo_ui_scroll_down.png" IsVisible="False" HorizontalOptions="End"
                         VerticalOptions="End" Margin="0,0,5,12" WidthRequest="44" HeightRequest="44" Padding="12"
                         BackgroundColor="#FFFFFF" CornerRadius="22" Clicked="ScrollToBottomClicked"
                         BorderWidth="1" BorderColor="#E0D3EA" />

            <VerticalStackLayout x:Name="EmptyState" IsVisible="False" HorizontalOptions="Center"
                                 VerticalOptions="Center" Spacing="9" Padding="28">
                <Border WidthRequest="60" HeightRequest="60" BackgroundColor="#F0E8FA" Stroke="#D8C8F0" StrokeThickness="1">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="31" /></Border.StrokeShape>
                    <Image Source="himo_phase1_icon_chat_empty.png" WidthRequest="28" HeightRequest="28" />
                </Border>
                <Label Text="لا توجد رسائل بعد" FontSize="16.5" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="#2B2235" />
                <Label Text="ابدأ المحادثة بإرسال أول رسالة" FontSize="13"
                       HorizontalTextAlignment="Center" TextColor="#718096" />
            </VerticalStackLayout>
        </Grid>

        <!-- COMPOSER -->
        <Border Grid.Row="3" Margin="8,4,8,7" Padding="6,5" BackgroundColor="#FFFFFF"
                Stroke="#E1E4EA" StrokeThickness="1">
            <Border.StrokeShape><shapes:RoundRectangle CornerRadius="25" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Grid x:Name="ReplyPreview" IsVisible="False" Padding="9,5" ColumnDefinitions="*,Auto" BackgroundColor="#F8F4FC">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="رد على رسالة" FontSize="10" FontAttributes="Bold" TextColor="#6C3FD1" />
                        <Label x:Name="ReplyPreviewLabel" FontSize="11" TextColor="#718096" MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="himo_ui_close.png" WidthRequest="32" HeightRequest="32" Padding="9"
                                 BackgroundColor="Transparent" Clicked="ClearReplyClicked" />
                </Grid>
                <Grid x:Name="RecordingBar" IsVisible="False" Padding="9,3" ColumnDefinitions="Auto,*,Auto">
                    <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#EF4444" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="جارٍ تسجيل رسالة صوتية..." FontSize="11.5" FontAttributes="Bold"
                           TextColor="#2B2235" VerticalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="اضغط لإيقاف التسجيل" FontSize="9.5" TextColor="#718096" VerticalTextAlignment="Center" />
                </Grid>
                <!-- ATTACHMENT / MEDIA PANEL -->
                <Border x:Name="AttachmentPanel" IsVisible="False" Margin="2,4,2,5"
                        BackgroundColor="#FFFFFF" Stroke="#E7E2EF" StrokeThickness="1"
                        Padding="10,9">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="إرسال وسائط" FontSize="12" FontAttributes="Bold" TextColor="#2B2235" />
                                <Label Text="اختر ما تريد إرساله" FontSize="9.5" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" WidthRequest="28" HeightRequest="2" CornerRadius="1" Color="#E7E2EF" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" HeightRequest="76">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <ImageButton Source="himo_icon_camera.png" WidthRequest="42" HeightRequest="42" Padding="9"
                                         BackgroundColor="#F2EBFA" CornerRadius="21" Clicked="CameraPanelClicked" />
                            <Label Text="الكاميرا" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <ImageButton Source="himo_ui_gallery.png" WidthRequest="42" HeightRequest="42" Padding="10"
                                         BackgroundColor="#F2EBFA" CornerRadius="21" Clicked="PickPhotoClicked" />
                            <Label Text="الصور" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <ImageButton Source="himo_ui_video.png" WidthRequest="42" HeightRequest="42" Padding="10"
                                         BackgroundColor="#F2EBFA" CornerRadius="21" Clicked="PickVideoClicked" />
                            <Label Text="الفيديو" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                            <ImageButton Source="himo_icon_attachment.png" WidthRequest="42" HeightRequest="42" Padding="9"
                                         BackgroundColor="#F2EBFA" CornerRadius="21" Clicked="PickFileClicked" />
                            <Label Text="ملف" FontSize="10" TextColor="#526273" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="44,44,*,44,44" ColumnSpacing="4" HeightRequest="48">
                    <ImageButton x:Name="RecordButton" Grid.Column="0" Source="himo_icon_mic.png"
                                 Style="{StaticResource ComposerButton}" Clicked="RecordAudioClicked" />
                    <ImageButton x:Name="CameraButton" Grid.Column="1" Source="himo_icon_camera.png"
                                 Style="{StaticResource ComposerButton}" Clicked="CameraButtonClicked" />
                    <Entry x:Name="MessageEntry" Grid.Column="2" Placeholder="اكتب رسالة..." ReturnType="Send"
                           ClearButtonVisibility="Never" MaxLength="4000" Completed="SendClicked"
                           TextChanged="MessageEntryTextChanged" FontSize="14" TextColor="#2B2235" BackgroundColor="#F7F6FA"
                           PlaceholderColor="#94A3B8" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    <ImageButton x:Name="AttachmentButton" Grid.Column="3" Source="himo_icon_attachment.png" Style="{StaticResource ComposerButton}"
                                 Clicked="AttachmentButtonClicked" VerticalOptions="Center" />
                    <ImageButton x:Name="SendButton" Grid.Column="4" Source="himo_icon_send.png"
                                 WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="#6C3FD1"
                                 CornerRadius="22" Clicked="SendClicked" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
