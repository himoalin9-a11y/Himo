<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Himo.Models"
             x:Class="Himo.Views.ChatPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F7F4FC"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Premium chat header -->
        <Border StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="12,10,12,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,20,20" />
            </Border.StrokeShape>
            <Grid RowDefinitions="3,Auto" RowSpacing="7">
                <BoxView Grid.Row="0" HeightRequest="3" CornerRadius="2" BackgroundColor="#7042A5" Opacity="0.9" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Text="‹" FontSize="36" WidthRequest="44" HeightRequest="44" Padding="0"
                        BackgroundColor="#F3EEFB" TextColor="#5B3A8E" CornerRadius="22"
                        Clicked="BackClicked" SemanticProperties.Description="العودة إلى المحادثات" />

                <Grid Grid.Column="1" ColumnDefinitions="56,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#EEE5FA" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                        <Label x:Name="InitialLabel" Text="" FontSize="20" FontAttributes="Bold"
                               TextColor="#7042A5" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label x:Name="NameLabel" FontSize="18" FontAttributes="Bold"
                               TextColor="#2E2140" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#7A56B3" VerticalOptions="Center" />
                            <Label Text="متصل الآن" FontSize="12" TextColor="#8A7B9C" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <Button Grid.Column="2" Text="⋮" FontSize="28" WidthRequest="44" HeightRequest="44" Padding="0"
                        BackgroundColor="#F3EEFB" TextColor="#5B3A8E" CornerRadius="22"
                        SemanticProperties.Description="خيارات المحادثة" />
                </Grid>
            </Grid>
        </Border>

        <!-- Messages -->
        <Grid Grid.Row="1" Padding="12,12,12,4">
            <CollectionView x:Name="Messages" SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Padding="2,4" ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0" Margin="0,0,54,0" Padding="13,10"
                                    MaximumWidthRequest="330" HorizontalOptions="Start"
                                    BackgroundColor="#FFFFFF" Stroke="#E8E0F1" StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="19,19,19,7" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Border IsVisible="False" HeightRequest="190" WidthRequest="285" StrokeThickness="0"
                                            BackgroundColor="#EEF4FB">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                        <Image Source="{Binding AttachmentLocalPath}" Aspect="AspectFill" SemanticProperties.Description="معاينة صورة مرفقة" />
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsImageAttachment}" Value="True">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <Label Text="{Binding Text}" FontSize="15" LineHeight="1.15" TextColor="#2E2140">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <HorizontalStackLayout Spacing="7" HorizontalOptions="Start">
                                        <Button Text="▶ تشغيل الصوت" SemanticProperties.Description="تشغيل الرسالة الصوتية"
                                                IsVisible="{Binding IsAudioAttachment}" FontSize="12" Padding="8,2" HeightRequest="30"
                                                BackgroundColor="Transparent" TextColor="#7042A5" Clicked="AudioClicked" />
                                        <Button Text="فتح المرفق" SemanticProperties.Description="فتح المرفق"
                                                IsVisible="{Binding IsAttachment}" FontSize="12" Padding="8,2" HeightRequest="30"
                                                BackgroundColor="Transparent" TextColor="#7042A5" Clicked="AttachmentClicked" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding SentAt, StringFormat='{0:HH:mm}'}" FontSize="9"
                                           TextColor="#988BA6" HorizontalOptions="End">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="#D8E8FF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="Margin" Value="54,0,0,0" />
                                        <Setter Property="BackgroundColor" Value="#1670E8" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout x:Name="EmptyState" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="9" Padding="30">
                <Border WidthRequest="82" HeightRequest="82" BackgroundColor="#EEE5FA" StrokeThickness="0" HorizontalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="41" /></Border.StrokeShape>
                    <Label Text="💬" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="لا توجد رسائل بعد" FontSize="20" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="#2E2140" />
                <Label Text="ابدأ المحادثة بإرسال أول رسالة" FontSize="13"
                       HorizontalTextAlignment="Center" TextColor="#8F829C" />
            </VerticalStackLayout>
        </Grid>

        <!-- Modern composer -->
        <Border Grid.Row="2" Margin="12,6,12,12" Padding="7" BackgroundColor="#FFFFFF"
                Stroke="#E5DCEE" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" VerticalOptions="Center">
                <Button x:Name="RecordButton" Text="🎙" SemanticProperties.Description="تسجيل رسالة صوتية أو إيقاف التسجيل"
                        FontSize="19" WidthRequest="44" HeightRequest="44" Padding="0" BackgroundColor="#F1EAF8"
                        TextColor="#7042A5" CornerRadius="22" Clicked="RecordAudioClicked" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Entry x:Name="MessageEntry" Placeholder="اكتب رسالتك..." ReturnType="Send"
                           ClearButtonVisibility="WhileEditing" MaxLength="4000" Completed="SendClicked"
                           FontSize="15" TextColor="#2E2140" PlaceholderColor="#9AA9BB"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="📎" SemanticProperties.Description="إضافة صورة أو ملف"
                            FontSize="19" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent"
                            TextColor="#7042A5" Clicked="AttachmentButtonClicked" />
                </Grid>
                <Button x:Name="SendButton" Grid.Column="2" SemanticProperties.Description="إرسال الرسالة"
                        Text="➤" FontSize="21" WidthRequest="46" HeightRequest="46" Padding="0"
                        CornerRadius="23" BackgroundColor="#7042A5" TextColor="White" Clicked="SendClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
