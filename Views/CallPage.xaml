<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.CallPage"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#10091F">
    <ContentPage.Resources>
        <Style x:Key="CallControlButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="54" />
            <Setter Property="HeightRequest" Value="54" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BackgroundColor" Value="#2A1A45" />
            <Setter Property="CornerRadius" Value="27" />
            <Setter Property="Aspect" Value="AspectFit" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="18,18,18,28">
        <Grid ColumnDefinitions="52,*,52">
            <ImageButton Grid.Column="0" Source="icon_arrow_back_white.svg" Padding="12"
                         BackgroundColor="#241438" WidthRequest="48" HeightRequest="48" CornerRadius="24"
                         Clicked="BackClicked" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="3">
                <Label x:Name="ModeLabel" Text="مكالمة صوتية" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label x:Name="StatusLabel" Text="جاري التجهيز..." FontSize="12" TextColor="#CFC2E6" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Padding="0,22,0,12">
            <Border x:Name="VideoSurface" IsVisible="False" BackgroundColor="#05030A" Stroke="#6F43B8" StrokeThickness="1" Margin="0,0,0,18">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <Grid>
                    <Grid x:Name="RemoteVideoHost" BackgroundColor="#05030A" />
                    <Label Text="بانتظار الفيديو..." TextColor="#B9A9CF" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border WidthRequest="112" HeightRequest="152" HorizontalOptions="End" VerticalOptions="End" Margin="16"
                            BackgroundColor="#201231" Stroke="#7044BA" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Grid x:Name="LocalVideoHost" />
                    </Border>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                <Border WidthRequest="148" HeightRequest="148" BackgroundColor="#281744" Stroke="#6F43B8" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="74" /></Border.StrokeShape>
                    <Label x:Name="InitialLabel" Text="H" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label x:Name="NameLabel" Text="Himo" FontSize="25" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="اتصال مشفّر" FontSize="12" TextColor="#AFA0C7" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10" MaximumWidthRequest="340" HorizontalOptions="Center">
            <ImageButton x:Name="MuteButton" Grid.Column="0" Source="icon_mic.svg" Style="{StaticResource CallControlButton}" Clicked="ToggleMuteClicked" />
            <ImageButton Grid.Column="1" Source="icon_call_end.svg" WidthRequest="60" HeightRequest="60" Padding="17"
                         BackgroundColor="#D94B5B" CornerRadius="30" Clicked="EndClicked" />
            <ImageButton x:Name="CameraButton" Grid.Column="2" Source="icon_camera.svg" Style="{StaticResource CallControlButton}" Clicked="ToggleCameraClicked" />
            <ImageButton x:Name="SpeakerButton" Grid.Column="3" Source="icon_volume.svg" Style="{StaticResource CallControlButton}" Clicked="ToggleSpeakerClicked" />
            <ImageButton x:Name="RemoteAudioButton" Grid.Column="4" Source="icon_volume.svg" Style="{StaticResource CallControlButton}" Clicked="ToggleRemoteAudioClicked" IsEnabled="False" />
        </Grid>
    </Grid>
</ContentPage>
