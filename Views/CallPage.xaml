<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Himo.Views"
             x:Class="Himo.Views.CallPage"
             FlowDirection="RightToLeft"
             Shell.NavBarIsVisible="False"
             Padding="0"
             BackgroundColor="#070A12">

    <ContentPage.Resources>
        <Style x:Key="IncomingActionButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="70" />
            <Setter Property="HeightRequest" Value="70" />
            <Setter Property="MinimumWidthRequest" Value="70" />
            <Setter Property="MinimumHeightRequest" Value="70" />
            <Setter Property="CornerRadius" Value="35" />
            <Setter Property="Padding" Value="21" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Aspect" Value="AspectFit" />
        </Style>
        <Style x:Key="CallControlButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="58" />
            <Setter Property="HeightRequest" Value="58" />
            <Setter Property="MinimumWidthRequest" Value="58" />
            <Setter Property="MinimumHeightRequest" Value="58" />
            <Setter Property="CornerRadius" Value="29" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BackgroundColor" Value="#3BFFFFFF" />
            <Setter Property="BorderColor" Value="#4DFFFFFF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="Aspect" Value="AspectFit" />
        </Style>
        <Style x:Key="CallControlLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="CallRoot" BackgroundColor="#070A12">
        <!-- Audio calls use a clean dark gradient while video fills the complete screen. -->
        <Grid x:Name="AudioBackground">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                    <GradientStop Color="#07111F" Offset="0.0" />
                    <GradientStop Color="#17243A" Offset="0.58" />
                    <GradientStop Color="#271A31" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse WidthRequest="310" HeightRequest="310" Fill="#0CFFFFFF"
                     HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- Video scene: the local front-camera preview fills the screen while dialing.
             Once connected, the remote video fills the screen and the local preview floats in a corner. -->
        <Grid x:Name="VideoSurface" IsVisible="False" BackgroundColor="#05070B">
            <local:WebRtcRendererView x:Name="RemoteVideoHost" IsVisible="False" BackgroundColor="#05070B" />

            <Border x:Name="LocalVideoContainer" FlowDirection="LeftToRight"
                    HorizontalOptions="Fill" VerticalOptions="Fill" Margin="0"
                    BackgroundColor="#080C14" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid BackgroundColor="#080C14">
                    <local:WebRtcRendererView x:Name="LocalVideoHost" BackgroundColor="#080C14" />

                    <!-- A camera-off state uses the signed-in user's own profile image, not the peer's avatar. -->
                    <Grid x:Name="LocalCameraOffOverlay" IsVisible="False" BackgroundColor="#101827">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#121D2D" Offset="0" />
                                <GradientStop Color="#080B14" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                            <Border WidthRequest="136" HeightRequest="136" Padding="0"
                                    BackgroundColor="#202B3D" Stroke="#7DFFFFFF" StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="68" /></Border.StrokeShape>
                                <Grid>
                                    <Image x:Name="LocalProfilePhotoImage" Aspect="AspectFill" IsVisible="False" />
                                    <Label x:Name="LocalProfileInitialLabel" Text="H" FontSize="48"
                                           FontAttributes="Bold" TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                            <Label Text="الكاميرا متوقفة" FontSize="14" TextColor="#E5EAF2"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <!-- Kept for a no-video/slow-render fallback. The code-behind hides it after attaching the renderers. -->
            <VerticalStackLayout x:Name="VideoWaitingOverlay" IsVisible="False"
                                 HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="12" InputTransparent="True">
                <Border WidthRequest="108" HeightRequest="108" Padding="0"
                        BackgroundColor="#263248" Stroke="#8FFFFFFF" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="54" /></Border.StrokeShape>
                    <Grid>
                        <Image x:Name="VideoPeerPhotoImage" Aspect="AspectFill" IsVisible="False" />
                        <Label x:Name="VideoPeerInitialLabel" Text="H" FontSize="36" FontAttributes="Bold"
                               TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Label Text="جارٍ توصيل الفيديو..." FontSize="13" TextColor="#FFFFFF" />
            </VerticalStackLayout>
        </Grid>

        <!-- Incoming video calls show identity/actions before answer. Camera capture is not started before consent. -->
        <Grid x:Name="IncomingVideoPanel" IsVisible="False" BackgroundColor="#0A1020">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                    <GradientStop Color="#101E34" Offset="0" />
                    <GradientStop Color="#101322" Offset="0.55" />
                    <GradientStop Color="#25182A" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse WidthRequest="360" HeightRequest="360" Fill="#10FFFFFF"
                     HorizontalOptions="Center" VerticalOptions="Center" />
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                <Border WidthRequest="152" HeightRequest="152" Padding="0"
                        BackgroundColor="#1A2940" Stroke="#70FFFFFF" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="76" /></Border.StrokeShape>
                    <Grid>
                        <Image x:Name="IncomingPeerPhotoImage" Aspect="AspectFill" IsVisible="False" />
                        <Label x:Name="IncomingPeerInitialLabel" Text="H" FontSize="52"
                               FontAttributes="Bold" TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Label Text="مكالمة فيديو واردة" FontSize="15" TextColor="#D9E2EF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Audio call avatar is centered; the caller name and elapsed time stay at the top. -->
        <VerticalStackLayout x:Name="ProfilePanel" IsVisible="True"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Spacing="12" Padding="24,0">
            <Grid WidthRequest="184" HeightRequest="184">
                <Ellipse WidthRequest="184" HeightRequest="184" Fill="#13FFFFFF"
                         Stroke="#3FFFFFFF" StrokeThickness="1" />
                <Border WidthRequest="148" HeightRequest="148" Padding="0"
                        BackgroundColor="#233047" Stroke="#65FFFFFF" StrokeThickness="1"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="74" /></Border.StrokeShape>
                    <Grid>
                        <Image x:Name="ProfilePhotoImage" Aspect="AspectFill" IsVisible="False" />
                        <Label x:Name="InitialLabel" Text="H" FontSize="48" FontAttributes="Bold"
                               TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Border WidthRequest="40" HeightRequest="40" HorizontalOptions="End" VerticalOptions="End"
                        BackgroundColor="#24354E" Stroke="#60FFFFFF" StrokeThickness="1" Padding="10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Image x:Name="CallModeIcon" Source="himo_icon_chat_voice_call.png" Aspect="AspectFit" />
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Any tap on the call canvas toggles the chrome. Buttons are layered above this catcher. -->
        <Grid x:Name="CallTapCatcher" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="CallSurfaceTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Centered identity/timer. The small arrow button enters Android Picture-in-Picture without ending the call. -->
        <Grid x:Name="CallHeader" ColumnDefinitions="48,*,48" HeightRequest="66"
              HorizontalOptions="Fill" VerticalOptions="Start" Margin="12,12,12,0"
              FlowDirection="LeftToRight">
            <BoxView Grid.Column="0" WidthRequest="48" Opacity="0" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="3" InputTransparent="True">
                <Label x:Name="NameLabel" Text="جهة اتصال" FontSize="20" FontAttributes="Bold"
                       TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                <Label x:Name="StatusLabel" Text="جاري تجهيز الاتصال..." FontSize="12"
                       TextColor="#E2E8F0" HorizontalTextAlignment="Center" />
                <Label x:Name="VideoCallNameLabel" Text="جهة اتصال" FontSize="19"
                       FontAttributes="Bold" TextColor="#FFFFFF" IsVisible="False"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="VideoStatusLabel" Text="جاري الاتصال..." FontSize="12"
                       TextColor="#E2E8F0" IsVisible="False" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button x:Name="MinimizeCallButton" Grid.Column="2" Text="↙↗"
                    WidthRequest="44" HeightRequest="44" Padding="0"
                    BackgroundColor="#66101828" TextColor="#FFFFFF" FontSize="18"
                    BorderWidth="1" BorderColor="#55FFFFFF" CornerRadius="22"
                    Clicked="MinimizeCallClicked" IsVisible="False"
                    SemanticProperties.Description="تصغير المكالمة مع استمرار الاتصال" />
        </Grid>

        <!-- Incoming screen: accept and reject are deliberately always visible while ringing. -->
        <Border x:Name="IncomingActions" IsVisible="False"
                HorizontalOptions="Fill" VerticalOptions="End" Margin="18,0,18,30"
                Padding="0" BackgroundColor="Transparent"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Grid x:Name="IncomingButtonGrid" ColumnDefinitions="*,*" ColumnSpacing="42"
                      HorizontalOptions="Center" FlowDirection="LeftToRight">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" HorizontalOptions="Center">
                        <ImageButton x:Name="AnswerIncomingButton" Source="call_phone_white.png"
                                     Style="{StaticResource IncomingActionButton}"
                                     BackgroundColor="#18BF68" Clicked="AcceptIncomingClicked"
                                     SemanticProperties.Description="قبول المكالمة" />
                        <Label Text="قبول" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                        <ImageButton x:Name="RejectIncomingButton" Source="call_end_white.png"
                                     Style="{StaticResource IncomingActionButton}"
                                     BackgroundColor="#E94F63" Clicked="RejectIncomingClicked"
                                     SemanticProperties.Description="رفض المكالمة" />
                        <Label Text="رفض" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Audio-only ringing panel. Video callers see their live camera preview behind the same hang-up control. -->
        <Border x:Name="OutgoingActions" IsVisible="False"
                HorizontalOptions="Fill" VerticalOptions="End" Margin="18,0,18,28"
                Padding="18,15" BackgroundColor="#B30A101B"
                Stroke="#35FFFFFF" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18" FlowDirection="LeftToRight">
                <VerticalStackLayout Grid.Column="0" Spacing="7" VerticalOptions="Center" FlowDirection="RightToLeft">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" FlowDirection="RightToLeft">
                        <ActivityIndicator IsRunning="True" Color="#5FE1C5" WidthRequest="18" HeightRequest="18" />
                        <Label x:Name="WaitingCallTitle" Text="جاري الاتصال بالطرف الآخر"
                               FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF" />
                    </HorizontalStackLayout>
                    <Label x:Name="WaitingCallSubtitle" Text="بانتظار رد الطرف الآخر..."
                           FontSize="12" TextColor="#D0D8E6" />
                </VerticalStackLayout>
                <ImageButton Grid.Column="1" Source="call_end_white.png" WidthRequest="62" HeightRequest="62"
                             MinimumWidthRequest="62" MinimumHeightRequest="62" Padding="18"
                             BackgroundColor="#E94F63" BorderWidth="0" CornerRadius="31"
                             Aspect="AspectFit" Clicked="EndClicked"
                             SemanticProperties.Description="إلغاء الاتصال" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- A minimal toolbar. Video: hang up / camera on-off / switch camera / mic. Audio: hang up / speaker / mic. -->
        <Border x:Name="CallControls" IsVisible="False"
                HorizontalOptions="Fill" VerticalOptions="End" Margin="6,0,6,24"
                Padding="0" BackgroundColor="Transparent"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Grid x:Name="ControlButtonGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="4"
                  FlowDirection="LeftToRight">
                <VerticalStackLayout x:Name="EndControl" Grid.Column="0" Spacing="7" HorizontalOptions="Center">
                    <ImageButton x:Name="ActiveEndButton" Source="call_end_white.png"
                                 WidthRequest="62" HeightRequest="62" MinimumWidthRequest="62"
                                 MinimumHeightRequest="62" Padding="18" BackgroundColor="#E94F63"
                                 BorderWidth="0" CornerRadius="31" Aspect="AspectFit" Clicked="EndClicked"
                                 SemanticProperties.Description="إنهاء المكالمة" />
                    <Label Text="إنهاء الاتصال" Style="{StaticResource CallControlLabel}" FontAttributes="Bold" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="CameraControl" Grid.Column="1" Spacing="7" HorizontalOptions="Center">
                    <ImageButton x:Name="CameraButton" Source="himo_call_camera.png"
                                 Style="{StaticResource CallControlButton}" Clicked="ToggleCameraClicked"
                                 SemanticProperties.Description="تشغيل أو إيقاف الكاميرا" />
                    <Label x:Name="CameraActionLabel" Text="إغلاق الكاميرا" Style="{StaticResource CallControlLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SwitchCameraControl" Grid.Column="2" Spacing="7" HorizontalOptions="Center">
                    <ImageButton x:Name="SwitchCameraButton" Source="himo_cam_switch.png"
                                 Style="{StaticResource CallControlButton}" Clicked="SwitchCameraClicked"
                                 SemanticProperties.Description="تبديل الكاميرا الأمامية والخلفية" />
                    <Label x:Name="SwitchCameraActionLabel" Text="تبديل الكاميرا" Style="{StaticResource CallControlLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SpeakerControl" Grid.Column="1" Spacing="7" HorizontalOptions="Center">
                    <ImageButton x:Name="SpeakerButton" Source="himo_call_speaker_off.png"
                                 Style="{StaticResource CallControlButton}" Clicked="ToggleSpeakerClicked"
                                 SemanticProperties.Description="تشغيل أو إيقاف مكبر الصوت" />
                    <Label x:Name="SpeakerActionLabel" Text="سماعة الأذن" Style="{StaticResource CallControlLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="MuteControl" Grid.Column="3" Spacing="7" HorizontalOptions="Center">
                    <ImageButton x:Name="MuteButton" Source="himo_call_mic.png"
                                 Style="{StaticResource CallControlButton}" Clicked="ToggleMuteClicked"
                                 SemanticProperties.Description="فتح أو كتم الميكروفون" />
                    <Label x:Name="MuteActionLabel" Text="المايك مفتوح" Style="{StaticResource CallControlLabel}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Retain legacy controls in the visual tree because existing call-state code still updates their state.
             They are never displayed; the visible bar above is the simplified production toolbar. -->
        <Grid IsVisible="False" WidthRequest="0" HeightRequest="0" Opacity="0">
            <Label x:Name="ModeLabel" Text="مكالمة فيديو" />
            <ImageButton x:Name="RemoteAudioButton" Source="himo_call_speaker_off.png" />
            <Label x:Name="RemoteAudioActionLabel" Text="الصوت الوارد" />
            <ImageButton x:Name="MoreButton" Source="himo_call_more.png" />
            <Label x:Name="MoreActionLabel" Text="المزيد" />
        </Grid>
    </Grid>
</ContentPage>
