<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Himo.Views"
             x:Class="Himo.Views.CallPage"
             FlowDirection="LeftToRight"
             Shell.NavBarIsVisible="False"
             Padding="0"
             BackgroundColor="#05070B">

    <ContentPage.Resources>
        <Style x:Key="IncomingActionButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="68" />
            <Setter Property="HeightRequest" Value="68" />
            <Setter Property="MinimumWidthRequest" Value="68" />
            <Setter Property="MinimumHeightRequest" Value="68" />
            <Setter Property="CornerRadius" Value="34" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Aspect" Value="AspectFit" />
        </Style>

        <Style x:Key="ImoCallControlButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="56" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="MinimumWidthRequest" Value="56" />
            <Setter Property="MinimumHeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Aspect" Value="AspectFit" />
        </Style>

        <Style x:Key="ImoEndCallButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="64" />
            <Setter Property="HeightRequest" Value="64" />
            <Setter Property="MinimumWidthRequest" Value="64" />
            <Setter Property="MinimumHeightRequest" Value="64" />
            <Setter Property="CornerRadius" Value="32" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BackgroundColor" Value="#F44336" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Aspect" Value="AspectFit" />
        </Style>

        <Style x:Key="HiddenCallLabel" TargetType="Label">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="HeightRequest" Value="0" />
            <Setter Property="FontSize" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="CallRoot" BackgroundColor="#05070B">
        <!-- Voice-call backdrop: the other participant's photo is blurred by Android RenderEffect. -->
        <Grid x:Name="AudioBackground" IsVisible="True">
            <Image x:Name="AudioAvatarBackgroundImage" Aspect="AspectFill"
                   Opacity="0.62" IsVisible="False" />
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.15,1">
                        <GradientStop Color="#99000000" Offset="0" />
                        <GradientStop Color="#55000000" Offset="0.50" />
                        <GradientStop Color="#D9000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
        </Grid>

        <!-- Video call: remote renderer fills the screen. Local camera floats over it after connection. -->
        <Grid x:Name="VideoSurface" IsVisible="False" BackgroundColor="#05070B">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="CallSurfaceTapped" />
            </Grid.GestureRecognizers>
            <local:WebRtcRendererView x:Name="RemoteVideoHost" IsVisible="False" BackgroundColor="#05070B" />

            <Border x:Name="LocalVideoContainer" FlowDirection="LeftToRight"
                    HorizontalOptions="Fill" VerticalOptions="Fill" Margin="0"
                    BackgroundColor="#080C14" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="LocalPreviewPanUpdated" />
                </Border.GestureRecognizers>
                <Grid BackgroundColor="#080C14">
                    <local:WebRtcRendererView x:Name="LocalVideoHost" BackgroundColor="#080C14" />

                    <Grid x:Name="LocalCameraOffOverlay" IsVisible="False" InputTransparent="True" BackgroundColor="#101827">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#121D2D" Offset="0" />
                                <GradientStop Color="#080B14" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                            <Border WidthRequest="72" HeightRequest="72" Padding="0"
                                    BackgroundColor="#202B3D" Stroke="#BFFFFFFF" StrokeThickness="2">
                                <Border.StrokeShape><RoundRectangle CornerRadius="36" /></Border.StrokeShape>
                                <Grid>
                                    <Image x:Name="LocalProfilePhotoImage" Aspect="AspectFill" IsVisible="False" />
                                    <Label x:Name="LocalProfileInitialLabel" Text="H" FontSize="30"
                                           FontAttributes="Bold" TextColor="#FFFFFF"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                            <Label Text="الكاميرا متوقفة" FontSize="12" TextColor="#FFFFFF"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Camera on/off stays available without adding a sixth bottom-bar button. -->
                    <ImageButton x:Name="CameraButton" Source="imo_call_camera.png"
                                 WidthRequest="40" HeightRequest="40" MinimumWidthRequest="40"
                                 MinimumHeightRequest="40" Padding="10" CornerRadius="20"
                                 BackgroundColor="#55000000" BorderColor="#66FFFFFF" BorderWidth="1"
                                 HorizontalOptions="Start" VerticalOptions="End" Margin="8"
                                 Clicked="ToggleCameraClicked" Pressed="CallButtonPressed"
                                 Released="CallButtonReleased"
                                 SemanticProperties.Description="تشغيل أو إيقاف الكاميرا" />
                </Grid>
            </Border>

            <VerticalStackLayout x:Name="VideoWaitingOverlay" IsVisible="False"
                                 HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="12" InputTransparent="True">
                <Border WidthRequest="108" HeightRequest="108" Padding="0"
                        BackgroundColor="#263248" Stroke="#8FFFFFFF" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="54" /></Border.StrokeShape>
                    <Grid>
                        <Image x:Name="VideoPeerPhotoImage" Aspect="AspectFill" IsVisible="False" />
                        <Label x:Name="VideoPeerInitialLabel" Text="H" FontSize="36" FontAttributes="Bold"
                               TextColor="#FFFFFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Label Text="جارٍ توصيل الفيديو..." FontSize="13" TextColor="#FFFFFF" />
            </VerticalStackLayout>
        </Grid>

        <!-- Incoming video call identity screen. -->
        <Grid x:Name="IncomingVideoPanel" IsVisible="False" BackgroundColor="#090D15">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                    <GradientStop Color="#152034" Offset="0" />
                    <GradientStop Color="#10121D" Offset="0.55" />
                    <GradientStop Color="#21151D" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <Border WidthRequest="160" HeightRequest="160" Padding="3"
                        BackgroundColor="#FFFFFF" Stroke="#FFFFFF" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="80" /></Border.StrokeShape>
                    <Grid>
                        <Image x:Name="IncomingPeerPhotoImage" Aspect="AspectFill" IsVisible="False" />
                        <Label x:Name="IncomingPeerInitialLabel" Text="H" FontSize="52"
                               FontAttributes="Bold" TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Label Text="مكالمة فيديو واردة" FontSize="15" TextColor="#E8EDF5"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Voice-call avatar: 160dp image with a 3dp white ring. -->
        <Grid x:Name="ProfilePanel" IsVisible="True"
              HorizontalOptions="Center" VerticalOptions="Center"
              WidthRequest="170" HeightRequest="170">
            <Border WidthRequest="166" HeightRequest="166" Padding="3"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="#FFFFFF" Stroke="#FFFFFF" StrokeThickness="3">
                <Border.StrokeShape><RoundRectangle CornerRadius="83" /></Border.StrokeShape>
                <Grid BackgroundColor="#253248">
                    <Image x:Name="ProfilePhotoImage" Aspect="AspectFill" IsVisible="False" />
                    <Label x:Name="InitialLabel" Text="H" FontSize="52" FontAttributes="Bold"
                           TextColor="#FFFFFF" HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Tap empty space to hide/show the call header and controls. -->
        <Grid x:Name="CallTapCatcher" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="CallSurfaceTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Centered name and timer at the top. -->
        <Grid x:Name="CallHeader" ColumnDefinitions="48,*,48" HeightRequest="76"
              HorizontalOptions="Fill" VerticalOptions="Start" Margin="8,24,8,0"
              FlowDirection="LeftToRight">
            <BoxView Grid.Column="0" WidthRequest="44" Opacity="0" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                 Spacing="3" InputTransparent="True">
                <Label x:Name="NameLabel" Text="جهة اتصال" FontSize="20" FontAttributes="Bold"
                       FontFamily="Roboto" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                <Label x:Name="StatusLabel" Text="جاري تجهيز الاتصال..." FontSize="14"
                       FontFamily="Roboto" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                <Label x:Name="VideoCallNameLabel" Text="جهة اتصال" FontSize="20"
                       FontAttributes="Bold" FontFamily="Roboto" TextColor="#FFFFFF" IsVisible="False"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="VideoStatusLabel" Text="جاري الاتصال..." FontSize="14"
                       FontFamily="Roboto" TextColor="#FFFFFF" IsVisible="False"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button x:Name="MinimizeCallButton" Grid.Column="2" Text="↙↗"
                    WidthRequest="42" HeightRequest="42" Padding="0"
                    BackgroundColor="#44000000" TextColor="#FFFFFF" FontSize="17"
                    BorderWidth="1" BorderColor="#55FFFFFF" CornerRadius="21"
                    Clicked="MinimizeCallClicked" IsVisible="False"
                    SemanticProperties.Description="تصغير المكالمة مع استمرار الاتصال" />
        </Grid>

        <!-- Incoming call actions. -->
        <Border x:Name="IncomingActions" IsVisible="False"
                HorizontalOptions="Fill" VerticalOptions="End" Margin="24,0,24,36"
                Padding="16,18" BackgroundColor="#22000000" Stroke="#22FFFFFF" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Grid x:Name="IncomingButtonGrid" ColumnDefinitions="*,*" ColumnSpacing="52" HorizontalOptions="Center"
                  FlowDirection="LeftToRight">
                <VerticalStackLayout Grid.Column="0" Spacing="8" HorizontalOptions="Center">
                    <ImageButton x:Name="AnswerIncomingButton" Source="imo_call_accept.png"
                                 Style="{StaticResource IncomingActionButton}"
                                 BackgroundColor="#00C853" Clicked="AcceptIncomingClicked"
                                 Pressed="CallButtonPressed" Released="CallButtonReleased"
                                 SemanticProperties.Description="قبول المكالمة" />
                    <Label Text="قبول" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                    <ImageButton x:Name="RejectIncomingButton" Source="imo_call_end.png"
                                 Style="{StaticResource IncomingActionButton}"
                                 BackgroundColor="#F44336" Clicked="RejectIncomingClicked"
                                 Pressed="CallButtonPressed" Released="CallButtonReleased"
                                 SemanticProperties.Description="رفض المكالمة" />
                    <Label Text="رفض" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Outgoing audio call while waiting for the other participant. -->
        <Border x:Name="OutgoingActions" IsVisible="False"
                HorizontalOptions="Fill" VerticalOptions="End" Margin="18,0,18,104"
                Padding="16,14" BackgroundColor="#33000000" Stroke="#22FFFFFF" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" FlowDirection="LeftToRight">
                <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center" FlowDirection="RightToLeft">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" FlowDirection="RightToLeft">
                        <ActivityIndicator IsRunning="True" Color="#00C853" WidthRequest="18" HeightRequest="18" />
                        <Label x:Name="WaitingCallTitle" Text="جاري الاتصال بالطرف الآخر"
                               FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF" />
                    </HorizontalStackLayout>
                    <Label x:Name="WaitingCallSubtitle" Text="بانتظار رد الطرف الآخر..."
                           FontSize="12" TextColor="#D0D7E2" />
                </VerticalStackLayout>
                <ImageButton Grid.Column="1" Source="imo_call_end.png" WidthRequest="58" HeightRequest="58"
                             MinimumWidthRequest="58" MinimumHeightRequest="58" Padding="17"
                             BackgroundColor="#F44336" BorderWidth="0" CornerRadius="29"
                             Aspect="AspectFit" Clicked="EndClicked" Pressed="CallButtonPressed"
                             Released="CallButtonReleased" VerticalOptions="Center"
                             SemanticProperties.Description="إلغاء الاتصال" />
            </Grid>
        </Border>

        <!-- IMO-style 5-button control bar: Mute / Switch / End / Speaker / More. -->
        <Border x:Name="CallControls" IsVisible="False"
                HorizontalOptions="Fill" VerticalOptions="End" HeightRequest="80"
                Margin="0" Padding="8,0" BackgroundColor="#1A000000" StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0" /></Border.StrokeShape>
            <Grid x:Name="ControlButtonGrid"
                  ColumnDefinitions="*,*,*,*,*" ColumnSpacing="0"
                  HorizontalOptions="Fill" VerticalOptions="Fill"
                  FlowDirection="LeftToRight">
                <Grid x:Name="MuteControl" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                    <ImageButton x:Name="MuteButton" Source="imo_call_mic.png"
                                 Style="{StaticResource ImoCallControlButton}" Clicked="ToggleMuteClicked"
                                 Pressed="CallButtonPressed" Released="CallButtonReleased"
                                 SemanticProperties.Description="فتح أو كتم الميكروفون" />
                </Grid>

                <Grid x:Name="SwitchCameraControl" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <ImageButton x:Name="SwitchCameraButton" Source="imo_call_switch_camera.png"
                                 Style="{StaticResource ImoCallControlButton}" Clicked="SwitchCameraClicked"
                                 Pressed="CallButtonPressed" Released="CallButtonReleased"
                                 SemanticProperties.Description="تبديل الكاميرا الأمامية والخلفية" />
                </Grid>

                <Grid x:Name="EndControl" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <ImageButton x:Name="ActiveEndButton" Source="imo_call_end.png"
                                 Style="{StaticResource ImoEndCallButton}" Clicked="EndClicked"
                                 Pressed="CallButtonPressed" Released="CallButtonReleased"
                                 SemanticProperties.Description="إنهاء المكالمة" />
                </Grid>

                <Grid x:Name="SpeakerControl" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                    <ImageButton x:Name="SpeakerButton" Source="imo_call_speaker_off.png"
                                 Style="{StaticResource ImoCallControlButton}" Clicked="ToggleSpeakerClicked"
                                 Pressed="CallButtonPressed" Released="CallButtonReleased"
                                 SemanticProperties.Description="تشغيل أو إيقاف مكبر الصوت" />
                </Grid>

                <Grid x:Name="MoreControl" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center">
                    <ImageButton x:Name="MoreActionButton" Source="imo_call_more.png"
                                 Style="{StaticResource ImoCallControlButton}" Clicked="MoreClicked"
                                 Pressed="CallButtonPressed" Released="CallButtonReleased"
                                 SemanticProperties.Description="المزيد من خيارات المكالمة" />
                </Grid>
            </Grid>
        </Border>

        <!-- Hidden compatibility controls: the existing call-state code still updates these names. -->
        <Grid IsVisible="False" WidthRequest="0" HeightRequest="0" Opacity="0">
            <Label x:Name="ModeLabel" Text="مكالمة فيديو" />
            <Image x:Name="CallModeIcon" Source="himo_icon_chat_voice_call.png" />
            <VerticalStackLayout x:Name="CameraControl" IsVisible="False">
                <Label x:Name="CameraActionLabel" Text="إغلاق الكاميرا" />
            </VerticalStackLayout>
            <Label x:Name="SwitchCameraActionLabel" Text="تبديل الكاميرا" />
            <Label x:Name="SpeakerActionLabel" Text="مكبر الصوت" />
            <Label x:Name="MuteActionLabel" Text="المايك مفتوح" />
            <ImageButton x:Name="RemoteAudioButton" Source="imo_call_speaker_off.png" />
            <Label x:Name="RemoteAudioActionLabel" Text="الصوت الوارد" />
            <ImageButton x:Name="MoreButton" Source="imo_call_more.png" />
            <Label x:Name="MoreActionLabel" Text="المزيد" />
        </Grid>
    </Grid>
</ContentPage>
