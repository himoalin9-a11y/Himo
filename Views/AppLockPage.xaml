<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.AppLockPage"
             Title="قفل Himo"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="22,22,22,22" RowDefinitions="Auto,*,Auto">
        <Border Grid.RowSpan="3" WidthRequest="300" HeightRequest="300" HorizontalOptions="End" VerticalOptions="Start"
                TranslationX="150" TranslationY="-190" BackgroundColor="{DynamicResource HimoAccent}" Opacity="0.10"
                StrokeThickness="0" InputTransparent="True" ZIndex="-1">
            <Border.StrokeShape><RoundRectangle CornerRadius="150" /></Border.StrokeShape>
        </Border>
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                    BackgroundColor="{DynamicResource HimoSoft}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Label Text="H" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Himo" FontSize="18" FontAttributes="Bold"
                   TextColor="{DynamicResource HimoPrimary}" VerticalOptions="Center" Margin="12,0,0,0" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="12" MaximumWidthRequest="380"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <Border WidthRequest="86" HeightRequest="86" BackgroundColor="{DynamicResource HimoSoft}"
                    Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
                <Image Source="settings_icon_lock.png" WidthRequest="52" HeightRequest="52"
                       Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="التطبيق مقفل" FontSize="26" FontAttributes="Bold"
                   TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            <Label Text="أدخل رمز القفل للمتابعة إلى حسابك" FontSize="14"
                   TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />

            <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1"
                    Padding="14,4" Margin="0,14,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Entry x:Name="PinEntry" Keyboard="Numeric" IsPassword="True" MaxLength="6"
                       Placeholder="رمز القفل" PlaceholderColor="{DynamicResource HimoTextSecondary}" TextColor="{DynamicResource HimoPrimary}"
                       HorizontalTextAlignment="Center" FontSize="25" ClearButtonVisibility="WhileEditing"
                       Completed="UnlockClicked" />
            </Border>

            <Button x:Name="UnlockButton" Style="{StaticResource HimoActionButton}" Text="فتح القفل" HeightRequest="52" CornerRadius="17"
                    BackgroundColor="{DynamicResource HimoAccent}" TextColor="{DynamicResource HimoOnAccent}"
                    FontAttributes="Bold" FontSize="16" Margin="0,4,0,0"
                    Clicked="UnlockClicked" />
            <Label x:Name="ErrorLabel" Text="" FontSize="13" TextColor="{DynamicResource HimoPrimary}"
                   HorizontalTextAlignment="Center" MinimumHeightRequest="22" />
        </VerticalStackLayout>

        <Label Grid.Row="2" Text="Himo • حماية حسابك تبدأ من هنا" FontSize="12"
               TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
