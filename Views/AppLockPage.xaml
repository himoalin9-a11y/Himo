<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.AppLockPage"
             Title="قفل Himo"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoPrimary}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="24,34,24,28" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                    BackgroundColor="#FFFFFF18" Stroke="#FFFFFF30" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Label Text="H" FontSize="22" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Himo" FontSize="18" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center" Margin="12,0,0,0" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="12" MaximumWidthRequest="380"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <Border WidthRequest="96" HeightRequest="96" BackgroundColor="#FFFFFF16"
                    Stroke="#FFFFFF32" StrokeThickness="1" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
                <Label Text="🔒" FontSize="43" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="التطبيق مقفل" FontSize="28" FontAttributes="Bold"
                   TextColor="White" HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            <Label Text="أدخل رمز القفل للمتابعة إلى حسابك" FontSize="14"
                   TextColor="#D9E5F5" HorizontalTextAlignment="Center" />

            <Border BackgroundColor="#FFFFFF16" Stroke="#FFFFFF38" StrokeThickness="1"
                    Padding="16,4" Margin="0,14,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Entry x:Name="PinEntry" Keyboard="Numeric" IsPassword="True" MaxLength="6"
                       Placeholder="رمز القفل" PlaceholderColor="#B8C9DE" TextColor="White"
                       HorizontalTextAlignment="Center" FontSize="25" ClearButtonVisibility="WhileEditing"
                       Completed="UnlockClicked" />
            </Border>

            <Button x:Name="UnlockButton" Text="فتح القفل" HeightRequest="54" CornerRadius="18"
                    BackgroundColor="{DynamicResource HimoAccent}" TextColor="White"
                    FontAttributes="Bold" FontSize="16" Margin="0,4,0,0"
                    Clicked="UnlockClicked" />
            <Label x:Name="ErrorLabel" Text="" FontSize="13" TextColor="#FFD0D0"
                   HorizontalTextAlignment="Center" MinimumHeightRequest="22" />
        </VerticalStackLayout>

        <Label Grid.Row="2" Text="Himo • حماية حسابك تبدأ من هنا" FontSize="12"
               TextColor="#BFD0E5" HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
