<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="Himo.Views.ShareAccountPage"
             FlowDirection="RightToLeft"
             BackgroundColor="{DynamicResource HimoBackground}"
             Title="مشاركة الحساب"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{DynamicResource HimoBackground}">
        <!-- Shared app header style -->
        <Border Grid.Row="0" BackgroundColor="{DynamicResource HimoBackground}"
                StrokeThickness="0" Padding="18,10">
            <Grid ColumnDefinitions="46,*,46" ColumnSpacing="8" HeightRequest="54" FlowDirection="LeftToRight">
                <ImageButton Grid.Column="0" Source="himo_icon_arrow_back_purple.png"
                             WidthRequest="42" HeightRequest="42" Padding="10" Aspect="AspectFit"
                             BackgroundColor="{DynamicResource HimoSoft}"
                             BorderColor="{DynamicResource HimoBorder}" BorderWidth="1" CornerRadius="14"
                             HorizontalOptions="Start" VerticalOptions="Center"
                             SemanticProperties.Description="رجوع" Clicked="BackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center"
                                     VerticalOptions="Center" FlowDirection="RightToLeft">
                    <Label Text="مشاركة الحساب" FontSize="21" FontAttributes="Bold"
                           TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="شارك حسابك بالطريقة التي تناسبك" FontSize="12"
                           TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <BoxView Grid.Column="2" WidthRequest="42" HeightRequest="42" Opacity="0" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,10,18,24" Spacing="14">
                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}"
                        StrokeThickness="1" Padding="14,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,56" ColumnSpacing="12" FlowDirection="LeftToRight">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                            <Label Text="رمز QR الخاص بي" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="عرض رمز حسابك ليتمكن الآخرون من مسحه" FontSize="12"
                                   TextColor="{DynamicResource HimoTextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource HimoSoft}"
                                Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" HorizontalOptions="End" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Label Text="QR" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource HimoAccent}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ShowQrClicked" /></Border.GestureRecognizers>
                </Border>

                <Border x:Name="QrPanel" IsVisible="False" BackgroundColor="{DynamicResource HimoCard}"
                        Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="امسح الرمز للوصول إلى حسابي على Himo" FontSize="13"
                               TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                        <Border BackgroundColor="#FFFFFF" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1"
                                Padding="8" WidthRequest="220" HeightRequest="220">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Grid>
                                <zxing:BarcodeGeneratorView x:Name="AccountQrCode" Format="QrCode" Value=""
                                                            ForegroundColor="#17083D" BackgroundColor="#FFFFFF"
                                                            WidthRequest="200" HeightRequest="200"
                                                            HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
                                <Label x:Name="QrPlaceholderLabel" Text="جارٍ تجهيز رمز الحساب..." FontSize="12"
                                       TextColor="#17083D" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                        <Label x:Name="AccountLinkLabel" Text="جارٍ تجهيز رابط الحساب..." FontSize="11"
                               TextColor="{DynamicResource HimoTextSecondary}" FlowDirection="LeftToRight"
                               HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap" MaxLines="3" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}"
                        StrokeThickness="1" Padding="14,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,56" ColumnSpacing="12" FlowDirection="LeftToRight">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                            <Label Text="مشاركة رابط الحساب" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="إرسال رابط ملفك الشخصي إلى الآخرين" FontSize="12"
                                   TextColor="{DynamicResource HimoTextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource HimoSoft}"
                                Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" HorizontalOptions="End" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Image Source="himo_ui_share.png" WidthRequest="25" HeightRequest="25" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ShareProfileClicked" /></Border.GestureRecognizers>
                </Border>

                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}"
                        StrokeThickness="1" Padding="14,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,56" ColumnSpacing="12" FlowDirection="LeftToRight">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center" FlowDirection="RightToLeft">
                            <Label Text="نسخ رابط الحساب" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="نسخ رابط ملفك الشخصي إلى الحافظة" FontSize="12"
                                   TextColor="{DynamicResource HimoTextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource HimoSoft}"
                                Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" HorizontalOptions="End" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Label Text="⧉" FontSize="29" TextColor="{DynamicResource HimoAccent}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="CopyProfileLinkClicked" /></Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Same five-item bottom navigation as the existing Profile page. -->
        <Border Grid.Row="2" Margin="9,7,9,9" BackgroundColor="{DynamicResource HimoCard}"
                Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="4,5">
            <Border.StrokeShape><RoundRectangle CornerRadius="23" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*,*,*" FlowDirection="RightToLeft">
                <Border Grid.Column="0" Margin="2,0" Padding="2,5" BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_home_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="المحادثات" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ChatsNavTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" Margin="2,0" Padding="2,5" BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_call_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="المكالمات" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="CallsNavTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="2" Margin="2,0" Padding="2,5" BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_search_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="بحث الأشخاص" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="PeopleNavTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="3" Margin="2,0" Padding="2,5" BackgroundColor="{DynamicResource HimoSurface}" Stroke="{DynamicResource HimoAccent}" StrokeThickness="0.8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_user_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="الملف" FontSize="10.5" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ProfileNavTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="4" Margin="2,0" Padding="2,5" BackgroundColor="{DynamicResource HimoCard}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Image Source="home_settings_neon.png" WidthRequest="23" HeightRequest="23" Aspect="AspectFit" />
                        <Label Text="الإعدادات" FontSize="10.5" TextColor="{DynamicResource HimoTextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="SettingsNavTapped" /></Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="PageSwiped" />
            <SwipeGestureRecognizer Direction="Right" Swiped="PageSwiped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentPage>
