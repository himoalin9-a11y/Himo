<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.SettingsPage"
             Title="الإعدادات"
             FlowDirection="RightToLeft"
             Background="{StaticResource HimoBackgroundGradient}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The soft glow is decorative and never intercepts touches. -->
        <Border Grid.RowSpan="3"
                WidthRequest="290" HeightRequest="290"
                HorizontalOptions="Start" VerticalOptions="End"
                TranslationX="-190" TranslationY="120"
                BackgroundColor="#6256FF" Opacity="0.08"
                StrokeThickness="0" InputTransparent="True" ZIndex="-1">
            <Border.StrokeShape><RoundRectangle CornerRadius="145" /></Border.StrokeShape>
        </Border>

        <!-- Header: title aligned right, back action left, as in the reference design. -->
        <Grid Grid.Row="0" Padding="18,12,18,10"
              ColumnDefinitions="48,*,48" ColumnSpacing="8"
              FlowDirection="LeftToRight">
            <Button Grid.Column="0" Text="‹"
                    HeightRequest="42" WidthRequest="42" Padding="0"
                    FontSize="34" FontAttributes="Bold"
                    BackgroundColor="#1B2850" TextColor="#E7ECFF"
                    BorderColor="#334A82" BorderWidth="1" CornerRadius="15"
                    Clicked="BackClicked" HorizontalOptions="Start" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="1"
                                 HorizontalOptions="End" VerticalOptions="Center"
                                 FlowDirection="RightToLeft">
                <Label Text="الإعدادات" FontSize="24" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="End" />
                <Label Text="إدارة حسابك وتفضيلاتك" FontSize="12"
                       TextColor="#A6B9E9" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
            <BoxView Grid.Column="2" WidthRequest="42" HeightRequest="42" Opacity="0" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,8,16,18" Spacing="13">
                <!-- Account identity card -->
                <Border Stroke="#5549B4" StrokeThickness="1.2"
                        Padding="15" MinimumHeightRequest="108">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#26216B" Offset="0.0" />
                            <GradientStop Color="#102A55" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AccountCardTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="35,*,82" ColumnSpacing="9" FlowDirection="LeftToRight">
                        <Label Grid.Column="0" Text="›" FontSize="30" TextColor="#B7C8FF"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"
                                             FlowDirection="RightToLeft">
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="End" FlowDirection="RightToLeft">
                                <Border WidthRequest="21" HeightRequest="21" BackgroundColor="#8C4DFF" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                    <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="White"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label x:Name="SettingsAccountNameLabel" Text="حسابك في Himo"
                                       FontSize="17" FontAttributes="Bold" TextColor="#F3F6FF"
                                       VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="SettingsAccountEmailLabel" Text="إدارة حسابك وتفضيلاتك"
                                   FontSize="12" TextColor="#A9B9E2" HorizontalTextAlignment="End" />
                            <HorizontalStackLayout Spacing="5" HorizontalOptions="End" FlowDirection="RightToLeft">
                                <Border WidthRequest="8" HeightRequest="8" BackgroundColor="#18D18B" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                </Border>
                                <Label Text="حسابك نشط الآن" FontSize="10.5" TextColor="#C7D8FF"
                                       VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="76" HeightRequest="76"
                                BackgroundColor="#423FC0" Stroke="#7778FF" StrokeThickness="1.2"
                                HorizontalOptions="End" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="38" /></Border.StrokeShape>
                            <Label Text="👤" FontSize="39" HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Account rows -->
                <Label Text="الحساب" FontSize="14" FontAttributes="Bold"
                       TextColor="#F0F3FF" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="#101D3D" Stroke="#263B6B" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="12,12" ColumnDefinitions="34,*,36" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="69">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#6038C7" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="☎" FontSize="22" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="إدارة الحساب" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="رقم الهاتف والاسم والبريد وكلمة المرور" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Label Grid.Column="0" Text="‹" FontSize="29" TextColor="#91A9E7"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AccountManagementRowTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Margin="12,0" BackgroundColor="#26365F" />
                        <Grid Padding="12,12" ColumnDefinitions="34,*,36" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="69">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#079B7D" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="⬟" FontSize="24" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="الخصوصية" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="إعدادات الخصوصية والأمان" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Label Grid.Column="0" Text="‹" FontSize="29" TextColor="#91A9E7"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="PrivacyDetailsRowTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="PrivacySettingsDetails" IsVisible="False"
                                             Padding="14,10,14,14" Spacing="5">
                            <Label Text="حماية معلوماتك" FontSize="12.5" FontAttributes="Bold"
                                   TextColor="#EDF2FF" HorizontalTextAlignment="End" />
                            <Label Text="لا يظهر رقم هاتفك للمستخدمين الآخرين. يمكنك إدارة إمكانية العثور على حسابك عبر الهاتف من صفحة إدارة الحساب."
                                   FontSize="11" TextColor="#9EAFDA" LineBreakMode="WordWrap"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Margin="12,0" BackgroundColor="#26365F" />
                        <Grid Padding="12,12" ColumnDefinitions="34,*,36" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="69">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#245AC7" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="♟" FontSize="22" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="الإشعارات" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="تخصيص إشعارات التطبيق" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Label Grid.Column="0" Text="‹" FontSize="29" TextColor="#91A9E7"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NotificationDetailsRowTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Expanded only when notification settings are opened. -->
                        <VerticalStackLayout x:Name="NotificationSettingsDetails" IsVisible="False"
                                             Padding="14,10,14,14" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" FlowDirection="LeftToRight">
                                <VerticalStackLayout Grid.Column="0" Spacing="3" FlowDirection="RightToLeft">
                                    <Label Text="تفعيل إشعارات Himo" FontSize="13" FontAttributes="Bold"
                                           TextColor="#EDF2FF" HorizontalTextAlignment="End" />
                                    <Label Text="تشغيل أو إيقاف إشعارات الرسائل والمكالمات" FontSize="10.5"
                                           TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                                <Switch x:Name="NotificationsSwitch" Grid.Column="1"
                                        Toggled="NotificationsToggled" VerticalOptions="Center" />
                            </Grid>
                            <Label x:Name="NotificationPermissionStatusLabel" FontSize="10.5"
                                   TextColor="#9EAFDA" LineBreakMode="WordWrap" />
                            <Button x:Name="OpenNotificationSettingsButton" Text="فتح إعدادات Android"
                                    HeightRequest="36" CornerRadius="12" FontSize="11"
                                    BackgroundColor="#1B2B55" TextColor="#C5D5FF"
                                    IsVisible="False" Clicked="OpenNotificationSettingsClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Storage and data section -->
                <Label Text="التخزين والبيانات" FontSize="14" FontAttributes="Bold"
                       TextColor="#F0F3FF" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="#101D3D" Stroke="#263B6B" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid Padding="12,12" ColumnDefinitions="34,*,36" ColumnSpacing="10"
                          FlowDirection="LeftToRight" MinimumHeightRequest="69">
                        <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                BackgroundColor="#1786AD" StrokeThickness="0" HorizontalOptions="End">
                            <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                            <Label Text="▤" FontSize="23" TextColor="White"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                             FlowDirection="RightToLeft">
                            <Label Text="التخزين والبيانات" FontSize="15" FontAttributes="Bold"
                                   TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                            <Label Text="إدارة الملفات والصور ومراجعة استخدام الشبكة" FontSize="11.5"
                                   TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Label Grid.Column="0" Text="‹" FontSize="29" TextColor="#91A9E7"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="StorageDataRowTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Chat settings entry added while preserving the newer account/privacy/notification/storage layout -->
                <Border BackgroundColor="#101D3D" Stroke="#263B6B" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid Padding="12,12" ColumnDefinitions="34,*,36" ColumnSpacing="10"
                          FlowDirection="LeftToRight" MinimumHeightRequest="69">
                        <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                BackgroundColor="#713BC7" StrokeThickness="0" HorizontalOptions="End">
                            <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                            <Label Text="☏" FontSize="22" TextColor="White"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                             FlowDirection="RightToLeft">
                            <Label Text="إعدادات الدردشات" FontSize="15" FontAttributes="Bold"
                                   TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                            <Label Text="الإرسال والوسائط وحجم الخط والأرشيف والنسخ الاحتياطي" FontSize="11.5"
                                   TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Label Grid.Column="0" Text="‹" FontSize="29" TextColor="#91A9E7"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ChatSettingsClicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Appearance section -->
                <Label Text="المظهر والتجربة" FontSize="14" FontAttributes="Bold"
                       TextColor="#F0F3FF" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="#101D3D" Stroke="#263B6B" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="12,12" ColumnDefinitions="34,*,Auto" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="72">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#713BC7" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="☾" FontSize="27" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="الوضع الداكن" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="تغيير مظهر التطبيق" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Switch x:Name="DarkModeSwitch" Grid.Column="0"
                                    Toggled="DarkModeToggled" VerticalOptions="Center" HorizontalOptions="Start" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="12,0" BackgroundColor="#26365F" />
                        <Grid Padding="12,12" ColumnDefinitions="34,*,Auto" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="70">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#315BC0" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="Aa" FontSize="19" FontAttributes="Bold" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="حجم الخط" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="تحديد حجم النص في صفحة الإعدادات" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Button Grid.Column="0" Text="متوسط" x:Name="FontSizeValueButton"
                                    FontSize="10.5" Padding="7,0" HeightRequest="32" CornerRadius="12"
                                    BackgroundColor="#1B2B55" TextColor="#CFDAFF"
                                    Clicked="FontSizeRowClicked" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Feature section -->
                <Label Text="الميزات" FontSize="14" FontAttributes="Bold"
                       TextColor="#F0F3FF" Margin="2,2,2,0" HorizontalTextAlignment="End" />
                <Border BackgroundColor="#101D3D" Stroke="#263B6B" StrokeThickness="1" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="12,12" ColumnDefinitions="34,*,Auto" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="70">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#AF285D" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="▣" FontSize="24" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="قفل التطبيق" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="تعيين رمز مرور لحماية التطبيق" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Switch x:Name="AppLockSwitch" Grid.Column="0"
                                    Toggled="AppLockToggled" VerticalOptions="Center" HorizontalOptions="Start" />
                        </Grid>
                        <VerticalStackLayout Padding="14,0,14,11" Spacing="8">
                            <Entry x:Name="AppLockPinEntry" Placeholder="رمز جديد (4-6 أرقام)"
                                   Keyboard="Numeric" IsPassword="True" MaxLength="6" IsVisible="False"
                                   TextColor="White" PlaceholderColor="#8296C6" BackgroundColor="#09132C" />
                            <Button x:Name="SaveAppLockButton" Text="حفظ رمز القفل"
                                    HeightRequest="40" CornerRadius="13" IsVisible="False"
                                    BackgroundColor="#7650E8" TextColor="White" Clicked="SaveAppLockClicked" />
                            <Label x:Name="AppLockStatusLabel" FontSize="10.5" TextColor="#9EAFDA" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Margin="12,0" BackgroundColor="#26365F" />
                        <Grid Padding="12,12" ColumnDefinitions="34,*,Auto" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="70">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#713BC7" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="◉" FontSize="25" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="محتوى الإشعارات" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="عرض محتوى الرسائل في الإشعارات" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Switch x:Name="NotificationPreviewSwitch" Grid.Column="0"
                                    Toggled="NotificationPreviewToggled" VerticalOptions="Center" HorizontalOptions="Start" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="12,0" BackgroundColor="#26365F" />
                        <Grid Padding="12,12" ColumnDefinitions="34,*,36" ColumnSpacing="10"
                              FlowDirection="LeftToRight" MinimumHeightRequest="70">
                            <Border Grid.Column="2" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#0B9E9A" StrokeThickness="0" HorizontalOptions="End">
                                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                                <Label Text="▣" FontSize="23" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                                 FlowDirection="RightToLeft">
                                <Label Text="البحث في جهات الاتصال" FontSize="15" FontAttributes="Bold"
                                       TextColor="#F2F5FF" HorizontalTextAlignment="End" />
                                <Label Text="العثور على أصدقائك المسجلين في Himo" FontSize="11.5"
                                       TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Button x:Name="FindContactsButton" Grid.Column="0" Text="‹"
                                    FontSize="28" Padding="0" HeightRequest="38" WidthRequest="32"
                                    BackgroundColor="Transparent" TextColor="#91A9E7"
                                    Clicked="FindContactsClicked" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout x:Name="ContactsResultsPanel" IsVisible="False"
                                             Padding="13,0,13,13" Spacing="8">
                            <Label x:Name="ContactsMatchStatusLabel" FontSize="11"
                                   TextColor="#A9B9E2" LineBreakMode="WordWrap" />
                            <ActivityIndicator x:Name="ContactsLookupProgress" IsVisible="False"
                                               IsRunning="False" Color="#A46BFF" HorizontalOptions="Center" />
                            <CollectionView x:Name="ContactMatchesList" IsVisible="False"
                                            SelectionMode="Single" SelectionChanged="ContactMatchSelected"
                                            HeightRequest="210">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#17264A" Stroke="#2B406D" StrokeThickness="1"
                                                Padding="10,8" Margin="0,2">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                            <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="9" FlowDirection="LeftToRight">
                                                <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#3A328A" StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                                                    <Label Text="{Binding Initial}" FontSize="15" FontAttributes="Bold"
                                                           TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" FlowDirection="RightToLeft">
                                                    <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                                                           TextColor="#F0F3FF" HorizontalTextAlignment="End" />
                                                    <Label Text="مستخدم Himo من جهات اتصالك" FontSize="10"
                                                           TextColor="#9EAFDA" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="‹" FontSize="24" TextColor="#91A9E7"
                                                       VerticalTextAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Delete account action, intentionally the only destructive accent. -->
                <Border BackgroundColor="#32152D" Stroke="#A41452" StrokeThickness="1.2" Padding="13">
                    <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="34,*,42" ColumnSpacing="10" FlowDirection="LeftToRight">
                        <Label Grid.Column="0" Text="‹" FontSize="29" TextColor="#D7C9FF"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"
                                             FlowDirection="RightToLeft">
                            <Label Text="حذف الحساب" FontSize="15" FontAttributes="Bold"
                                   TextColor="#FFE7F0" HorizontalTextAlignment="End" />
                            <Label Text="إجراء حذف نهائي لحسابك وجميع بياناتك" FontSize="11.5"
                                   TextColor="#D7A6C7" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="40" HeightRequest="40"
                                BackgroundColor="#A41452" StrokeThickness="0" HorizontalOptions="End">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                            <Label Text="▤" FontSize="23" TextColor="White"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="DeleteAccountRowTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Keep account-session actions available below the main reference layout. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                    <Button Grid.Column="0" Text="تسجيل الخروج" Clicked="LogoutClicked"
                            HeightRequest="42" CornerRadius="14" FontSize="11.5"
                            BackgroundColor="#17264A" TextColor="#C8D4F4" />
                    <Button Grid.Column="1" Text="الخروج من جميع الأجهزة" Clicked="LogoutAllClicked"
                            HeightRequest="42" CornerRadius="14" FontSize="11.5"
                            BackgroundColor="#17264A" TextColor="#C8D4F4" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed bottom navigation, matching the reference composition while using real Himo sections. -->
        <Grid Grid.Row="2" BackgroundColor="#07122E" Padding="7,7,7,8"
              ColumnDefinitions="*,*,*,*,*" FlowDirection="LeftToRight">
            <BoxView HeightRequest="1" VerticalOptions="Start" Grid.ColumnSpan="5" Color="#20345F" />
            <Border Grid.Column="0" Margin="1,0" Padding="2,5" BackgroundColor="Transparent" StrokeThickness="0">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center" FlowDirection="RightToLeft">
                    <Image Source="home_user_neon.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" Opacity="0.78" />
                    <Label Text="المزيد" FontSize="9.5" TextColor="#91A5D7" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="ProfileNavTapped" /></Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="1" Margin="1,0" Padding="2,5" BackgroundColor="Transparent" StrokeThickness="0">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center" FlowDirection="RightToLeft">
                    <Image Source="home_search_neon.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" Opacity="0.78" />
                    <Label Text="الأشخاص" FontSize="9.5" TextColor="#91A5D7" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="PeopleNavTapped" /></Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="2" Margin="1,0" Padding="2,5" BackgroundColor="Transparent" StrokeThickness="0">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center" FlowDirection="RightToLeft">
                    <Image Source="home_call_neon.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" Opacity="0.78" />
                    <Label Text="المكالمات" FontSize="9.5" TextColor="#91A5D7" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="CallsNavTapped" /></Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="3" Margin="1,0" Padding="2,5" BackgroundColor="Transparent" StrokeThickness="0">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center" FlowDirection="RightToLeft">
                    <Image Source="home_home_neon.png" WidthRequest="26" HeightRequest="26" Aspect="AspectFit" Opacity="0.78" />
                    <Label Text="المحادثات" FontSize="9.5" TextColor="#91A5D7" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="ChatsNavTapped" /></Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="4" Margin="1,0" Padding="2,5" BackgroundColor="#1A174B" StrokeThickness="0">
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center" FlowDirection="RightToLeft">
                    <Image Source="home_settings_neon.png" WidthRequest="27" HeightRequest="27" Aspect="AspectFit" />
                    <Label Text="الإعدادات" FontSize="9.5" FontAttributes="Bold" TextColor="#B98DFF" HorizontalTextAlignment="Center" />
                    <Border HeightRequest="3" WidthRequest="36" BackgroundColor="#A46BFF" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="2" /></Border.StrokeShape>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="PageSwiped" />
            <SwipeGestureRecognizer Direction="Right" Swiped="PageSwiped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentPage>
