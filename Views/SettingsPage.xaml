<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Himo.Views.SettingsPage"
             Title="الإعدادات"
             FlowDirection="RightToLeft"
             Background="{StaticResource HimoBackgroundGradient}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.RowSpan="2" WidthRequest="310" HeightRequest="310" HorizontalOptions="Start" VerticalOptions="End"
                TranslationX="-205" TranslationY="140" BackgroundColor="#7B1FE3" Opacity="0.09"
                StrokeThickness="0" InputTransparent="True" ZIndex="-1">
            <Border.StrokeShape><RoundRectangle CornerRadius="155" /></Border.StrokeShape>
        </Border>
        <Border Grid.Row="0" BackgroundColor="{DynamicResource HimoHeader}" StrokeThickness="0" Padding="18,9,18,16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="48,*,48">
                    <Button Text="‹" Style="{StaticResource HimoBackButton}" Clicked="BackClicked" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                        <Label Text="الإعدادات" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Text="كل ما تحتاجه لتخصيص Himo" FontSize="12" TextColor="{DynamicResource HimoHeaderTextMuted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="2" Opacity="0" />
                </Grid>
                <Border Grid.Row="1" BackgroundColor="{DynamicResource HimoSurfaceElevated}" Opacity="0.98" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Image Source="himo_logo.png" Aspect="AspectFit" Margin="5" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="إعدادات Himo" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="الحساب • الخصوصية • المظهر • الاتصال" FontSize="11" TextColor="{DynamicResource HimoMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="●" FontSize="12" TextColor="{DynamicResource HimoSuccess}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,30" Spacing="12">
                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="12">
                        <Border WidthRequest="62" HeightRequest="62" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                            <Image Source="himo_logo.png" Aspect="AspectFit" Margin="5" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <Label Text="Himo" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="تواصل أقرب .. دائمًا" FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                            <Label Text="إعدادات الحساب والتطبيق" FontSize="11" TextColor="{DynamicResource HimoMuted}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="11" HeightRequest="11" BackgroundColor="{DynamicResource HimoSuccess}" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        </Border>
                    </Grid>
                </Border>

                <Label Text="الحساب" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource HimoMuted}" Margin="4,10,4,0" />
                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="46,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0" Grid.RowSpan="2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Label Text="👤" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="الملف الشخصي" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                        <Label Grid.Column="1" Grid.Row="1" Text="الاسم والحالة والمعلومات الشخصية" FontSize="12" TextColor="{DynamicResource HimoMuted}" Margin="0,2,0,0" />
                        <Button Grid.Column="2" Grid.RowSpan="2" Text="فتح" Style="{StaticResource HimoActionButton}" HeightRequest="38" CornerRadius="15" Padding="15,0" BackgroundColor="{DynamicResource HimoSoft}" TextColor="{DynamicResource HimoAccent}" Clicked="ProfileClicked" />
                    </Grid>
                </Border>

                <Label Text="رقم الهاتف وجهات الاتصال" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource HimoMuted}" Margin="4,10,4,0" />
                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="46,*" ColumnSpacing="10">
                            <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Label Text="☎" FontSize="20" TextColor="{DynamicResource HimoAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="رقم هاتفك (اختياري)" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                                <Label Text="أضف رقمك ليتمكن أصدقاؤك من العثور على حسابك إذا سمحت بذلك." FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Entry x:Name="ContactPhoneEntry"
                               Placeholder="مثال: +966 5xxxxxxxx"
                               Keyboard="Telephone"
                               MaxLength="25"
                               ClearButtonVisibility="WhileEditing"
                               FlowDirection="LeftToRight"
                               HorizontalTextAlignment="Start"
                               TextColor="{DynamicResource HimoPrimary}"
                               PlaceholderColor="{DynamicResource HimoMuted}"
                               BackgroundColor="{DynamicResource HimoSurfaceElevated}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="السماح بالعثور على حسابي عبر الهاتف" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                                <Label Text="لن يظهر رقمك للآخرين؛ تظهر لهم هوية حسابك فقط عند تطابق الرقم." FontSize="11" TextColor="{DynamicResource HimoMuted}" />
                            </VerticalStackLayout>
                            <Switch x:Name="PhoneDiscoverySwitch" Grid.Column="1" VerticalOptions="Center" />
                        </Grid>
                        <Button x:Name="SaveContactPhoneButton"
                                Text="حفظ رقم الهاتف" Style="{StaticResource HimoActionButton}"
                                HeightRequest="46" CornerRadius="16"
                                BackgroundColor="{DynamicResource HimoHeader}" TextColor="White"
                                Clicked="SaveContactPhoneClicked" />
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource HimoBorder}" Margin="0,4" />
                        <Label Text="العثور على الأصدقاء" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                        <Label Text="ابحث عن حسابات Himo المسجلة بأرقام موجودة في جهات اتصال هاتفك. لن نحفظ دفتر العناوين على الخادم." FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                        <Button x:Name="FindContactsButton"
                                Text="البحث في جهات الاتصال" Style="{StaticResource HimoActionButton}"
                                HeightRequest="46" CornerRadius="16"
                                BackgroundColor="{DynamicResource HimoSoft}" TextColor="{DynamicResource HimoAccent}"
                                Clicked="FindContactsClicked" />
                        <ActivityIndicator x:Name="ContactsLookupProgress" IsVisible="False" IsRunning="False" Color="{DynamicResource HimoAccent}" HorizontalOptions="Center" />
                        <Label x:Name="ContactsMatchStatusLabel" FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                        <CollectionView x:Name="ContactMatchesList"
                                        IsVisible="False"
                                        SelectionMode="Single"
                                        SelectionChanged="ContactMatchSelected"
                                        MaximumHeightRequest="320">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{DynamicResource HimoSurfaceElevated}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="10" Margin="0,3">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                                <Label Text="{Binding Initial}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                                                <Label Text="مستخدم Himo من جهات اتصالك" FontSize="11" TextColor="{DynamicResource HimoMuted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="مراسلة ‹" FontSize="12" TextColor="{DynamicResource HimoAccent}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Label Text="التفضيلات" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource HimoMuted}" Margin="4,10,4,0" />

                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="7">
                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                            <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Label Text="🔔" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="الإشعارات" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                                <Label Text="إشعارات الرسائل الجديدة" FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                            </VerticalStackLayout>
                            <Switch x:Name="NotificationsSwitch" Grid.Column="2" Toggled="NotificationsToggled" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout Spacing="5" Margin="56,2,0,0">
                            <Label x:Name="NotificationPermissionStatusLabel" FontSize="11" TextColor="{DynamicResource HimoMuted}" />
                            <Button x:Name="OpenNotificationSettingsButton" Text="فتح إعدادات Android" Style="{StaticResource HimoActionButton}" FontSize="12" Padding="12,4" HeightRequest="34" CornerRadius="14" IsVisible="False" Clicked="OpenNotificationSettingsClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Label Text="👁" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="محتوى الإشعارات" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="إظهار نص الرسالة داخل الإشعار" FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="NotificationPreviewSwitch" Grid.Column="2" Toggled="NotificationPreviewToggled" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Label Text="◐" FontSize="21" TextColor="{DynamicResource HimoAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="الوضع الداكن" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="تغيير مظهر التطبيق" FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                        </VerticalStackLayout>
                        <Switch x:Name="DarkModeSwitch" Grid.Column="2" Toggled="DarkModeToggled" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="9">
                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                            <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Label Text="🔒" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="قفل التطبيق" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                                <Label Text="حماية التطبيق برمز سري" FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                            </VerticalStackLayout>
                            <Switch x:Name="AppLockSwitch" Grid.Column="2" Toggled="AppLockToggled" VerticalOptions="Center" />
                        </Grid>
                        <Entry x:Name="AppLockPinEntry" Placeholder="رمز جديد (4-6 أرقام)" Keyboard="Numeric" IsPassword="True" MaxLength="6" IsVisible="False" />
                        <Button x:Name="SaveAppLockButton" Text="حفظ رمز القفل" Style="{StaticResource HimoActionButton}" CornerRadius="16" IsVisible="False" BackgroundColor="{DynamicResource HimoHeader}" TextColor="White" Clicked="SaveAppLockClicked" />
                        <Label x:Name="AppLockStatusLabel" FontSize="11" TextColor="{DynamicResource HimoMuted}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="اتصال الخادم" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource HimoMuted}" Margin="4,10,4,0" />
                <Border BackgroundColor="{DynamicResource HimoCard}" Stroke="{DynamicResource HimoBorder}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource HimoSoft}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Label Text="☁" FontSize="20" TextColor="{DynamicResource HimoAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="إعداد اتصال الخادم" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource HimoPrimary}" />
                            <Label Text="تغيير عنوان الخادم واختبار الاتصال" FontSize="12" TextColor="{DynamicResource HimoMuted}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="إعداد" Style="{StaticResource HimoActionButton}" HeightRequest="38" CornerRadius="15" Padding="14,0" BackgroundColor="{DynamicResource HimoSoft}" TextColor="{DynamicResource HimoAccent}" Clicked="ServerSettingsClicked" />
                    </Grid>
                </Border>

                <Label Text="الحساب على هذا الجهاز" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource HimoMuted}" Margin="4,10,4,0" />
                <Button Text="تسجيل الخروج" Style="{StaticResource HimoActionButton}" HeightRequest="50" CornerRadius="18" BackgroundColor="{DynamicResource HimoSoft}" TextColor="{DynamicResource HimoPrimary}" Clicked="LogoutClicked" />
                <Button Text="تسجيل الخروج من جميع الأجهزة" Style="{StaticResource HimoActionButton}" HeightRequest="50" CornerRadius="18" BackgroundColor="{DynamicResource HimoSoft}" TextColor="{DynamicResource HimoPrimary}" Clicked="LogoutAllClicked" />
                <Button Text="حذف الحساب" Style="{StaticResource HimoActionButton}" HeightRequest="50" CornerRadius="18" BackgroundColor="{DynamicResource HimoDangerSoft}" TextColor="{DynamicResource HimoDanger}" Clicked="DeleteAccountClicked" />

                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,10,0,0">
                    <Label Text="Himo" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource HimoMuted}" HorizontalTextAlignment="Center" />
                    <Label Text="تواصل أقرب .. دائمًا" FontSize="11" TextColor="{DynamicResource HimoMuted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="PageSwiped" />
            <SwipeGestureRecognizer Direction="Right" Swiped="PageSwiped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentPage>
