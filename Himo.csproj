<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android36.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Himo</RootNamespace>
    <UseMaui>true</UseMaui>
    <!-- Pin MAUI to SR4 (10.0.40). This includes the Android window-scope fix for disposed IServiceProvider crashes. -->
    <MauiVersion>10.0.40</MauiVersion>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationTitle>Himo</ApplicationTitle>
    <ApplicationId>com.companyname.himo</ApplicationId>
    <ApplicationDisplayVersion>11.11</ApplicationDisplayVersion>
    <ApplicationVersion>121</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android36.0'">30.0</SupportedOSPlatformVersion>
    <!-- Disable Android Fast Deployment. The phone crash log showed an empty __override__ directory, which causes Mono to abort before the MAUI app starts. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <!-- APK is the first release artifact; avoid AAB/bundletool during APK publishing. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Always produce a self-contained APK and keep symbols available for Visual Studio debugging. -->
    <DebugSymbols>true</DebugSymbols>
    <DebugType>Embedded</DebugType>
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- Keep WebRTC Java classes intact; the call engine resolves some types through reflection. -->
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableProguard>false</EnableProguard>
  </PropertyGroup>

  <!-- Explicit Debug configuration: Visual Studio can attach the Android debugger. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>Embedded</DebugType>
    <Optimize>false</Optimize>
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Explicit Release configuration: also keep symbols so launching/debugging Release does not fail. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>Embedded</DebugType>
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="1024,1024" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#17083D" BaseSize="1024,1024" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- PHASE 1 ONLY: use a PNG-only image resource set so Android receives every
       UI icon exactly once. MAUI implicit image items are removed first. -->
  <ItemGroup>
    <MauiImage Remove="Resources\Images\**\*" />
    <MauiImage Include="Resources\Images\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the Account model explicitly included. This avoids IDE/project-item resolution issues. -->
    <Compile Remove="Models\Account.cs" />
    <Compile Include="Models\Account.cs" />
    <!-- Explicitly include the app-lock service so it is always compiled. -->
    <Compile Remove="Services\AppLockService.cs" />
    <Compile Include="Services\AppLockService.cs" />
    <!-- Explicitly include Android notification service for Android builds. -->
    <Compile Remove="Platforms\Android\Services\NotificationService.cs" />
    <Compile Include="Platforms\Android\Services\NotificationService.cs" Condition="'$(TargetFramework)' == 'net10.0-android36.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Himo.Api is a separate ASP.NET project. Do not compile any server-side
         source files that are present beside the MAUI project into the Android app. -->
    <Compile Remove="Himo.Api\**" />
    <EmbeddedResource Remove="Himo.Api\**" />
    <MauiXaml Remove="Himo.Api\**" />
    <None Remove="Himo.Api\**" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="12.3.0" />
    <!-- MediaElement 7.0.0 is compatible with the project's MAUI 10 baseline (>= 10.0.10). -->
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="7.0.0" />
    <PackageReference Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="FsWebRTC.Bindings.Maui.Android" Version="0.9.3.15" Condition="'$(TargetFramework)' == 'net10.0-android36.0'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.0'">
    <GoogleServicesJson Include="Platforms\Android\google-services.json" />

    <!--
      FsWebRTC.Bindings.Maui.Android already contributes its libwebrtc.aar as an
      AndroidLibrary item. Tools\Install-WebRTC16KB.ps1 replaces that package-cache
      AAR with the verified unified 16 KB build and stages the same file locally.
      Do NOT include the local AAR a second time: Android packaging then reports
      XA4301 because the same libjingle_peerconnection_so.so exists twice.
    -->
  </ItemGroup>

  <Target Name="ValidateHimoWebRtcAar" BeforeTargets="ResolveAndroidLibraryInputs"
          Condition="'$(TargetFramework)' == 'net10.0-android36.0'">
    <Error Condition="!Exists('Platforms\Android\Jars\libwebrtc.aar')"
           Text="Himo WebRTC AAR staging file is missing. Run Tools\Install-WebRTC16KB.ps1 before building the Android project." />
    <Error Condition="!Exists('$(NuGetPackageRoot)fswebrtc.bindings.maui.android\0.9.3.15\lib\net10.0-android36.0\libwebrtc.aar')"
           Text="The FsWebRTC NuGet cache AAR is missing. Run Tools\Install-WebRTC16KB.ps1 before building; the package-cache AAR is the single packaged AAR." />
  </Target>

</Project>
